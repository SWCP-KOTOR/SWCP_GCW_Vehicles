	<Vehicles.VehicleTurretDef Name="guy762_VehicleTurret_UWing_main" ParentName="guy762_StarfighterTurretBASE">
		<defName>guy762_VehicleTurret_UWing_main</defName>
		<label>U-Wing main dual gun</label>
		<description>The main gun of a UT-60D U-Wing troop transport.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_ywinggun</shotSound>
		
		<projectile>SWCPStarfighterBullet_AssaultAVAAmedium_UWingdualred</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		
		<empDisables>true</empDisables>
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<projectileOffset>2.1</projectileOffset> <!-- keep this on starfighters-->
		
		<minRange>5</minRange>
		<maxRange>90</maxRange>

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>10</ticksBetweenShots>
				<ticksBetweenBursts>40</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Sniper_Shot</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>NullTex</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
		</graphicData>
		
		<gizmoIconTexPath>Items/cannon_blank</gizmoIconTexPath>
		
	</Vehicles.VehicleTurretDef>
	
	
	
	
	
	
	<Vehicles.VehicleTurretDef ParentName="guy762_StarfighterTurretBASE">
		<defName>guy762_VehicleTurret_UWing_IonRepeater</defName>
		<label>U-Wing ion repeater</label>
		<description>The ion repeater of a UT-60D U-Wing troop transport.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_EaWturret_AA_quieter</shotSound>
		
		<projectile>SWProj_UWingIonBoltHeavy</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0.2</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		
		<empDisables>true</empDisables>
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<projectileOffset>2.1</projectileOffset>
		
		<minRange>2</minRange>
		<maxRange>60</maxRange> <!-- ~30 for infantry, 60 for ground vehicles, 90 for starfighters -->

		<fireModes>
			<li>
				<shotsPerBurst>12</shotsPerBurst>
				<ticksBetweenShots>4</ticksBetweenShots>
				<ticksBetweenBursts>200</ticksBetweenBursts>
				<label>Burst</label>
				<texPath>UI/Ion_Rapid_Shot</texPath>
				
				<forcedMissRadius>2.25</forcedMissRadius>
			</li>
		</fireModes>

		<graphicData>
			<texPath>NullTex</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
		</graphicData>
		
		<gizmoIconTexPath>Starfighters/T47Airspeeder/T47Airspeeder_gun</gizmoIconTexPath>
	</Vehicles.VehicleTurretDef>
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
