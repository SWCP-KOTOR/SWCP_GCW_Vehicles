<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	
	<ThingDef ParentName="KotORRangedModdable_TwoHand">
		<defName>guy762_E11carbine</defName>
		<label>E-11 blaster carbine</label>
		<description>The most common blaster in the galaxy, the E-11 is utilized by nearly every armed force in the known galaxy, and is the standard-issue weapon of all branches of the Galactic Empire. Designed as a cheaper replacement to the Republic's DC-15 carbine, the E-11 is primarily made out of inexpensive milled steel and lightweight components.</description>
		<techLevel>Spacer</techLevel>
		<thingClass>ThingWithComps</thingClass>
		<graphicData>
			<texPath>Weapons/E11</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>kotorsound_select_slug</soundInteract>
		<statBases>
			<MarketValue>500</MarketValue>
			<Mass>2.5</Mass>
			<AccuracyTouch>0.70</AccuracyTouch>
			<AccuracyShort>0.60</AccuracyShort>
			<AccuracyMedium>0.40</AccuracyMedium>
			<AccuracyLong>0.30</AccuracyLong>
			<RangedWeapon_Cooldown>0.25</RangedWeapon_Cooldown>
			<RangedWeapon_DamageMultiplier>0.8</RangedWeapon_DamageMultiplier>
		</statBases>
		
		<weaponTags>
			<li>SWRanged_E11carbine</li>
		</weaponTags>
		<tradeTags Inherit="False">
			<li>guy762TT_KotORRanged</li>
		</tradeTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>KotORBlasterBolt_default</defaultProjectile>
				<warmupTime>0.5</warmupTime>
				<range>25</range>
				<ticksBetweenBurstShots>10</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<soundCast>kotorsound_E11carbine</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
			<li>
				<label>rapid shot</label>
				<!--description>Fire extra bolts with reduced accuracy.</description>
				<iconPath>UI/Rapid_Shot</iconPath-->
				<commandIcon>UI/Rapid_Shot</commandIcon>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>KotORBlasterBolt_default</defaultProjectile>
				<warmupTime>2</warmupTime>
				<defaultCooldownTime>4</defaultCooldownTime>
				<range>17</range>
				<ticksBetweenBurstShots>8</ticksBetweenBurstShots>
				<burstShotCount>6</burstShotCount>
				<forcedMissRadius>1.75</forcedMissRadius>
				<soundCast>kotorsound_E11alt</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
				<ai_IsWeapon>true</ai_IsWeapon>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<!--comps>
			<li Class="ModularWeapons.CompProperties_ModularParts">
				<compClass>ModularWeapons.CompModularParts</compClass>
