<Defs>

  
  <ThingDef ParentName="guy762_FullBodyClothingBase">
		<defName>guy762_Bodysuit_utility</defName>
		<label>bodysuit, engineer's</label>
		<description>These are simple garments that protect little more than the modesty of the wearer.</description>
		<graphicData>
		  <texPath>Apparel/ImperialEngineer/Apparel</texPath>
		  <!-- <texPath>Apparel/ImperialEngineer/Apparel_item</texPath> -->
		  <graphicClass>Graphic_Single</graphicClass>
		  <shaderType>CutoutComplex</shaderType>
		  <colorTwo>(50,50,50)</colorTwo> <!-- black -->
		</graphicData>
		<statBases>
			<Mass>4.5</Mass>
			<MarketValue>500</MarketValue>
			<MaxHitPoints>150</MaxHitPoints>
			<ArmorRating_Sharp>0.05</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.05</ArmorRating_Blunt>
			<ArmorRating_Heat>0.05</ArmorRating_Heat>
			<Insulation_Cold>25</Insulation_Cold>
			<Insulation_Heat>25</Insulation_Heat>
			<EquipDelay>3</EquipDelay>
			
			<WorkToMake>4000</WorkToMake>
		</statBases>
		<equippedStatOffsets>
		  <VEF_MassCarryCapacity>5</VEF_MassCarryCapacity>
		  <ConstructionSpeed>0.2</ConstructionSpeed>
		</equippedStatOffsets>
		
		<costList>
		  <Synthread>75</Synthread>
		</costList>
		
		<apparel>
		  <tags Inherit="False">
			<li>RemnantEmpire_engineer</li>
		  </tags>
		  <wornGraphicPath>Apparel/ImperialEngineer/Apparel</wornGraphicPath>
		  <useWornGraphicMask>true</useWornGraphicMask>
		  <defaultOutfitTags Inherit="False">
			<li>Worker</li>
		  </defaultOutfitTags>
		</apparel>
		<tradeTags>
			<li>guy762TT_KotORClothes</li>
			<li>guy762TT_KotORUnderArmor</li>
		</tradeTags>
		<colorGenerator Class="ColorGenerator_Options" Inherit="False">
			<options>
				<li>
					<weight>15</weight>
					<only>(165,165,165)</only> <!-- lighter grey -->
				</li>
			</options>
		</colorGenerator>
	  </ThingDef>
	  
	  
	  
	  
	  
	  
	  
	  
