	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>guy762_VehicleTurret_ImpTroopTransport</defName>
		<label>K79-S80 dorsal turret</label>
		<description>The rotating dorsal turret of a K79-S80 troop transport.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_xwinggun</shotSound>
		
		<projectile>KotORSFBullet_aurek</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0.2</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		
		<hitFlags>IntendedTarget</hitFlags>
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<projectileOffset>2.1</projectileOffset>
		
		<minRange>5</minRange>
		<maxRange>90</maxRange>

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>10</ticksBetweenShots>
				<ticksBetweenBursts>20</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Sniper_Shot</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>LandVehicles/ImpTroopTransport/ImpTroopTransport_gun</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<drawSize>(2,2)</drawSize>
		</graphicData>
		
		<gizmoIconTexPath>LandVehicles/ImpTroopTransport/ImpTroopTransport_gun</gizmoIconTexPath>
		
	</Vehicles.VehicleTurretDef>
