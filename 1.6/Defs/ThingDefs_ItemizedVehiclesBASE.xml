<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingCategoryDef>
		<defName>SWCP_ThingCategory_ItemizedVehicles</defName>
		<label>itemized vehicles/starfighters</label>
		<parent>Root</parent>
    </ThingCategoryDef>
	
	<ThingDef Name="SWCP_ItemizedVehicleBASE" ParentName="guy762_NoCraft_upgradebase" Abstract="True">
		<description>An itemized vehicle. Use it to construct the corresponding vehicle.</description>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2,2)</drawSize>
		</graphicData>
		<thingCategories Inherit="False">
			<li>SWCP_ThingCategory_ItemizedVehicles</li>
		</thingCategories>
		
		<tradeTags>
			<li>SWCPTT_ItemizedVehicles_any</li>
		</tradeTags>
	</ThingDef>


	<!--
	
		GENERAL RULES FOR <RoyalFavorValue></RoyalFavorValue>
			(individual exceptions are made for starfighters that are explicitly described as being "cutting edge" or particularly venerable)
	
	=	EARLY TECH
	- Interceptors: 1
	- Strikefighters: 1
	- Assault Fighters: 2
	- Gunships: 2
	- Transports: 1
	
	=	MIDDLE TECH
	- Interceptors: 4
	- Strikefighters: 4
	- Assault Fighters: 5
	- Gunships: 4
	- Transports: 4
	
	=	LATE TECH
	- Interceptors: 10
	- Strikefighters: 9
	- Assault Fighters: 8
	- Gunships: 7
	- Transports: 6
	
	=	NON-TECH REWARD SHIPS: 10
	
	-->
	
	<ThingDef Name="SWCP_ItemizedStarfighterBASE" ParentName="SWCP_ItemizedVehicleBASE" Abstract="True">
		<description>An itemized starfighter. Use it to construct the corresponding starfighter.</description>
		
		<tradeTags>
			<li>SWCPTT_ItemizedStarfighters_any</li>
		</tradeTags>
	</ThingDef>
	
	
	
	<!--
	
		GENERAL RULES FOR <RoyalFavorValue></RoyalFavorValue>
	
