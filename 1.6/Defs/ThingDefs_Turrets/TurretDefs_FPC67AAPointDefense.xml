<?xml version="1.0" encoding="utf-8" ?>
<Defs>


  

	<!--=============== hardpoint AA point-defense ===============-->

	<ThingDef ParentName="guy762_TurretBase">
		<defName>guy762_SWTurret_FPC67AntiAir</defName>
		<label>FPC 6.7 anti-air autoturret</label>
		<description>.</description>
		<graphicData>
		  <graphicClass>Graphic_Single</graphicClass>
		  <texPath>Turrets/Turrets_Ogam/HardpointBase</texPath>
		  <drawSize>(7,7)</drawSize>
		  <drawRotated>false</drawRotated>
		  
		  <damageData>
			<rect>(0.38,0.2,0.56375,0.8)</rect>
			<cornerTL>Damage/Corner</cornerTL>
		  </damageData>
		  <shadowData>
			<offset>(-0.13,-0.87,-0.1)</offset>
			<volume>(0.5,0.4,1.05)</volume>
		  </shadowData>
		</graphicData>
		<uiIconPath>Turrets/Turrets_Ogam/PointDefense_icon</uiIconPath>
		<!-- <rotatable>false</rotatable> -->

		
		<statBases>
		  <MaxHitPoints>750</MaxHitPoints>
		  
		  <ShootingAccuracyTurret>0.99</ShootingAccuracyTurret>
		</statBases>
		<minifiedDef Inherit="False"/><thingCategories Inherit="False"/>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		
		<placeWorkers Inherit="False">
		  <li>PlaceWorker_NotUnderRoof</li>
		  <li>PlaceWorker_TurretTop</li>
		</placeWorkers>
	
		
		<costList>
		  <Steel>300</Steel>
		  <Plasteel>30</Plasteel>
		  <Uranium>60</Uranium>
		  <ComponentIndustrial>6</ComponentIndustrial>
		</costList>
		
		<size>(4,4)</size>
		
		<soundInteract>kotorsound_select_shipgun</soundInteract>
		<comps>
			<li Class="CompProperties_Explosive">
				<wickTicks>80</wickTicks>
				<startWickHitPointsPercent>0.05</startWickHitPointsPercent>
				<explosiveRadius>3</explosiveRadius>
				<explosiveDamageType>guy762_ExplosiveDamage_energy</explosiveDamageType>
				<chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTransmitter</compClass>
				<transmitsPower>true</transmitsPower>
			</li>
		</comps>
		
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<!-- <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded> -->
		<building>
			<turretGunDef>guy762_SWTurretGun_FPC67AntiAir</turretGunDef>
			<turretTopDrawSize>6.5</turretTopDrawSize>
			<!-- <turretTopOffset>(-0.05, 0.05)</turretTopOffset> -->
		  
			<turretBurstWarmupTime>0.125</turretBurstWarmupTime>
			<turretBurstCooldownTime>2.5</turretBurstCooldownTime>
		</building>
		<researchPrerequisites>
		  <li>SniperTurret</li>
		</researchPrerequisites>
	</ThingDef>
	
	<ThingDef ParentName="BaseWeaponTurret">
		<defName>guy762_SWTurretGun_FPC67AntiAir</defName>
		<label>anti-air turret</label>
		<description>.</description>
		<graphicData>
		  <texPath>Turrets/Turrets_Ogam/PointDefense_gun</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		  <drawSize>(2,2)</drawSize>
		</graphicData>
		<statBases>
		  <AccuracyTouch>0.30</AccuracyTouch>
		  <AccuracyShort>0.40</AccuracyShort>
		  <AccuracyMedium>0.80</AccuracyMedium>
		  <AccuracyLong>0.90</AccuracyLong>
		  <RangedWeapon_Cooldown>2.5</RangedWeapon_Cooldown>
		  <DeteriorationRate>0</DeteriorationRate>
		  <Mass>200</Mass>
		  <Flammability>0</Flammability>
		</statBases>
		<verbs>
		  <li>
			<verbClass>Verb_Shoot</verbClass>
			<defaultProjectile>SWFixedTurretBullet_AAdoublered</defaultProjectile>
			<warmupTime>0.125</warmupTime>
			<!-- <range>90</range> normal ground defense range -->
			<range>250</range> <!-- ship defense range -->
			
			<burstShotCount>6</burstShotCount>
			<ticksBetweenBurstShots>6</ticksBetweenBurstShots>
			
			<soundCast>kotorsound_EaWturret_AA</soundCast>
			<soundCastTail>GunTail_Heavy</soundCastTail>
			<muzzleFlashScale>18</muzzleFlashScale>
			<forcedMissRadius>0</forcedMissRadius>
			<ai_AvoidFriendlyFireRadius>3</ai_AvoidFriendlyFireRadius>
			
			<!-- <onlyManualCast>true</onlyManualCast> -->
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
			</targetParams>
		  </li>
		</verbs>
		<modExtensions>
			<li Class="IgnoreConfigErrors.Ignore_ForcedMissRadius" />
			<li MayRequire="EBSG.Framework" Class="EBSGFramework.TurretRoofBlocked" />
		</modExtensions>
	</ThingDef>
	
	

 

</Defs>