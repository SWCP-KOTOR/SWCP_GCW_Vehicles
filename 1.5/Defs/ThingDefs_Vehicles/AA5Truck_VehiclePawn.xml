<?xml version="1.0" encoding="utf-8" ?>

<Defs>	

	<Vehicles.PatternDef>
		<defName>guy762_SWVehiclePattern_AA5Truck</defName>
		<label>A-A5 Speeder Truck (stock)</label>
		<path>LandVehicles/AA5/AA5_pattern</path>
	</Vehicles.PatternDef>
	
	
	<Vehicles.VehicleDef ParentName="VehiclePawn_Mechanical">
		<defName>guy762_SWVehicle_AA5Truck</defName>
		<label>A-A5 Speeder Truck</label>
		<description>. \n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Driver x1</description>
		
		<graphicData>
			<texPath>LandVehicles/AA5/AA5</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
			<drawSize>(7,7)</drawSize>
			<shaderType>CutoutComplexPattern</shaderType>
			<pattern>guy762_SWVehiclePattern_AA5Truck</pattern>
			<color>(170,160,135)</color> <!-- stanky beige -->
			<colorTwo>(140,60,60)</colorTwo>
		</graphicData>
		
		<fillPercent>1</fillPercent>
		
		<nameable>false</nameable>
		<buildDef>guy762_SWVehicleBP_AA5Truck</buildDef>
		
		<size>(5,5)</size>
		<uiIconScale>1</uiIconScale>
		
		<vehicleMovementPermissions>DriverNeeded</vehicleMovementPermissions>
		<vehicleCategory>Transport</vehicleCategory>
		<techLevel>Spacer</techLevel>
		<vehicleType>Land</vehicleType>
				
		<statBases>
			<ArmorRating_Sharp>0.3</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.2</ArmorRating_Blunt>
            <ArmorRating_Heat>0.4</ArmorRating_Heat>
			<Flammability>0.5</Flammability>
			<MarketValue>5800</MarketValue>
		</statBases>
		
		<vehicleStats>
			<Mass>650</Mass>
			<MoveSpeed>20</MoveSpeed>
			<CargoCapacity>300</CargoCapacity>
			<RepairRate>1</RepairRate>
			<!--AccelerationRate>0.08</AccelerationRate-->
		</vehicleStats>
		
		<soundSustainersOnEvent>
			<li>
				<start>IgnitionOn</start>
				<stop>MoveStart</stop>
				<value>kotorsound_speederbike_idle</value>
			</li>
			<li>
				<start>MoveStart</start>
				<stop>MoveStop</stop>
				<value>kotorsound_hovercar_moving</value>
			</li>
			<li>
				<start>MoveStop</start>
				<stop>MoveStart</stop>
				<value>kotorsound_speederbike_idle</value>
			</li>
			<li>
				<start>MoveStop</start>
				<stop>IgnitionOff</stop>
				<value>kotorsound_speederbike_idle</value>
			</li>
		</soundSustainersOnEvent>
		
		<soundOneShotsOnEvent>
			<li>
				<key>PawnEntered</key>
				<value>kotorsound_select_shipgun</value>
			</li>
			<li>
				<key>PawnExited</key>
				<value>kotorsound_select_shipgun</value>
			</li>
			<li>
				<key>PawnChangedSeats</key>
				<value>kotorsound_select_shipgun</value>
			</li>
			<li>
				<key>IgnitionOn</key>
				<value>kotorsound_speederbike_activate</value>
			</li>
			<li>
				<key>IgnitionOff</key>
				<value>kotorsound_speederbike_deactivate</value>
			</li>
			<li>
				<key>DamageTaken</key>
				<value>kotorsound_speederbike_damaged</value>
			</li>
			<li>
				<key>CargoAdded</key>
				<value>kotorsound_footlocker_open</value>
			</li>
			<li>
				<key>CargoRemoved</key>
				<value>kotorsound_footlocker_close</value>
			</li>
		</soundOneShotsOnEvent>
		
		<race>
			<baseBodySize>1</baseBodySize>
		</race>
		
		
		<properties>
			<diagonalRotation>false</diagonalRotation>
			<worldSpeedMultiplier>1.2</worldSpeedMultiplier>
			<winterSpeedMultiplier>3.25</winterSpeedMultiplier>
			<manhunterTargetsVehicle>true</manhunterTargetsVehicle>
			<!--offRoadMultiplier>0.8</offRoadMultiplier-->
			
			<customHillinessCosts>
				<SmallHills>0.25</SmallHills>
				<LargeHills>0.75</LargeHills>
				<Mountainous>1.5</Mountainous>
			</customHillinessCosts>
			
			<!--customSnowCategoryTicks>
				<Dusting>4</Dusting>
				<Thin>8</Thin>
				<Medium>16</Medium>
				<Thick>24</Thick>
			</customSnowCategoryTicks-->
			
			<roles>
				<li>
					<key>driver</key>
					<label>Driver</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<handlingTypes>
						<li>Movement</li>
					</handlingTypes>
				</li>
				<li>
					<key>gunner</key>
					<label>Gunner</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					
					<handlingTypes>Turret</handlingTypes>
					
					<turretIds>
						<li>AA5TruckKey_gun_1</li>
					</turretIds>
				</li>
				<li>
					<key>passenger</key>
					<label>Passenger</label>
					<slots>6</slots>
					<comfort>-0.25</comfort>
				</li>
			</roles>
		</properties>
		
		<components>
			<li>
				<key>AA5TruckKey_hull</key>
				<label>Hull</label>
				<depth>External</depth>
				
				<armor>
					<ArmorRating_Sharp>0.45</ArmorRating_Sharp>
					<ArmorRating_Blunt>0.3</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
					<ArmorRating_Heat>0.55</ArmorRating_Heat>
				</armor>
				<health>400</health> <!-- # of estimated XWMG hull points * 100 -->
				
				<hitbox>
					<side>Body</side>
				</hitbox>
			</li>
			
			
			<!-- <li> -->
				<!-- <key>AA5TruckKey_cabin</key> -->
				<!-- <label>Cabin</label> -->
				<!-- <health>100</health> -->
				<!-- <depth>Internal</depth> -->
			<!-- </li> -->
			<li>
				<key>AA5TruckKey_engine</key>
				<label>Engine</label>
				<health>25</health>
				<priorityStatEfficiency>true</priorityStatEfficiency>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>3</radius>
						<damageDef>Flame</damageDef>
					</li>
				</reactors>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>AA5TruckKey_repulsor</key>
				<label>Repulsorlift Generator</label>
				<health>75</health>
				<depth>Internal</depth>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>AA5TruckKey_thrust</key>
				<label>Thrust Repulsor</label>
				<health>50</health>
				<depth>Internal</depth>
				
				<tags>
					<li>Wheel</li>
				</tags>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
		</components>

		<!--modExtensions>
			<li Class="VanillaVehiclesExpanded.StatExtension">
				<statToAdd>
					<li>VVE_VehicleTier</li>
				</statToAdd>
				<statValues>
					<li>VVE_Tier1</li>
				</statValues>
				<statDescriptions>
					<li>VVE_Tier1Desc</li>
				</statDescriptions>
			</li>
		</modExtensions-->
		
		<comps>
			<li Class="Vehicles.CompProperties_FueledTravel">
				<fuelType>KOTOR_Rhydonium</fuelType>
				<leakDef>Filth_Fuel</leakDef>
				<fuelConsumptionRate>12.5</fuelConsumptionRate>
				<fuelCapacity>30</fuelCapacity>
			</li>
			<li Class="Vehicles.CompProperties_VehicleTurrets">
				<turrets>
					<li>
						<turretDef>guy762_VehicleTurret_AA5Truck_dorsal</turretDef>
						
						<renderProperties>
							<north>(-0.44, 1.2)</north>
							<south>(-0.45, -0.35)</south>
							<east>(0.75, 1)</east>
							<west>(-0.75, 1)</west>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<!-- <angleRestricted>(315,45)</angleRestricted> -->
						<gizmoLabel>dorsal turret</gizmoLabel>
						
						<drawLayer>15</drawLayer>
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<key>AA5TruckKey_gun_1</key>
					</li>
				</turrets>
			</li>
		</comps>
	</Vehicles.VehicleDef>
	
	
	
	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>guy762_VehicleTurret_AA5Truck_dorsal</defName>
		<label>A-A5 Speeder Truck dorsal turret</label>
		<description>The rotating dorsal turret of an A-A5 Speeder Truck.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_speedergun</shotSound>
		
		<projectile>SWVehicleBullet_tankdoublered</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>1</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		
		<hitFlags>IntendedTarget</hitFlags>
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<projectileOffset>2.1</projectileOffset>
		
		<minRange>5</minRange>
		<maxRange>60</maxRange> <!-- ~30 for infantry, 60 for ground vehicles, 90 for starfighters -->

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>10</ticksBetweenShots>
				<ticksBetweenBursts>80</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Sniper_Shot</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>Starfighters/YT2400/YT2400_gun</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<drawSize>(4,4)</drawSize>
		</graphicData>
		
		<gizmoIconTexPath>Starfighters/YT2400/YT2400_gun</gizmoIconTexPath>
		
	</Vehicles.VehicleTurretDef>
	
	
</Defs>