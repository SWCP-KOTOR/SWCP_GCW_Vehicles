<Defs>	
	
	<Vehicles.PatternDef>
		<defName>guy762_SWVehiclePattern_FlareS</defName>
		<label>Flare-S Swoop</label>
		<path>LandVehicles/FlareS/FlareS_pattern</path>
	</Vehicles.PatternDef>
	
	<Vehicles.VehicleDef ParentName="guy762_SpeederBikeOrUnarmoredVehicle_base">
		<defName>guy762_SWVehicle_FlareS</defName>
		<label>Mobquet Flare-S Swoop Bike</label>
		<description>. \n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Driver x1</description>
		
		<graphicData>
			<texPath>LandVehicles/FlareS/FlareS_L1</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
			<shaderType>CutoutComplexPattern</shaderType>
			<drawSize>(3,3)</drawSize>
			<pattern>guy762_SWVehiclePattern_FlareS</pattern>
			<color>(215,20,35)</color>
			<colorTwo>(250,180,0)</colorTwo>
		</graphicData>
		
		<fillPercent>0.4</fillPercent>
		
		<nameable>false</nameable>
		<buildDef>guy762_SWVehicleBP_FlareS</buildDef>
		
		<size>(2,2)</size>
		<uiIconScale>1</uiIconScale>
		
		<vehicleMovementPermissions>DriverNeeded</vehicleMovementPermissions>
		<vehicleCategory>Transport</vehicleCategory>
		<techLevel>Spacer</techLevel>
