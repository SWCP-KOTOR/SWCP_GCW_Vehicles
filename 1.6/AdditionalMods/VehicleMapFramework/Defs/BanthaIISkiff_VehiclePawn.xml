	<Vehicles.VehicleTurretDef ParentName="guy762_VehicleTurretBASE">
		<defName>guy762_VehicleTurret_SkiffAV</defName>
		<label>Skiff AV pontoon gun</label>
		<description>The anti-vehicle blaster of a Bantha-II Skiff.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_AATgun</shotSound>
		
		<projectile>SWVehicleBullet_AVred_light</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0.5</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<projectileOffset>2.1</projectileOffset>
		
		<minRange>5</minRange>
		<maxRange>60</maxRange> <!-- ~30 for infantry, 60 for ground vehicles, 90 for starfighters -->

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>10</ticksBetweenShots>
				<ticksBetweenBursts>80</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Sniper_Shot</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>LandVehicles/BanthaIISkiff/BanthaIISkiff_gun</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<drawSize>(2,2)</drawSize>
			
			<color>(120,105,90)</color> <!-- grey brown -->
		</graphicData>
		
		<gizmoIconTexPath>LandVehicles/BanthaIISkiff/BanthaIISkiff_gun</gizmoIconTexPath>
		<!-- <modExtensions> -->
			<!-- <li MayRequire="SmashPhil.VehicleFramework" Class = "Vehicles.VehicleDamageMultiplierDefModExtension"> -->
			  <!-- <multiplier>0.01</multiplier> -->
			<!-- </li> -->
		<!-- </modExtensions> -->
	</Vehicles.VehicleTurretDef>
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
