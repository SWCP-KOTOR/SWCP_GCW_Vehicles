		<thingCategories>
		  <li>ArmorHeadgear</li>
		</thingCategories>
		<statBases>
			<Mass>3.5</Mass>
			<MarketValue>200</MarketValue>
			<MaxHitPoints>115</MaxHitPoints>
      		<ArmorRating_Sharp>0.55</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.4</ArmorRating_Blunt>
