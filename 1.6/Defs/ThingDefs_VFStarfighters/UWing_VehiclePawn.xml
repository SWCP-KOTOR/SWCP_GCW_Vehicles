	<Vehicles.VehicleDef Name="guy762_SWVehicle_UWing" ParentName="MM-VF-Vehicle_Pawn">
		<defName>guy762_SWVehicle_UWing</defName>
		<label>UT-60D U-Wing troop transport</label>
		<description>. \n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Pilot x1</description>
		<graphicData>
			<texPath>Starfighters/UWing/UWing</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass><drawRotated>true</drawRotated>
			<drawRotated>true</drawRotated>
			<drawSize>(29,29)</drawSize>
			<shaderType>CutoutComplexPattern</shaderType>
			<pattern>guy762_SWVehiclePattern_UWingA</pattern>
			<color>(60,60,140)</color> <!-- blue squadron -->
			<colorTwo>(230,185,45)</colorTwo> <!-- republic yellow -->
			<colorThree>(225,225,225)</colorThree> <!-- lesser white -->
		</graphicData>
		<uiIconScale>1</uiIconScale>
		<seeThroughFog>true</seeThroughFog>
		<drawOffscreen>true</drawOffscreen>
		<rotatable>True</rotatable>
		
		<fillPercent>1</fillPercent>
		<nameable>true</nameable>
		<buildDef>guy762_SWVehicleBP_UWing</buildDef>
		<size>(5,11)</size>
		
		
		<canCaravan>false</canCaravan>
		<vehicleCategory>Combat</vehicleCategory>
		<techLevel>Spacer</techLevel>
		<vehicleType>Air</vehicleType>
		
		<statBases>
			<!--ArmorRating_Sharp>+0.05</ArmorRating_Sharp>
			<ArmorRating_Blunt>-0.1</ArmorRating_Blunt>        BASE CURVE FOR HARD ARMOR
			<ArmorRating_Heat>+0.15</ArmorRating_Heat-->
			<!--B--><ArmorRating_Sharp>0.055</ArmorRating_Sharp>
			<!--B--><ArmorRating_Blunt>0.04</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
			<!--B--><ArmorRating_Heat>0.065</ArmorRating_Heat>
			<MaxHitPoints>500</MaxHitPoints> <!-- # of estimated XWMG hull points * 100 -->
			
			<MarketValue>650000</MarketValue>
			<Flammability>0</Flammability>
			
			<EnergyShieldRechargeRate>0.5</EnergyShieldRechargeRate>
			<EnergyShieldEnergyMax>3</EnergyShieldEnergyMax> <!-- XWMG shield value -->
		</statBases>
		<vehicleStats>
			<Mass>135000</Mass>
			
			<FlightSpeed>12</FlightSpeed> <!-- this is for world map flight, NOT in-tile flight-->
			<CargoCapacity>100</CargoCapacity>
			<SoS2CombatDodgeChance MayRequire="kentington.saveourship2">27.5</SoS2CombatDodgeChance> <!-- 3/8 chance to dodge on XWMG green dice = 0.375 | 0.375*10 + 10 = 13.75 | 13.75 * X = SoS2DC | X = estimated # of XWMG green dice -->
		</vehicleStats>
		
		<race>
			<baseBodySize>1.5</baseBodySize>
		</race>
		
		<drawProperties>
			<displayRotation>North</displayRotation>
		</drawProperties>
		
		<properties>
			<diagonalRotation>false</diagonalRotation><empStuns>true</empStuns>
			<worldSpeedMultiplier>0.01</worldSpeedMultiplier>
			<manhunterTargetsVehicle>false</manhunterTargetsVehicle>
			
			<vehicleJobLimitations>
				<li>(RepairVehicle, 6)</li> <!-- how many pawns can repair this vehicle at a time -->
			</vehicleJobLimitations> <!-- guy762 RULES: repair job count should be twice the amount of pawns to fully operate the vehicle -->
			
			<roles>
				<li>
					<key>pilot</key>
					<label>Pilot</label>
					<slots>2</slots>
					<slotsToOperate>1</slotsToOperate>
					<handlingTypes>
						<li>Movement</li>
						<li>Turret</li>
					</handlingTypes>
					
					<turretIds>
						<li>UWingKey_gun_1</li>
					</turretIds>
				</li>
				<li>
					<key>portgunner</key>
					<label>Port Gunner</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					
					<handlingTypes>Turret</handlingTypes>
					
					<turretIds>
						<li>UWingKey_gun_2</li>
					</turretIds>
				</li>
				<li>
					<key>starboardgunner</key>
					<label>Starboard Gunner</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					
					<handlingTypes>Turret</handlingTypes>
					
					<turretIds>
						<li>UWingKey_gun_3</li>
					</turretIds>
				</li>
				<li>
					<key>passenger</key>
					<label>Passenger</label>
					<slots>12</slots> <!-- average single NR trooper squad size -->
				</li>
			</roles>
		</properties>
		
		<comps>
			<li Class="Vehicles.CompProperties_FueledTravel">
				<fuelType>KOTOR_Rhydonium</fuelType>				<!-- Must Include -->
				<leakDef>Filth_Fuel</leakDef><targetFuelLevelConfigurable>true</targetFuelLevelConfigurable><ambientHeat>3.0</ambientHeat>
				<fuelConsumptionRate>2</fuelConsumptionRate>
				<fuelCapacity>300</fuelCapacity>
				<fuelConsumptionWorldMultiplier>0.5</fuelConsumptionWorldMultiplier>
			</li>
			
			<li Class="CompProperties_ProjectileInterceptor">
				<radius>12</radius>
				<color>(0.4, 0.4, 0.4)</color>
				
				<interceptGroundProjectiles>true</interceptGroundProjectiles>
				<interceptAirProjectiles>true</interceptAirProjectiles>
				<interceptNonHostileProjectiles>true</interceptNonHostileProjectiles>
				
				<reactivateEffect>BulletShieldGenerator_Reactivate</reactivateEffect>
				<activeSound>BulletShield_Ambience</activeSound>
				<hitPointsRestoreInstantlyAfterCharge>true</hitPointsRestoreInstantlyAfterCharge>
				
				<hitPoints>300</hitPoints> <!-- XWMG shield value * 100 -->
				
				<chargeDurationTicks>1800</chargeDurationTicks><!-- 30s -->
				<rechargeHitPointsIntervalTicks>120</rechargeHitPointsIntervalTicks>
				<minIdleAlpha>0.2</minIdleAlpha>
				<drawWithNoSelection>True</drawWithNoSelection>
				<disarmedByEmpForTicks>1500</disarmedByEmpForTicks>
				
				<gizmoTipKey>ProjectileInterceptorTip</gizmoTipKey>
			</li>
			
			
			<li Class="taranchuk_flightcombat.CompProperties_FlightMode">
				<flightCommands>
					<flightMode>
						<label>Flight mode</label>
						<description>Toggle flight mode.</description>
						<texPath>Gizmo/TakeOff_Icon</texPath>
					</flightMode>
					<hoverMode>
						<label>Hover mode</label>
						<description>Toggle hover mode.</description>
						<texPath>Gizmo/Liftoff_Icon</texPath>
					</hoverMode>
					<faceTarget>
						<label>Face target (hover)</label>
						<description>Face target while hovering.</description>
						<texPath>Gizmo/FaceTarget_Icon</texPath>
					</faceTarget>
					<cancelFaceTarget>
						<label>Cancel face target</label>
						<description>Cancel face target.</description>
						<texPath>Gizmo/FaceTargetStop_Icon</texPath>
					</cancelFaceTarget>
					<chaseTarget>
						<label>Chase target (flight)</label>
						<description>Chase target while flying.</description>
						<texPath>Gizmo/ChaseTarger_Icon</texPath>
					</chaseTarget>
				</flightCommands>
				
				<!-- <damageMultiplierFromNonAntiAirProjectiles>0.3</damageMultiplierFromNonAntiAirProjectiles> -->
				
				<fuelConsumptionPerTick>0.0001</fuelConsumptionPerTick><canFlyInSpace>true</canFlyInSpace>
				
				<flightSpeedPerTick>0.8</flightSpeedPerTick> <!-- MAXIMUM XWMG speed: speed5 = 1, speed1 = 0.2 | + 0.1 for blue 5, -0.1 for red highest -->
				<flightSpeedTurningPerTick>0.4</flightSpeedTurningPerTick> <!-- highest speed in which all 5 standard maneuvers are available | +0.1 for a full row of blues, -0.1 for any red turns -->
				<turnAnglePerTick>1.5</turnAnglePerTick> <!-- LARGE SHIP TURNS (slowest possible): speed1 turn = 2, speed2 turn = 1.5, speed3 turn = 1 | banks = 0.75, 0.5, 0.25 | -1 for red slowest -->
				<turnAngleCirclingPerTick>1.5</turnAngleCirclingPerTick> <!-- use slowest turn +1 for each special turning maneuver: speed1 turn = 2, speed2 turn = 1.5, speed3 turn = 1 | +0.5 for any blue turns, -0.5 for any red turns -->
				
				<flightSpeedCirclingPerTick>0.4</flightSpeedCirclingPerTick>
				<ellipseMajorAxis>120</ellipseMajorAxis>
				<ellipseMinorAxis>60</ellipseMinorAxis>
				
				<maxDistanceFromTargetElliptical>50</maxDistanceFromTargetElliptical>
				<maxDistanceFromTargetCircle>10</maxDistanceFromTargetCircle>
				
				<takeoffTicks>120</takeoffTicks>
				<landingTicks>120</landingTicks>
				<moveWhileTakingOff>false</moveWhileTakingOff><moveWhileLanding>false</moveWhileLanding>
				
				
				
				<runwayTerrainRequirements>
					<li>Light</li>
					<li>Medium</li>
					<li>Heavy</li>
				</runwayTerrainRequirements>
				<flightGraphicData>
					<texPath>Starfighters/UWing/UWing</texPath>
					<graphicClass>Vehicles.Graphic_Vehicle</graphicClass><drawRotated>true</drawRotated>
					<drawSize>(29,29)</drawSize>
					<shaderType>CutoutComplexPattern</shaderType>
					<pattern>guy762_SWVehiclePattern_UWingA</pattern>
					<color>(60,60,140)</color> <!-- blue squadron -->
					<colorTwo>(230,185,45)</colorTwo> <!-- republic yellow -->
					<colorThree>(225,225,225)</colorThree> <!-- lesser white -->
				</flightGraphicData>
				
				<AISettings>
					<gunshipSettings>
						<!-- turreted gunship settings: Circling/Around -->
						<chaseMode>Circling</chaseMode><flightPattern>Around</flightPattern>
						<distanceFromTarget>30</distanceFromTarget>
					</gunshipSettings>
				</AISettings>
				
				
				<flightFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</flightFlecks>
				<hoverFlecks>
					<!-- can be filled with the same data as the flight flecks if necessary -->
				</hoverFlecks>
				<takeoffFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<solidTimeScaleByTakeoffInverse>true</solidTimeScaleByTakeoffInverse>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</takeoffFlecks>
				<landingFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<solidTimeScaleByTakeoff>true</solidTimeScaleByTakeoff>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</landingFlecks>
				<waypointFleck>guy762_SWStarfighter_waypoint</waypointFleck>
			</li>
			
			
			<li Class="Vehicles.CompProperties_VehicleTurrets">
				<turrets>
					<li>
						<turretDef>guy762_VehicleTurret_UWing_main</turretDef>
						
						<renderProperties>
							<north>(0, 5)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>medium dual AV/AA gun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<autoTargetingActive>True</autoTargetingActive>
						
						<key>UWingKey_gun_1</key>
					</li>
					
					<!--/////////////////////////-->
					
					<li>
						<turretDef>guy762_VehicleTurret_UWing_IonRepeater</turretDef>
						
						<renderProperties>
							<north>(-1.75, -1.5)</north>
						</renderProperties>
						<defaultAngleRotated>345</defaultAngleRotated>
						<angleRestricted>(180,0)</angleRestricted>
						<gizmoLabel>door ion repeater</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<autoTargetingActive>True</autoTargetingActive>
						
						<key>UWingKey_gun_2</key>
					</li>
					<li>
						<turretDef>guy762_VehicleTurret_UWing_IonRepeater</turretDef>
						
						<renderProperties>
							<north>(1.75, -1.5)</north>
						</renderProperties>
						<defaultAngleRotated>15</defaultAngleRotated>
						<angleRestricted>(0,180)</angleRestricted>
						<gizmoLabel>door ion repeater</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<autoTargetingActive>True</autoTargetingActive>
						
						<key>UWingKey_gun_3</key>
					</li>
				</turrets>
			</li>
		</comps>
		<components>
			<li>
				<key>Hull</key>
				<label>Hull</label>
				<depth>External</depth>
				
				<armor>
					<!--H--><ArmorRating_Sharp>0.55</ArmorRating_Sharp>
					<!--H--><ArmorRating_Blunt>0.4</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
					<!--H--><ArmorRating_Heat>0.65</ArmorRating_Heat>
					<IncomingDamageFactor>-0.35</IncomingDamageFactor> <!-- Interceptors: 0.05 | StrikeFighters: 0.15 | AssaultFighters: 0.25 | Transports: 0.35 -->
				</armor>
				<health>1250</health> <!-- XWMG hull * 250 -->
				
				<hitbox>
					<side>Body</side>
				</hitbox>
			</li>
			<li>
				<key>Internals</key>
				<label>Internals</label>
				<health>500</health> <!-- XWMG hull * 100 -->
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
