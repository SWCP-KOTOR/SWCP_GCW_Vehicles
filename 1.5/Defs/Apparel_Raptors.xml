<Defs>

  <ThingDef ParentName="BaseGrenadeProjectile">
		<defName>guy762_ThrownGrenade_stormtrooper</defName>
		<label>concussion grenade</label>
		<thingClass>Projectile_Explosive</thingClass>
		<graphicData>
		  <texPath>Weapons/Projectiles/Grenades/grenade_stormtrooper</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
		  <explosionRadius>2</explosionRadius >
		  <!--damageDef>guy762_GrenadeDamage_stun</damageDef-->
		  <damageDef>Stun</damageDef>
		  <explosionDelay>100</explosionDelay>
		  <!--soundAmbient>kotorsound_grenadecook</soundAmbient-->
		  <soundExplode>kotorsound_stungrenade</soundExplode>
		</projectile>
	</ThingDef>
  
  
  
  
  <ThingDef ParentName="KotORArmorModdable_hard">
		<defName>guy762_StormieArmor</defName>
		<label>Stormtrooper Armor</label>
		<techLevel>Spacer</techLevel>
		<description>.</description>
		<graphicData>
			<texPath>Apparel/Stormtrooper/Apparel</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<Mass>6</Mass>
			<MarketValue>500</MarketValue>
			<MaxHitPoints>225</MaxHitPoints>
			<ArmorRating_Sharp>0.35</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.2</ArmorRating_Blunt>
			<ArmorRating_Heat>0.65</ArmorRating_Heat>
			<EquipDelay>10</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<!-- <MoveSpeed>-0.1</MoveSpeed> -->
			<MeleeDodgeChance>-0.1</MeleeDodgeChance>
			<IncomingDamageFactor>-0.1</IncomingDamageFactor>
		</equippedStatOffsets>
		<apparel Inherit="False">
			<tags>
				<li>RemnantEmpire_stormiearmor</li>
			</tags>
			<wornGraphicPath>Apparel/Stormtrooper/Apparel</wornGraphicPath>
			<useWornGraphicMask>false</useWornGraphicMask>
			<layers>
				<li>Middle</li>
			</layers>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Shoulders</li>
				<li>Neck</li>
				<li>Arms</li>
				<li>Hands</li>
				<li>Legs</li>
				<li>Feet</li>
			</bodyPartGroups>
			<useDeflectMetalEffect>false</useDeflectMetalEffect>
		</apparel>
		<tradeTags>
			<li>guy762TT_WarlordArmor</li>
		</tradeTags>
		<colorGenerator Class="ColorGenerator_Options" Inherit="False">
			<options>
				<li>
					<weight>10</weight>
					<only>(250,250,250)</only>  <!-- white -->
				</li>
			</options>
		</colorGenerator>
		
		<verbs>
            <li>
                <label>throw concussion grenade</label>
                <verbClass>Verb_LaunchProjectileStatic</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <range>15</range>
                <forcedMissRadius>1.9</forcedMissRadius>
                <warmupTime>1.75</warmupTime>
                <noiseRadius>4</noiseRadius>
                <burstShotCount>1</burstShotCount>
                <soundCast>kotorsound_grenadethrow</soundCast>
                <onlyManualCast>true</onlyManualCast>
                <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
                <defaultProjectile>guy762_ThrownGrenade_stormtrooper</defaultProjectile>
                <ai_AvoidFriendlyFireRadius>6.9</ai_AvoidFriendlyFireRadius>
				<ai_IsBuildingDestroyer>false</ai_IsBuildingDestroyer>
				<ai_IsWeapon>true</ai_IsWeapon>
                <targetParams>
                    <canTargetLocations>true</canTargetLocations>
                </targetParams>
            </li>
        </verbs>
        <comps>
            <li Class="CompProperties_ApparelReloadable">
                <maxCharges>1</maxCharges>
                <destroyOnEmpty>false</destroyOnEmpty>
                <hotKey>Misc4</hotKey>
                <chargeNoun>grenades</chargeNoun>
                <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
				<ammoDef>ComponentIndustrial</ammoDef>
				<ammoCountToRefill>2</ammoCountToRefill>
				<baseReloadTicks>60</baseReloadTicks>
            </li>
        </comps>
		<!--comps>
		  <li Class="ModularWeapons.CompProperties_ModularParts">
			<compClass>ModularWeapons.CompModularParts</compClass>
			<partKinds>
			  <li>guy762_slot_underlay</li>
			  <li>guy762_slot_overlay</li>
			</partKinds>
			<randomizeParts>true</randomizeParts>
		  </li>
		</comps-->
	</ThingDef>	
	
	
	
