<?xml version="1.0" encoding="utf-8" ?>

<Defs>	

	<Vehicles.PatternDef>
		<defName>guy762_SWVehiclePattern_T47AirspeederA</defName>
		<label>T-47 Airspeeder (stock)</label>
		<path>Starfighters/T47Airspeeder/T47Airspeeder_pattern_stock</path>
		<exclusiveFor><li>guy762_SWVehicle_T47Airspeeder</li></exclusiveFor>
	</Vehicles.PatternDef>
	
	
	<Vehicles.VehicleDef Name="guy762_SWVehicle_T47Airspeeder" ParentName="guy762_VehiclePawnNonSpaceAircraftBASE">
		<defName>guy762_SWVehicle_T47Airspeeder</defName>
		<label>T-47 Airspeeder</label>
		<description>. \n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Pilot x1</description>
		<graphicData>
			<texPath>Starfighters/T47Airspeeder/T47Airspeeder</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
			<drawRotated>true</drawRotated>
			<drawSize>(7.5,7.5)</drawSize>
			<shaderType>CutoutComplexPattern</shaderType>
			<pattern>guy762_SWVehiclePattern_T47AirspeederA</pattern>
			<color>(170,75,50)</color> <!-- burnt orange -->
			<colorTwo>(220,90,50)</colorTwo> <!-- fire orange -->
			<colorThree>(177,177,177)</colorThree> <!-- alliance grey -->
		</graphicData>
		<uiIconScale>1</uiIconScale>
		<seeThroughFog>true</seeThroughFog>
		<drawOffscreen>true</drawOffscreen>
		<rotatable>True</rotatable>
		
		<fillPercent>1</fillPercent>
		<nameable>true</nameable>
		<buildDef>guy762_SWVehicleBP_T47Airspeeder</buildDef>
		<size>(5,5)</size>
		
		
		<!-- <killedLeavings> -->
		  <!-- <guy762_ShipChunk_z95a>1</guy762_ShipChunk_z95a> -->
		<!-- </killedLeavings> -->
		
		<canCaravan>false</canCaravan>
		<vehicleCategory>Combat</vehicleCategory>
		<techLevel>Spacer</techLevel>
		<vehicleType>Air</vehicleType>
		
		<statBases>
			<!--ArmorRating_Sharp>+0.05</ArmorRating_Sharp>
			<ArmorRating_Blunt>-0.1</ArmorRating_Blunt>        BASE CURVE FOR HARD ARMOR
			<ArmorRating_Heat>+0.15</ArmorRating_Heat-->
			<!--B--><ArmorRating_Sharp>0.035</ArmorRating_Sharp>
			<!--B--><ArmorRating_Blunt>0.02</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
			<!--B--><ArmorRating_Heat>0.045</ArmorRating_Heat>
			<MaxHitPoints>3000</MaxHitPoints> <!-- # of estimated XWMG hull points * 1000 -->
			
			<MarketValue>18000</MarketValue>
			<Flammability>0</Flammability>
			
			<!-- <EnergyShieldRechargeRate>0.5</EnergyShieldRechargeRate> -->
			<!-- <EnergyShieldEnergyMax>3</EnergyShieldEnergyMax> -->
		</statBases>
		<vehicleStats>
			<Mass>10500</Mass>
			
			<FlightSpeed>12</FlightSpeed> <!-- this is for world map flight, NOT in-tile flight-->
			<CargoCapacity>20</CargoCapacity>
			<SoS2CombatDodgeChance MayRequire="kentington.saveourship2">41.25</SoS2CombatDodgeChance> <!-- 3/8 chance to dodge on XWMG green dice = 0.375 | 0.375*10 + 10 = 13.75 | 13.75 * X = SoS2DC | X = estimated # of XWMG green dice -->
		</vehicleStats>
		
		<race>
			<baseBodySize>1.5</baseBodySize>
		</race>
		
		<drawProperties>
			<displayRotation>North</displayRotation>
		</drawProperties>
		
		<properties>
			<diagonalRotation>false</diagonalRotation><empStuns>true</empStuns>
			<worldSpeedMultiplier>0.01</worldSpeedMultiplier>
			<manhunterTargetsVehicle>false</manhunterTargetsVehicle>
			
			<vehicleJobLimitations>
				<li>(RepairVehicle, 4)</li> <!-- how many pawns can repair this vehicle at a time -->
			</vehicleJobLimitations>
			
			<roles>
				<li>
					<key>pilot</key>
					<label>Pilot</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<handlingTypes>
						<li>Movement</li>
						<li>Turret</li>
					</handlingTypes>
					<comfort>-0.25</comfort>
					
					<turretIds>
						<li>T47Key_gun_1</li>
						<li>T47Key_gun_2</li>
					</turretIds>
				</li>
				<li>
					<key>gunner</key>
					<label>Gunner</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<handlingTypes>
						<li>Turret</li>
					</handlingTypes>
					<comfort>-0.25</comfort>
					
					<turretIds>
						<li>T47Key_gun_3</li>
					</turretIds>
				</li>
			</roles>
		</properties>
		
		<comps>
			<li Class="Vehicles.CompProperties_FueledTravel">
				<fuelType>KOTOR_Rhydonium</fuelType>				<!-- Must Include -->
				<leakDef>Filth_Fuel</leakDef><targetFuelLevelConfigurable>true</targetFuelLevelConfigurable><ambientHeat>3.0</ambientHeat>
				<fuelConsumptionRate>2</fuelConsumptionRate>
				<fuelCapacity>25</fuelCapacity>
				<fuelConsumptionWorldMultiplier>0.5</fuelConsumptionWorldMultiplier>
			</li>
			
			<li Class="taranchuk_flightcombat.CompProperties_FlightMode">
				<flightCommands>
					<flightMode>
						<label>Flight mode</label>
						<description>Toggle flight mode.</description>
						<texPath>Gizmo/TakeOff_Icon</texPath>
					</flightMode>
					<hoverMode>
						<label>Hover mode</label>
						<description>Toggle hover mode.</description>
						<texPath>Gizmo/Liftoff_Icon</texPath>
					</hoverMode>
					<faceTarget>
						<label>Face target (hover)</label>
						<description>Face target while hovering.</description>
						<texPath>Gizmo/FaceTarget_Icon</texPath>
					</faceTarget>
					<cancelFaceTarget>
						<label>Cancel face target</label>
						<description>Cancel face target.</description>
						<texPath>Gizmo/FaceTargetStop_Icon</texPath>
					</cancelFaceTarget>
					<chaseTarget>
						<label>Chase target (flight)</label>
						<description>Chase target while flying.</description>
						<texPath>Gizmo/ChaseTarger_Icon</texPath>
					</chaseTarget>
				</flightCommands>
				
				<canFlyInSpace>false</canFlyInSpace>
				<fuelConsumptionPerTick>0.0001</fuelConsumptionPerTick>
				
				<flightSpeedPerTick>0.6</flightSpeedPerTick> <!-- MAXIMUM XWMG speed: speed5 = 1, speed1 = 0.2 | + 0.1 for blue 5, -0.1 for red highest -->
				<flightSpeedTurningPerTick>0.4</flightSpeedTurningPerTick> <!-- highest speed in which all 5 standard maneuvers are available | +0.1 for a full row of blues, -0.1 for any red turns -->
				<turnAnglePerTick>2</turnAnglePerTick> <!-- USE SLOWEST POSSIBLE TURN: speed1 turn = 4, speed2 turn = 2, speed3 turn = 1 | banks = 0.75, 0.5, 0.25 | -1 for red slowest -->
				<turnAngleCirclingPerTick>3.5</turnAngleCirclingPerTick> <!-- use slowest turn +1 for each special turning maneuver: speed1 turn = 2, speed2 turn = 1.5, speed3 turn = 1 | +0.5 for any blue turns, -0.5 for any red turns -->
				
				<flightSpeedCirclingPerTick>0.4</flightSpeedCirclingPerTick>
				<ellipseMajorAxis>120</ellipseMajorAxis>
				<ellipseMinorAxis>60</ellipseMinorAxis>
				
				<maxDistanceFromTargetElliptical>50</maxDistanceFromTargetElliptical>
				<maxDistanceFromTargetCircle>10</maxDistanceFromTargetCircle>
				
				<takeoffTicks>120</takeoffTicks>
				<landingTicks>120</landingTicks>
				<moveWhileTakingOff>false</moveWhileTakingOff><moveWhileLanding>false</moveWhileLanding>
				
				
				
				<runwayTerrainRequirements>
					<li>Light</li>
					<li>Medium</li>
					<li>Heavy</li>
				</runwayTerrainRequirements>
				<flightGraphicData>
					<texPath>Starfighters/T47Airspeeder/T47Airspeeder</texPath>
					<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
					<drawRotated>true</drawRotated>
					<drawSize>(7.5,7.5)</drawSize>
					<shaderType>CutoutComplexPattern</shaderType>
					<pattern>guy762_SWVehiclePattern_T47AirspeederA</pattern>
					<color>(170,75,50)</color> <!-- burnt orange -->
					<colorTwo>(220,90,50)</colorTwo> <!-- fire orange -->
					<colorThree>(177,177,177)</colorThree> <!-- alliance grey -->
				</flightGraphicData>
				
				<AISettings>
					<gunshipSettings>
						<!-- strafing run settings: Elliptical/Over -->
						<chaseMode>Elliptical</chaseMode><flightPattern>Over</flightPattern>
						<distanceFromTarget>30</distanceFromTarget>
					</gunshipSettings>
				</AISettings>
				
				<flightFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</flightFlecks>
				<hoverFlecks>
					<!-- can be filled with the same data as the flight flecks if necessary -->
				</hoverFlecks>
				<takeoffFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<solidTimeScaleByTakeoffInverse>true</solidTimeScaleByTakeoffInverse>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</takeoffFlecks>
				<landingFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<solidTimeScaleByTakeoff>true</solidTimeScaleByTakeoff>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</landingFlecks>
				<waypointFleck>guy762_SWStarfighter_waypoint</waypointFleck>
			</li>
			
			
			<li Class="Vehicles.CompProperties_VehicleTurrets">
				<turrets>
					<li>
						<turretDef>guy762_VehicleTurret_T47_AntiVehicleMain</turretDef>
						
						<renderProperties>
							<north>(-1.25, 3)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>light strike gun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<autoTargetingActive>True</autoTargetingActive>
						
						<key>T47Key_gun_1</key>
					</li>
					<li>
						<turretDef>guy762_VehicleTurret_T47_AntiVehicleMain</turretDef>
						
						<renderProperties>
							<north>(1.25, 3)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>light strike gun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<autoTargetingActive>True</autoTargetingActive>
						
						<key>T47Key_gun_2</key>
					</li>
					<li>
						<turretDef>guy762_VehicleTurret_T47_AntiInfantryRepeater</turretDef>
						
						<renderProperties>
							<north>(0, -2.2)</north>
						</renderProperties>
						<defaultAngleRotated>180</defaultAngleRotated>
						<angleRestricted>(90,270)</angleRestricted>
						<gizmoLabel>AI tailgun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<autoTargetingActive>True</autoTargetingActive>
						
						<key>T47Key_gun_3</key>
					</li>
					
				</turrets>
			</li>
		</comps>
		<components>
			<li>
				<key>Hull</key>
				<label>Hull</label>
				<depth>External</depth>
				
				<armor>
					<!--H--><ArmorRating_Sharp>0.35</ArmorRating_Sharp>
					<!--H--><ArmorRating_Blunt>0.2</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
					<!--H--><ArmorRating_Heat>0.45</ArmorRating_Heat>
					<IncomingDamageFactor>-0.05</IncomingDamageFactor> <!-- special -->
				</armor>
				<health>300</health> <!-- # of estimated XWMG hull points * 100 -->
				
				<hitbox>
					<side>Body</side>
				</hitbox>
			</li>
			
			<li>
				<key>FirstThruster</key>
				<label>Port Thruster</label>
				<health>120</health>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>5</radius>
						<damageDef>Flame</damageDef>
					</li>
				</reactors>
				
				<hitbox>
					<side>Body</side>
				</hitbox>
				
				<categories>
					<li>FlightSpeed</li>
				</categories>
			</li>
			<li>
				<key>SecondThruster</key>
				<label>Starboard Thruster</label>
				<health>120</health>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>5</radius>
						<damageDef>Flame</damageDef>
					</li>
				</reactors>
				
				<hitbox>
					<side>Body</side>
				</hitbox>
				
				<categories>
					<li>FlightSpeed</li>
					<li>FlightControl</li>
				</categories>
			</li>
			
			<li>
				<key>Reactor</key>
				<label>Reactor</label>
				<health>200</health>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>18</radius>
						<damageDef>Bomb</damageDef>
					</li>
				</reactors>
			</li>
			<li>
				<key>Cockpit</key>
				<label>Cockpit</label>
				<health>160</health>
				<depth>Internal</depth>
				
				<categories>
					<li>FlightControl</li>
				</categories>
			</li>
		</components>
		
		<soundSustainersOnEvent>
			<li>
				<start>IgnitionOn</start>
				<stop>IgnitionOff</stop>
				<value>kotorsound_enginehum_snowspeeder</value>
			</li>
		</soundSustainersOnEvent>
		
		<soundOneShotsOnEvent>
		</soundOneShotsOnEvent>
		
	</Vehicles.VehicleDef>
	
	
	
	
	
	
	
	
	
	<Vehicles.VehicleTurretDef ParentName="guy762_StarfighterTurretBASE">
		<defName>guy762_VehicleTurret_T47_AntiVehicleMain</defName>
		<label>T-47 Airspeeder main gun</label>
		<description>The main anti-vehicle gun of a T-47 Airspeeder.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_snowspeedergun</shotSound>
		
		<projectile>SWCPStarfighterBullet_StrikeAIAVAAlight_red</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		<!--genericAmmo>true</genericAmmo-->
		<!--chargePerAmmoCount>100</chargePerAmmoCount-->
		
		<empDisables>true</empDisables>
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<projectileOffset>2.1</projectileOffset>
		
		<minRange>5</minRange>
		<maxRange>60</maxRange> <!-- ~30 for infantry, 60 for ground vehicles, 90 for starfighters -->

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>10</ticksBetweenShots>
				<ticksBetweenBursts>20</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Sniper_Shot</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>NullTex</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
		</graphicData>
		
		<gizmoIconTexPath>Items/cannon_blank</gizmoIconTexPath>
		
		<!--ammunition>
			<thingDefs>
				<li>KOTOR_Tibanna</li>
			</thingDefs>
		</ammunition-->
	</Vehicles.VehicleTurretDef>
	
	
	
	<Vehicles.VehicleTurretDef ParentName="guy762_StarfighterTurretBASE">
		<defName>guy762_VehicleTurret_T47_AntiInfantryRepeater</defName>
		<label>T-47 antipersonnel repeater</label>
		<description>The antipersonnel repeater of a T-47 Airspeeder.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_SWGLrepeater</shotSound>
		
		<projectile>KotORBlasterBolt_default</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		
		<empDisables>true</empDisables>
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<projectileOffset>2.1</projectileOffset>
		
		<minRange>2</minRange>
		<maxRange>30</maxRange> <!-- ~30 for infantry, 60 for ground vehicles, 90 for starfighters -->

		<fireModes>
			<li>
				<shotsPerBurst>12</shotsPerBurst>
				<ticksBetweenShots>6</ticksBetweenShots>
				<ticksBetweenBursts>200</ticksBetweenBursts>
				<label>Burst</label>
				<texPath>UI/Improved_Rapid_Shot</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>Starfighters/T47Airspeeder/T47Airspeeder_gun</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<drawSize>(2.5,2.5)</drawSize>
		</graphicData>
		
		<gizmoIconTexPath>Starfighters/T47Airspeeder/T47Airspeeder_gun</gizmoIconTexPath>
		<!-- <modExtensions> -->
			<!-- <li MayRequire="SmashPhil.VehicleFramework" Class = "Vehicles.VehicleDamageMultiplierDefModExtension"> -->
			  <!-- <multiplier>0.01</multiplier> -->
			<!-- </li> -->
		<!-- </modExtensions> -->
	</Vehicles.VehicleTurretDef>
	
	
	
	
	
	
	
	
	
	
	

</Defs>