			<min>1200</min>
			<max>2400</max>
		</techHediffsMoney>

		<skills>
			<li>
				<skill>Shooting</skill>
				<range>4~8</range>
			</li>
			<li>
				<skill>Melee</skill>
				<range>4~6</range>
			</li>
			<li>
				<skill>Construction</skill>
				<range>6~10</range>
			</li>
			<li>
				<skill>Intellectual</skill>
				<range>10~12</range>
			</li>
		</skills>
