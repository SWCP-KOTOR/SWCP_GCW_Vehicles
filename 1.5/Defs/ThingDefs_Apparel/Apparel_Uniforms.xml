	<ThingDef ParentName="guy762_HatCraftableBase">
		<defName>guy762_UniformCap_rebel</defName>
		<label>uniform cap</label>
		<description>A formal cap for military personnel.</description>
		<graphicData>
		  <texPath>Apparel/GenericMilitaryFatigues/hat</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
		  <MarketValue>10</MarketValue>
		  <MaxHitPoints>80</MaxHitPoints>
		  <Mass>0.05</Mass>
		  <ArmorRating_Sharp>0.01</ArmorRating_Sharp>
		  <ArmorRating_Blunt>0.01</ArmorRating_Blunt>
		  <ArmorRating_Heat>0.01</ArmorRating_Heat>
		  <EquipDelay>0.1</EquipDelay>
		  
		  
		  <WorkToMake>1000</WorkToMake>
		</statBases>
		<!-- <equippedStatOffsets> -->
		  <!-- <SocialImpact>0.1</SocialImpact> -->
		<!-- </equippedStatOffsets> -->
		
		<recipeMaker>
			<skillRequirements>
				<Crafting>4</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<Cloth>20</Cloth>
		</costList>
		
		<apparel>
		  <wornGraphicPath>Apparel/GenericMilitaryFatigues/hat</wornGraphicPath>
		  <bodyPartGroups>
			<li>UpperHead</li>
		  </bodyPartGroups>
		  <layers>
			<li>Overhead</li>
		  </layers>
		  <tags>
			<li>NewRepublic_engineer</li>
			<li>NewRepublic_RebelAgent_hats</li>
		  </tags>
		  <countsAsClothingForNudity>false</countsAsClothingForNudity>
		  <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
		  <canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
		</apparel>
		<tradeTags>
			<li>guy762TT_KotORClothes</li>
		</tradeTags>
		<colorGenerator Class="ColorGenerator_Options" Inherit="False">
			<options>
				<li>
					<weight>15</weight>
					<only>(175,150,120)</only>       <!-- bespin beige -->
				</li>
			</options>
		</colorGenerator>
	</ThingDef> 
	  
	  
	  
	<ThingDef ParentName="guy762_clothingbase">
