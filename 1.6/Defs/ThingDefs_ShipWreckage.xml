	  <ThingDef ParentName="guy762_ShipChunkBase">
		<defName>guy762_ShipChunk_ATST</defName>
		<label>walker wreckage</label>
		<description>A chunk of a military walker. It seems to have been disabled by some kind of weapon.\n\nHaving been downed not long ago, it still contains useful resources which you can acquire by deconstructing it.</description>
		<category>Building</category>
		<graphicData>
		  <texPath>VehicleWreckage/wreckage_ATST</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		  <drawSize>(9.5,9.5)</drawSize>
		  
		  <drawRotated>false</drawRotated>
		  
		  <damageData>
			<rect>(0.1,0.1,1.8,1.8)</rect>
		  </damageData>
		  <shadowData>
			<volume>(1.39,0.5,1.25)</volume>
		  </shadowData>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<pathCost>42</pathCost>
		<blockWind>true</blockWind>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.50</fillPercent>
		<size>(9,7)</size>
		<statBases>
		  <MaxHitPoints>1000</MaxHitPoints>
		  <Flammability>0</Flammability>
		  <Beauty>-10</Beauty>
		  <WorkToBuild>36000</WorkToBuild>
		</statBases>
		<leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
		
		<!-- ADJUST BEFORE RELEASE!!! -->
		
		<killedLeavings>
		  <ChunkSlagSteel>10</ChunkSlagSteel>
		  <Steel>100</Steel>
		  <ComponentIndustrial>10</ComponentIndustrial>
		  <Plasteel>40</Plasteel>
		  <ComponentSpacer>4</ComponentSpacer>
		</killedLeavings>
		<costList>
		  <Steel>400</Steel>
		  <Plasteel>100</Plasteel>
		  <Uranium>100</Uranium>
		  <ComponentIndustrial>32</ComponentIndustrial>
		  <ComponentSpacer>14</ComponentSpacer>
		</costList>
		
		<!-- ADJUST BEFORE RELEASE!!! -->
		
		<building>
		  <claimable>false</claimable>
		  <alwaysDeconstructible>true</alwaysDeconstructible>
		</building>
		<selectable>true</selectable>
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<drawerType>MapMeshOnly</drawerType>
		<repairEffect>ConstructMetal</repairEffect>
	  </ThingDef>
	  
	  
	  
	  
	  
	  
	  
	  
	  
	  
	  
	  
	  
	  
	  
	  
	  
	  
	  
	  
	  
