	<XenotypeDef>
		<defName>SWCPDroidXenotype_PitDroid</defName>
		<label>DUM-series pit droid</label>
		<description>.</description>
		<iconPath>UI/DroidIcons/Icon_PitDroid</iconPath>
		<!-- <combatPowerFactor>1</combatPowerFactor> -->
		<inheritable>true</inheritable>
		<factionlessGenerationWeight>0</factionlessGenerationWeight>
		<genes>
		  <li>SWCPDroidBodyGene_PitDroid</li>
		  <li>Beard_NoBeardOnly</li>
		  <li>Hair_BaldOnly</li>
		  <li>guy762_DebugHead_nullForDroids</li>
		  <li MayRequire="RedMattis.BigSmall.Core">BS_AcidResistanceMid</li>
		</genes>
		<modExtensions>
		  <li Class="BigAndSmall.XenotypeExtension">
			<setRace>SWCP_BnSDroidRace_PitDroid</setRace>
			<forceRace>true</forceRace>
		  </li>
		</modExtensions>
	</XenotypeDef>
	
	
	
	
	
	
	
	
	
	

	
	
	
	
	
	
	
	
	<PawnKindDef Name="SWCPDroidColonistBnS_PitDroid" ParentName="guy762_BnSDroidPawnKindBase">
