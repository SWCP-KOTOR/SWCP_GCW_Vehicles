	<Vehicles.VehicleDef Name="guy762_SWVehicle_Scurrg" ParentName="MM-VF-Vehicle_Pawn">
		<defName>guy762_SWVehicle_Scurrg</defName>
		<label>Scurrg H-6 heavy bomber</label>
		<description>. \n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Pilot x1</description>
		<graphicData>
			<texPath>Starfighters/Scurrg/Scurrg</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass><drawRotated>true</drawRotated>
			<drawSize>(24,24)</drawSize>
			<shaderType>CutoutComplexPattern</shaderType>
			<pattern>guy762_SWVehiclePattern_ScurrgA</pattern>
			<color>(125,50,55)</color> <!-- scurrg red -->
			<colorTwo>(95,95,105)</colorTwo> <!-- bluish grey -->
			<colorThree>(225,225,225)</colorThree> <!-- less white -->
		</graphicData>
		<uiIconScale>1</uiIconScale>
		<seeThroughFog>true</seeThroughFog>
		<drawOffscreen>true</drawOffscreen>
		<rotatable>True</rotatable>
		
		<fillPercent>1</fillPercent>
		<nameable>true</nameable>
		<buildDef>guy762_SWVehicleBP_Scurrg</buildDef>
		<size>(24,14)</size>
		
		
		<canCaravan>false</canCaravan>
		<vehicleCategory>Combat</vehicleCategory>
		<techLevel>Spacer</techLevel>
		<vehicleType>Air</vehicleType>
		
		<statBases>
			<!--ArmorRating_Sharp>+0.05</ArmorRating_Sharp>
			<ArmorRating_Blunt>-0.1</ArmorRating_Blunt>        BASE CURVE FOR HARD ARMOR
			<ArmorRating_Heat>+0.15</ArmorRating_Heat-->
			<ArmorRating_Sharp>0.65</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.5</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
			<ArmorRating_Heat>0.75</ArmorRating_Heat>
			<MaxHitPoints>6000</MaxHitPoints> <!-- # of estimated XWMG hull points * 1000 -->
			
			<MarketValue>150000</MarketValue>
			<Flammability>0</Flammability>
			
			<EnergyShieldRechargeRate>0.5</EnergyShieldRechargeRate>
			<EnergyShieldEnergyMax>3</EnergyShieldEnergyMax>
		</statBases>
		<vehicleStats>
			<Mass>2500</Mass>
			
			<FlightSpeed>12</FlightSpeed> <!-- this is for world map flight, NOT in-tile flight-->
			<CargoCapacity>110</CargoCapacity>
			<SoS2CombatDodgeChance MayRequire="kentington.saveourship2">13.75</SoS2CombatDodgeChance> <!-- 3/8 chance to dodge on XWMG green dice = 0.375 | 0.375*10 + 10 = 13.75 | 13.75 * X = SoS2DC | X = estimated # of XWMG green dice -->
		</vehicleStats>
		
		<race>
			<baseBodySize>1.5</baseBodySize>
		</race>
		
		<drawProperties>
			<displayRotation>North</displayRotation>
		</drawProperties>
		
		<properties>
			<diagonalRotation>false</diagonalRotation><empStuns>true</empStuns>
			<worldSpeedMultiplier>0.01</worldSpeedMultiplier>
			<manhunterTargetsVehicle>false</manhunterTargetsVehicle>
			
			<vehicleJobLimitations>
				<li>(RepairVehicle, 6)</li> <!-- how many pawns can repair this vehicle at a time -->
			</vehicleJobLimitations>
			
			<roles>
				<li>
					<key>pilot</key>
					<label>Pilot</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<handlingTypes>
						<li>Movement</li>
						<li>Turret</li>
					</handlingTypes>
					
					<turretIds>
						<li>ScurrgKey_gun_1</li>
						<li>ScurrgKey_gun_2</li>
						<li>ScurrgKey_gun_5</li>
						<li>ScurrgKey_gun_6</li>
					</turretIds>
				</li>
				<li>
					<key>dorsalgunner</key>
					<label>Dorsal Gunner</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					
					<handlingTypes>Turret</handlingTypes>
					
					<turretIds>
						<li>ScurrgKey_gun_3</li>
					</turretIds>
				</li>
				<li>
					<key>bombardier</key>
