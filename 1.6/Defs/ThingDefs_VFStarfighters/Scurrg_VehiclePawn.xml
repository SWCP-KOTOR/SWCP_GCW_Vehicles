					<slotsToOperate>1</slotsToOperate>
					
					<handlingTypes>Turret</handlingTypes>
					
					<turretIds>
						<li>ScurrgKey_gun_4</li>
					</turretIds>
				</li>
				<li>
					<key>navigator</key>
					<label>Navigator</label>
					<slots>1</slots>
				</li>
				<li>
					<key>engineer</key>
					<label>Engineer</label>
					<slots>2</slots>
					<comfort>-0.5</comfort>
				</li>
