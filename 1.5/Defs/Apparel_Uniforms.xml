<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="guy762_clothingbase">
		<defName>guy762_ImpUniform_bigbelt</defName>
		<label>uniform, guard's</label>
		<description>These are simple garments that protect little more than the modesty of the wearer.</description>
		<graphicData>
		  <texPath>Apparel/Officer/bigbelt/Apparel</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		  <shaderType>CutoutComplex</shaderType>
		</graphicData>
		<statBases>
			<Mass>3</Mass>
			<MarketValue>100</MarketValue>
			<MaxHitPoints>100</MaxHitPoints>
			<ArmorRating_Sharp>0.01</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.01</ArmorRating_Blunt>
			<ArmorRating_Heat>0.01</ArmorRating_Heat>
			<Insulation_Cold>10</Insulation_Cold>
			<Insulation_Heat>5</Insulation_Heat>
			<EquipDelay>3</EquipDelay>
			
			<WorkToMake>4000</WorkToMake>
		</statBases>
		<equippedStatOffsets>
		  <VEF_MassCarryCapacity>5</VEF_MassCarryCapacity>
		</equippedStatOffsets>
		
		<recipeMaker>
			<researchPrerequisite>guy762_ResearchKotOR_sith</researchPrerequisite>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
		  <Synthread>75</Synthread>
		</costList>
		
		<apparel>
		  <tags Inherit="False">
			<li>SE_apparel_ensign</li>
		  </tags>
		  <wornGraphicPath>Apparel/Officer/bigbelt/Apparel</wornGraphicPath>
		  <useWornGraphicMask>true</useWornGraphicMask>
		  <defaultOutfitTags Inherit="False">
			<li>Worker</li>
		  </defaultOutfitTags>
		</apparel>
		<tradeTags>
			<li>guy762TT_SEArmor</li>
		</tradeTags>
		<colorGenerator Class="ColorGenerator_Options" Inherit="False">
			<options>
				<li>
					<weight>15</weight>
					<only>(125,125,110)</only> <!-- imperial olive -->
				</li>
				<!-- <li> -->
					<!-- <weight>1</weight> -->
					<!-- <only>(70,135,190)</only>new republic blue -->
				<!-- </li> -->
			</options>
		</colorGenerator>
	  </ThingDef>
	  
	  
	  
