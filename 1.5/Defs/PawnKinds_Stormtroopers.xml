				<color>(90,90,90)</color>
			</li>
		</specificApparelRequirements>

		<biocodeWeaponChance>0</biocodeWeaponChance>
		<weaponMoney>500</weaponMoney>
		<weaponTags>
			<li>SWRanged_E11carbine</li>
		</weaponTags>

		<techHediffsChance>1</techHediffsChance>
		<techHediffsMoney>
			<min>1200</min>
			<max>2400</max>
		</techHediffsMoney>

		<skills>
			<li>
				<skill>Shooting</skill>
				<range>6~13</range>
			</li>
			<li>
				<skill>Melee</skill>
				<range>4~7</range>
			</li>
		</skills>
		<inventoryOptions>
			<skipChance>0.25</skipChance>
			<subOptionsChooseOne>
				<li>
					<thingDef>guy762_medpac</thingDef>
					<countRange>1~3</countRange>
				</li>
				<li>
					<thingDef>guy762_stim_battle</thingDef>
					<countRange>0~1</countRange>
				</li>
			</subOptionsChooseOne>
		</inventoryOptions>

		<disallowedTraits>
			<li>Brawler</li>
		</disallowedTraits>
		<initialWillRange>0.5~2</initialWillRange>
		<initialResistanceRange>5~10</initialResistanceRange>
	</PawnKindDef>
	
	
