						<drawOffsetEast>(-2.125,0,0.4)</drawOffsetEast>
						<drawOffsetNorth>(0,0,-1.5)</drawOffsetNorth>
						<drawOffsetSouth>(0,0,1.5)</drawOffsetSouth>
						<drawOffsetWest>(2.125,0,0.4)</drawOffsetWest>
					</graphicData>
				</li>
				<li>
