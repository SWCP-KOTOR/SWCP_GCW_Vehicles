<?xml version="1.0" encoding="utf-8" ?>

<Defs>	

	<Vehicles.PatternDef>
		<defName>guy762_SWVehiclePattern_TIEBruteA</defName>
		<label>TIE Brute (stock)</label>
		<path>Starfighters/TIEBrute/TIEBrute_Pattern_stock</path>
		<exclusiveFor><li>guy762_SWVehicle_TIEBrute</li></exclusiveFor>
	</Vehicles.PatternDef>
	
	
	<Vehicles.VehicleDef Name="guy762_SWVehicle_TIEBrute" ParentName="MM-VF-Vehicle_Pawn">
		<defName>guy762_SWVehicle_TIEBrute</defName>
		<label>TIE/rb Brute</label>
		<description>. \n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Pilot x1</description>
		<graphicData>
			<texPath>Starfighters/TIEBrute/TIEBrute</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
			<drawRotated>true</drawRotated>
			<drawSize>(12,12)</drawSize>
			<shaderType>CutoutComplexPattern</shaderType>
			<pattern>guy762_SWVehiclePattern_TIEBruteA</pattern>
			<color>(165,165,190)</color>
			<colorTwo>(0,0,0)</colorTwo>
			<colorThree>(170,60,60)</colorThree>
		</graphicData>
		<uiIconScale>1</uiIconScale>
		<seeThroughFog>true</seeThroughFog>
		<drawOffscreen>true</drawOffscreen>
		<rotatable>True</rotatable>
		
		<fillPercent>1</fillPercent>
		<nameable>true</nameable>
		<buildDef>guy762_SWVehicleBP_TIEBrute</buildDef>
		<size>(12,7)</size>
		
		
		<canCaravan>false</canCaravan>
		<vehicleCategory>Combat</vehicleCategory>
		<techLevel>Spacer</techLevel>
		<vehicleType>Air</vehicleType>
		
		<statBases>
			<!--ArmorRating_Sharp>+0.05</ArmorRating_Sharp>
			<ArmorRating_Blunt>-0.1</ArmorRating_Blunt>        BASE CURVE FOR HARD ARMOR
			<ArmorRating_Heat>+0.15</ArmorRating_Heat-->
			<!--B--><ArmorRating_Sharp>0.085</ArmorRating_Sharp>
			<!--B--><ArmorRating_Blunt>0.07</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
			<!--B--><ArmorRating_Heat>0.095</ArmorRating_Heat>
			<MaxHitPoints>8000</MaxHitPoints> <!-- # of estimated XWMG hull points * 1000 -->
			
			<MarketValue>90000</MarketValue>
			<Flammability>0</Flammability>
		</statBases>
		<vehicleStats>
			<Mass>46500</Mass>
			
			<FlightSpeed>12</FlightSpeed> <!-- this is for world map flight, NOT in-tile flight-->
			<CargoCapacity>150</CargoCapacity>
			<SoS2CombatDodgeChance MayRequire="kentington.saveourship2">13.75</SoS2CombatDodgeChance> <!-- 3/8 chance to dodge on XWMG green dice = 0.375 | 0.375*10 + 10 = 13.75 | 13.75 * X = SoS2DC | X = estimated # of XWMG green dice -->
		</vehicleStats>
		
		<race>
			<baseBodySize>1.5</baseBodySize>
		</race>
		
		<drawProperties>
			<displayRotation>North</displayRotation>
		</drawProperties>
		
		<properties>
			<diagonalRotation>false</diagonalRotation><empStuns>true</empStuns>
			<worldSpeedMultiplier>0.01</worldSpeedMultiplier>
			<manhunterTargetsVehicle>false</manhunterTargetsVehicle>
			
			<vehicleJobLimitations>
				<li>(RepairVehicle, 2)</li> <!-- how many pawns can repair this vehicle at a time -->
			</vehicleJobLimitations> <!-- guy762 RULES: repair job count should be twice the amount of pawns to fully operate the vehicle -->
			
			<roles>
				<li>
					<key>pilot</key>
					<label>Pilot</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<handlingTypes>
						<li>Movement</li>
						<li>Turret</li>
					</handlingTypes>
					
					<turretIds>
						<li>TIEBruteKey_gun_1</li>
					</turretIds>
				</li>
				<li>
					<key>gunner</key>
					<label>Gunner</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<handlingTypes>
						<li>Turret</li>
					</handlingTypes>
					
					<turretIds>
						<li>TIEBruteKey_gun_2</li>
					</turretIds>
				</li>
			</roles>
		</properties>
		
		<comps>
			<li Class="Vehicles.CompProperties_FueledTravel">
				<electricPowered>true</electricPowered>
				<fuelConsumptionRate>2</fuelConsumptionRate>
				<fuelCapacity>400</fuelCapacity>
				<fuelConsumptionWorldMultiplier>10</fuelConsumptionWorldMultiplier>
			</li>
			
			
			<li Class="taranchuk_flightcombat.CompProperties_FlightMode">
				<flightCommands>
					<flightMode>
						<label>Flight mode</label>
						<description>Toggle flight mode.</description>
						<texPath>Gizmo/TakeOff_Icon</texPath>
					</flightMode>
					<!-- <hoverMode> -->
						<!-- <label>Hover mode</label> -->
						<!-- <description>Toggle hover mode.</description> -->
						<!-- <texPath>Gizmo/Liftoff_Icon</texPath> -->
					<!-- </hoverMode> -->
					<!-- <faceTarget> -->
						<!-- <label>Face target (hover)</label> -->
						<!-- <description>Face target while hovering.</description> -->
						<!-- <texPath>Gizmo/FaceTarget_Icon</texPath> -->
					<!-- </faceTarget> -->
					<!-- <cancelFaceTarget> -->
						<!-- <label>Cancel face target</label> -->
						<!-- <description>Cancel face target.</description> -->
						<!-- <texPath>Gizmo/FaceTargetStop_Icon</texPath> -->
					<!-- </cancelFaceTarget> -->
					<chaseTarget>
						<label>Chase target (flight)</label>
						<description>Chase target while flying.</description>
						<texPath>Gizmo/ChaseTarger_Icon</texPath>
					</chaseTarget>
				</flightCommands>
				
				<!-- <damageMultiplierFromNonAntiAirProjectiles>0.3</damageMultiplierFromNonAntiAirProjectiles> -->
				
				<fuelConsumptionPerTick>0.0001</fuelConsumptionPerTick><canFlyInSpace>true</canFlyInSpace>
				
				<flightSpeedPerTick>0.8</flightSpeedPerTick> <!-- MAXIMUM XWMG speed: speed5 = 1, speed1 = 0.2 | + 0.1 for blue 5, -0.1 for red highest -->
				<flightSpeedTurningPerTick>0.5</flightSpeedTurningPerTick> <!-- highest speed in which all 5 standard maneuvers are available | +0.1 for a full row of blues, -0.1 for any red turns -->
				<turnAnglePerTick>3</turnAnglePerTick> <!-- USE SLOWEST POSSIBLE TURN: speed1 turn = 4, speed2 turn = 2, speed3 turn = 1 | banks = 0.75, 0.5, 0.25 | -1 for red slowest -->
				<turnAngleCirclingPerTick>2</turnAngleCirclingPerTick> <!-- use slowest turn +1 for each special turning maneuver: speed1 turn = 2, speed2 turn = 1.5, speed3 turn = 1 | +0.5 for any blue turns, -0.5 for any red turns -->
				
				<flightSpeedCirclingPerTick>0.4</flightSpeedCirclingPerTick>
				<ellipseMajorAxis>120</ellipseMajorAxis>
				<ellipseMinorAxis>60</ellipseMinorAxis>
				
				<maxDistanceFromTargetElliptical>50</maxDistanceFromTargetElliptical>
				<maxDistanceFromTargetCircle>10</maxDistanceFromTargetCircle>
				
				<takeoffTicks>120</takeoffTicks>
				<landingTicks>120</landingTicks>
				<moveWhileTakingOff>false</moveWhileTakingOff><moveWhileLanding>false</moveWhileLanding>
				
				
				
				<runwayTerrainRequirements>
					<li>Light</li>
					<li>Medium</li>
					<li>Heavy</li>
				</runwayTerrainRequirements>
				<flightGraphicData>
					<texPath>Starfighters/TIEBrute/TIEBrute</texPath>
					<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
					<drawRotated>true</drawRotated>
					<drawSize>(12,12)</drawSize>
					<shaderType>CutoutComplexPattern</shaderType>
					<pattern>guy762_SWVehiclePattern_TIEBruteA</pattern>
					<color>(165,165,190)</color>
					<colorTwo>(0,0,0)</colorTwo>
					<colorThree>(170,60,60)</colorThree>
				</flightGraphicData>
				
				<!-- <bombOptions> -->
					<!-- <li> -->
						<!-- <label>proton bomb</label> -->
						<!-- <texPath>Weapons/Projectiles/energybomb</texPath> -->
						<!-- <costList> -->
							<!-- <Steel>10</Steel> -->
						<!-- </costList> -->
						<!-- <projectile>SWVehicleBullet_protonbomb</projectile> -->
						<!-- <cooldownTicks>60</cooldownTicks> -->
					<!-- </li> -->
				<!-- </bombOptions> -->
				<AISettings>
					<!-- <bomberSettings> -->
						<!-- <npcStock> -->
							<!-- <Steel>100</Steel> -->
						<!-- </npcStock> -->
						<!-- <maxBombRun>5</maxBombRun> -->
						<!-- <blacklistedBombs> -->
						<!-- </blacklistedBombs> -->
						<!-- <distanceFromTarget>20</distanceFromTarget> -->
					<!-- </bomberSettings> -->
					<gunshipSettings>
						<!-- strafing run settings: Elliptical/Over -->
						<chaseMode>Elliptical</chaseMode><flightPattern>Over</flightPattern>
						<distanceFromTarget>30</distanceFromTarget>
					</gunshipSettings>
				</AISettings>
				
				
				<flightFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</flightFlecks>
				<hoverFlecks>
					<!-- can be filled with the same data as the flight flecks if necessary -->
				</hoverFlecks>
				<takeoffFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<solidTimeScaleByTakeoffInverse>true</solidTimeScaleByTakeoffInverse>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</takeoffFlecks>
				<landingFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<solidTimeScaleByTakeoff>true</solidTimeScaleByTakeoff>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</landingFlecks>
				<waypointFleck>guy762_SWStarfighter_waypoint</waypointFleck>
			</li>
			
			
			<li Class="Vehicles.CompProperties_VehicleTurrets">
				<turrets>
					<li>
						<turretDef>guy762_VehicleTurret_TIEStriker_main</turretDef>
						
						<renderProperties>
							<north>(1.0675, 1.5)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>dual medium strike gun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<autoTargetingActive>True</autoTargetingActive>
						
						<key>TIEBruteKey_gun_1</key>
					</li>
					<li>
						<turretDef>guy762_VehicleTurret_TIEBrute_cannon</turretDef>
						
						<renderProperties>
							<north>(-2.5, 1.25)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<!-- <angleRestricted>(165,195)</angleRestricted> -->
						<angleRestricted>(355,5)</angleRestricted>
						<gizmoLabel>dual heavy assault gun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<key>TIEBruteKey_gun_2</key>
					</li>
				</turrets>
			</li>
		</comps>
		<components>
			<li>
				<key>Hull</key>
				<label>Hull</label>
				<depth>External</depth>
				
				<armor>
					<!--H--><ArmorRating_Sharp>0.85</ArmorRating_Sharp>
					<!--H--><ArmorRating_Blunt>0.7</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
					<!--H--><ArmorRating_Heat>0.95</ArmorRating_Heat>
					<IncomingDamageFactor>-0.20</IncomingDamageFactor> <!-- Interceptors: 0.10 | StrikeFighters: 0.15 | AssaultFighters: 0.20 | Transports: 0.25 -->
				</armor>
				<health>800</health> <!-- # of estimated XWMG hull points * 100 -->
				
				<hitbox>
					<side>Body</side>
				</hitbox>
			</li>
			
			<li>
				<key>FirstThruster</key>
				<label>Port Thruster</label>
				<health>120</health>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>5</radius>
						<damageDef>Flame</damageDef>
					</li>
				</reactors>
				
				<hitbox>
					<side>Body</side>
				</hitbox>
				
				<categories>
					<li>FlightSpeed</li>
				</categories>
			</li>
			<li>
				<key>SecondThruster</key>
				<label>Starboard Thruster</label>
				<health>120</health>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>5</radius>
						<damageDef>Flame</damageDef>
					</li>
				</reactors>
				
				<hitbox>
					<side>Body</side>
				</hitbox>
				
				<categories>
					<li>FlightSpeed</li>
					<li>FlightControl</li>
				</categories>
			</li>
			<li>
				<key>Reactor</key>
				<label>Reactor</label>
				<health>200</health>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>18</radius>
						<damageDef>Bomb</damageDef>
					</li>
				</reactors>
			</li>
			<li>
				<key>Cockpit</key>
				<label>Cockpit</label>
				<health>160</health>
				<depth>Internal</depth>
				
				<categories>
					<li>FlightControl</li>
				</categories>
			</li>
		</components>
		
		<soundSustainersOnEvent>
			<li>
				<start>IgnitionOn</start>
				<stop>IgnitionOff</stop>
				<value>kotorsound_enginehum_TIEBomber</value>
			</li>
		</soundSustainersOnEvent>
		
		<soundOneShotsOnEvent>
		</soundOneShotsOnEvent>
		
	</Vehicles.VehicleDef>
	
	
	
	
	<Vehicles.VehicleTurretDef ParentName="guy762_StarfighterTurretBASE">
		<defName>guy762_VehicleTurret_TIEBrute_cannon</defName>
		<label>TIE/rb side cannon</label>
		<description>The heavy cannons of a TIE Brute.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_turbolaser</shotSound>
		
		<projectile>SWCPStarfighterBullet_AssaultAVAAheavy_dualgreen</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		
		<empDisables>true</empDisables>
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<projectileOffset>2.1</projectileOffset> <!-- keep this on starfighters-->
		
		<minRange>30</minRange>
		<maxRange>90</maxRange>

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>12</ticksBetweenShots>
				<ticksBetweenBursts>120</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Sniper_Shot</texPath>
			</li>
			<!-- <li> -->
				<!-- <shotsPerBurst>3</shotsPerBurst> -->
				<!-- <ticksBetweenShots>12</ticksBetweenShots> -->
				<!-- <ticksBetweenBursts>150</ticksBetweenBursts> -->
				<!-- <label>Burst</label> -->
				<!-- <texPath>UI/Rapid_Shot</texPath> -->
			<!-- </li> -->
		</fireModes>

		<graphicData>
			<texPath>NullTex</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
		</graphicData>
		
		<gizmoIconTexPath>Items/cannon_blank</gizmoIconTexPath>
		
	</Vehicles.VehicleTurretDef>
	
	
	
</Defs>