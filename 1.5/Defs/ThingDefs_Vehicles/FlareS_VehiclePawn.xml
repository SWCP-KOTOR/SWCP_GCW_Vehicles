			<baseBodySize>1</baseBodySize>
		</race>
		
		<drawProperties>
			<graphicOverlays>
				<li>
					<graphicData>
						<texPath>LandVehicles/FlareS/FlareS_L2</texPath>
						<graphicClass>Vehicles.Graphic_Vehicle</graphicClass> <!-- Graphic_RGB if not using the pattern system -->
						<shaderType>CutoutComplexPattern</shaderType>
						<drawSize>(3,3)</drawSize>
						<layer>2</layer>
						<pattern>guy762_SWVehiclePattern_FlareS</pattern>
						<color>(215,20,35)</color>
						<colorTwo>(250,180,0)</colorTwo>
					</graphicData>
				</li>
			</graphicOverlays>
		</drawProperties>
		
		<vehicleStats>
			<Mass>100</Mass>
			<MoveSpeed>50</MoveSpeed>
			<CargoCapacity>10</CargoCapacity>
			<RepairRate>0.75</RepairRate>
			<!--AccelerationRate>0.08</AccelerationRate-->
		</vehicleStats>
		
		<properties>
			<diagonalRotation>false</diagonalRotation>
			
			<worldSpeedMultiplier>0.5</worldSpeedMultiplier>
			<!-- <winterSpeedMultiplier>1</winterSpeedMultiplier> -->
			<manhunterTargetsVehicle>true</manhunterTargetsVehicle>
			<offRoadMultiplier>1</offRoadMultiplier>
			
			<!-- <customHillinessCosts> -->
				<!-- <SmallHills>0.25</SmallHills> -->
				<!-- <LargeHills>0.75</LargeHills> -->
				<!-- <Mountainous>1.5</Mountainous> -->
			<!-- </customHillinessCosts> -->
			
			<!--customSnowCategoryTicks>
				<Dusting>4</Dusting>
				<Thin>8</Thin>
				<Medium>16</Medium>
				<Thick>24</Thick>
			</customSnowCategoryTicks-->
			
			<roles>
				<li>
					<key>rider</key>
					<label>Rider</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<exposed>true</exposed>
					
					<hitbox>
						<side>Body</side>
