						<drawOffsetSouth>(0,0,0.265)</drawOffsetSouth>
						<drawOffsetEast>(-0.45,0,0.325)</drawOffsetEast>
					</pawnRenderer>
				</li>
			</roles>
		</properties>
		
		<components>
			<li>
				<key>FrontWheel</key>
				<label>Front Wheel</label>
				<health>20</health>
				<depth>External</depth>
				
				<armor>
					<ArmorRating_Blunt>0</ArmorRating_Blunt>
					<ArmorRating_Sharp>0</ArmorRating_Sharp>
				</armor>
				
				<tags>
					<li>Wheel</li>
				</tags>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>BackWheel</key>
