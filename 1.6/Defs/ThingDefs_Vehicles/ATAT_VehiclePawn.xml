	<Vehicles.VehicleDef Name="guy762_SWVehicle_ATAT" ParentName="guy762_GroundVehiclePawn_base">
		<defName>guy762_SWVehicle_ATAT</defName>
		<label>AT-AT Armored Transport</label>
		<description>. \n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Driver x1</description>
		
		<!-- <combatPower>1000</combatPower> -->
		<!-- <npcProperties> -->
			<!-- <raidParams>SWCP_VehicleRaidParams_EdgeWalkInsOnly</raidParams> -->
			<!-- <targetAcquireRadius>250</targetAcquireRadius> -->
			<!-- <targetKeepRadius>50</targetKeepRadius> -->
			<!-- <runDownTargets>false</runDownTargets> -->
			<!-- <stopToShoot>true</stopToShoot> -->
		<!-- </npcProperties> -->
		<!-- <navigationCategory></navigationCategory> -->
		
		<graphicData>
			<texPath>LandVehicles/ATAT/ATAT</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
			<!-- <shaderType>CutoutComplexPattern</shaderType> -->
			<drawSize>(22.5,30)</drawSize>
			
			<!-- <drawOffset>(0,0,9)</drawOffset> -->
			<!-- <drawOffsetEast>(3,0,8)</drawOffsetEast> -->
			<!-- <drawOffsetWest>(-3,0,8)</drawOffsetWest> -->
			<drawOffset>(0,0,7)</drawOffset>
			<drawOffsetNorth>(0,0,7.5)</drawOffsetNorth>
			<drawOffsetEast>(4,0,8)</drawOffsetEast>
			<drawOffsetWest>(-4,0,8)</drawOffsetWest>
			
			<!-- <pattern>guy762_SWVehiclePattern_ATATA</pattern> -->
			<color>(185,185,185)</color> <!-- lighter grey -->
			<!-- <colorTwo>(140,90,60)</colorTwo> -->
			
			<!-- <shadowData> -->
				<!-- <volume>(8, 10, 16)</volume> -->
				<!-- <offset>(-3, 0, -8)</offset> -->
			<!-- </shadowData> -->
		</graphicData>
		
		<fillPercent>1</fillPercent>
		
		<nameable>true</nameable>
		<buildDef>guy762_SWVehicleBP_ATAT</buildDef>
		
		<size>(8,16)</size>
		<uiIconScale>1</uiIconScale>
		
		
		<vehicleCategory>Combat</vehicleCategory>
		<techLevel>Spacer</techLevel>
		<vehicleType>Land</vehicleType>
		
		<!-- <killedLeavings> -->
		  <!-- <guy762_ShipChunk_ATAT>1</guy762_ShipChunk_ATAT> -->
		<!-- </killedLeavings> -->
				
		<statBases> <!-- blanket applies to all parts without specified armor ratings -->
			<!--ArmorRating_Sharp>+0.05</ArmorRating_Sharp>
			<ArmorRating_Blunt>-0.1</ArmorRating_Blunt>        BASE CURVE FOR HARD ARMOR
			<ArmorRating_Heat>+0.15</ArmorRating_Heat-->
			<ArmorRating_Sharp>0.85</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.7</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
			<ArmorRating_Heat>0.95</ArmorRating_Heat>
			<MaxHitPoints>800</MaxHitPoints> <!-- # of estimated XWMG hull points * 100 -->
			
			<Flammability>0.5</Flammability>
			<MarketValue>150000</MarketValue>
		</statBases>
		
		<soundSustainersOnEvent>
			<li>
				<start>IgnitionOn</start>
				<stop>MoveStart</stop>
				<value>kotorsound_speederbike_idle</value>
			</li>
			<li>
				<start>MoveStart</start>
				<stop>MoveStop</stop>
				<value>kotorsound_ATATsteppy</value>
			</li>
			<li>
				<start>MoveStop</start>
				<stop>MoveStart</stop>
				<value>kotorsound_speederbike_idle</value>
			</li>
			<li>
				<start>MoveStop</start>
				<stop>IgnitionOff</stop>
				<value>kotorsound_speederbike_idle</value>
			</li>
		</soundSustainersOnEvent>
		
		<soundOneShotsOnEvent>
			<li>
				<key>IgnitionOn</key>
				<value>kotorsound_speederbike_activate</value>
			</li>
			<li>
				<key>IgnitionOff</key>
				<value>kotorsound_speederbike_deactivate</value>
			</li>
		</soundOneShotsOnEvent>
		
		<race>
			<baseBodySize>1</baseBodySize>
		</race>
		
		<vehicleStats>
			<Mass>250000</Mass>
			<MoveSpeed>2</MoveSpeed>
			<CargoCapacity>1000</CargoCapacity>
			<RepairRate>1</RepairRate>
			<!--AccelerationRate>0.08</AccelerationRate-->
		</vehicleStats>
		
		<properties>
			<diagonalRotation>false</diagonalRotation>
			<manhunterTargetsVehicle>false</manhunterTargetsVehicle>
			
			<worldSpeedMultiplier>0.5</worldSpeedMultiplier> <!-- higher number = faster travel -->
			<winterSpeedMultiplier>3.25</winterSpeedMultiplier> <!-- lower number = faster winter travel -->
			<offRoadMultiplier>1</offRoadMultiplier> <!-- lower number = faster travel -->
			
			<customRoadCosts AssignDefaults = "0.5" /> <!-- vanilla default is 0.5, lower number = faster -->
			<!-- <customTerrainCosts AllowTerrainWithTag="Water" PathCost="1"/>         "All Terrain" walker but can't traverse deep water -->
			<track Class = "Vehicles.VehicleTrack_Wake">
				<speed>1</speed>
			</track>
			
			<riverCost>5</riverCost> <!-- higher = slower, <1 = very fast on world map -->
			
			<vehicleJobLimitations>
				<li>(RepairVehicle, 6)</li> <!-- how many pawns can repair this vehicle at a time -->
			</vehicleJobLimitations> <!-- extra people can repair due to size of this vehicle -->
			
			<customHillinessCosts>
				<SmallHills>0.25</SmallHills>
				<LargeHills>0.75</LargeHills>
				<Mountainous>1.5</Mountainous>
			</customHillinessCosts>
			
			<customWeatherCosts>
				<Dusting>4</Dusting>
				<Thin>8</Thin>
				<Medium>16</Medium>
				<Thick>24</Thick>
			</customWeatherCosts>
			
			<roles>
				<li>
					<key>driver</key>
					<label>Driver</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<handlingTypes>
						<li>Movement</li>
					</handlingTypes>
					<!-- <comfort>-0.25</comfort> -->
				</li>
				<li>
					<key>gunner</key>
					<label>Gunner</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<handlingTypes>
						<li>Turret</li>
					</handlingTypes>
					<!-- <comfort>-0.25</comfort> -->
					
					<turretIds>
						<li>ATATKey_gun_1</li>
						<li>ATATKey_gun_2</li>
					</turretIds>
				</li>
				<li>
					<key>commander</key>
					<label>Commander</label>
					<slots>1</slots>
				</li>
				<li>
					<key>navigator</key>
					<label>Navigator</label>
					<slots>2</slots>
				</li>
				<li>
					<key>passenger</key>
					<label>Passenger</label>
					<slots>40</slots>
				</li>
			</roles>
		</properties>
		
		<components>
			<li>
				<key>ATATKey_hull</key>
				<label>Hull</label>
				<depth>External</depth>
				
				<armor> <!-- EaWX health/50 = hull points, round up -->
					<ArmorRating_Sharp>1.85</ArmorRating_Sharp>
					<ArmorRating_Blunt>1.7</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
					<ArmorRating_Heat>1.95</ArmorRating_Heat>
					<IncomingDamageFactor>-0.35</IncomingDamageFactor> <!-- unarmored: 0.05 | light vehicles: 0.15 | medium vehicles: 0.25 | heavy vehicles: 0.35 -->
				</armor>
				<health>800</health> <!-- # of estimated XWMG hull points * 100 -->
				
				<hitbox>
					<side>Body</side>
				</hitbox>
			</li>
			
			
			<!-- <li> -->
				<!-- <key>ATATKey_cockpit</key> -->
				<!-- <label>Cockpit</label> -->
				<!-- <health>100</health> -->
				<!-- <depth>Internal</depth> -->
			<!-- </li> -->
			<li>
				<key>ATATKey_engine</key>
				<label>Engine</label>
				<health>5</health>
				<priorityStatEfficiency>true</priorityStatEfficiency>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.5</chance>
						<maxHealth>0.2</maxHealth>
						<radius>3</radius>
						<damageDef>guy762_ExplosiveDamage_energy</damageDef>
					</li>
				</reactors>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>ATATKey_leftleg</key>
				<label>Left Leg</label>
				<health>10</health>
				<depth>Internal</depth>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>ATATKey_rightleg</key>
				<label>Right Leg</label>
				<health>10</health>
				<depth>Internal</depth>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>ATATKey_leftfoot</key>
				<label>Left Foot</label>
				<health>10</health>
				<depth>Internal</depth>
				
				<tags>
					<li>Wheel</li>
				</tags>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>ATATKey_rightfoot</key>
				<label>Right Foot</label>
				<health>10</health>
				<depth>Internal</depth>
				
				<tags>
					<li>Wheel</li>
				</tags>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
		</components>
		
		<comps>
			<li Class="Vehicles.CompProperties_FueledTravel">
				<fuelType>KOTOR_Rhydonium</fuelType>
				<leakDef>Filth_Fuel</leakDef>
				<fuelConsumptionRate>12.5</fuelConsumptionRate>
				<fuelCapacity>1000</fuelCapacity>
				<fuelConsumptionWorldMultiplier>10</fuelConsumptionWorldMultiplier>
				
				<targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
				<ambientHeat>1.0</ambientHeat>
			</li>
			<li Class="Vehicles.CompProperties_VehicleTurrets">
				<turrets>
					<li>
						<turretDef>guy762_VehicleTurret_ATAT_main</turretDef>
						
						<renderProperties>
							<north>(0, 19.5)</north>
							<south>(0, -5.5)</south>
							<east>(17, 8.5)</east>
							<west>(-17, 8.5)</west>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>heavy AV guns</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>

						<key>ATATKey_gun_1</key>
					</li>
					<li>
						<turretDef>guy762_VehicleTurret_ATAT_ai</turretDef>
						
						<renderProperties>
							<north>(-2.6, 21.75)</north>
							<south>(2.5, -4.425)</south>
							<east>(17.5, 11.5)</east>
							<west>(-17.5, 8.35)</west>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>heavy AI gun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>

						<key>ATATKey_gun_2</key>
					</li>
					<li>
						<turretDef>guy762_VehicleTurret_ATAT_ai</turretDef>
						
						<renderProperties>
							<north>(2.6, 21.75)</north>
							<south>(-2.5, -4.425)</south>
							<east>(17.5, 8.35)</east>
							<west>(-17.5, 11.5)</west>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>heavy AI gun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>

						<key>ATATKey_gun_3</key>
					</li>
				</turrets>
			</li>
		</comps>
		
		<modExtensions>
            <li Class="SWCP_GCW_Vehicles.VehicleTemperatureProtection">
                <protectFromHeat>true</protectFromHeat>
                <protectFromCold>true</protectFromCold>
            </li>
        </modExtensions>
	</Vehicles.VehicleDef>
	
	
	

	<Vehicles.VehicleTurretDef ParentName="guy762_VehicleTurretBASE">
		<defName>guy762_VehicleTurret_ATAT_main</defName>
		<label>AT-AT heavy anti-vehicle gun</label>
		<description>The main gun of an AT-AT walker.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_ATATgun</shotSound>
		
		<projectile>SWVehicleBullet_AVheavydoublegreen</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>1</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		
		
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<!-- <projectileOffset>2.1</projectileOffset> -->
		
		<minRange>5</minRange>
		<maxRange>90</maxRange>

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>10</ticksBetweenShots>
				<ticksBetweenBursts>250</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Sniper_Shot</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>NullTex</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
		</graphicData>
		
		<gizmoIconTexPath>Items/cannon_blank</gizmoIconTexPath>
		
	</Vehicles.VehicleTurretDef>
	
	
	<Vehicles.VehicleTurretDef ParentName="guy762_VehicleTurretBASE">
		<defName>guy762_VehicleTurret_ATAT_ai</defName>
		<label>AT-AT heavy anti-infantry gun</label>
		<description>The heavy anti-infantry gun of an AT-AT walker.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_ATATsidegun</shotSound>
		
		<projectile>SWVehicleBullet_AIgreen_heavy</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0.5</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		
		
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<!-- <projectileOffset>2.1</projectileOffset> -->
		
		<minRange>5</minRange>
		<maxRange>60</maxRange>

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>10</ticksBetweenShots>
				<ticksBetweenBursts>150</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Sniper_Shot</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>NullTex</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
		</graphicData>
		
		<gizmoIconTexPath>Items/cannon_blank</gizmoIconTexPath>
		
	</Vehicles.VehicleTurretDef>
	
	
	
	
	
	
	
</Defs>