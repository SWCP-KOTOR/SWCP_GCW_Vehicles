		<soundSustainersOnEvent>
			<li>
				<start>IgnitionOn</start>
				<stop>IgnitionOff</stop>
				<value>kotorsound_enginehum_XWing</value>
			</li>
		</soundSustainersOnEvent>
		
		<soundOneShotsOnEvent>
		</soundOneShotsOnEvent>
		
	</Vehicles.VehicleDef>
	
	
	
	
	
	
	
	
	
	
	
	
	<Vehicles.VehicleTurretDef ParentName="guy762_StarfighterTurretBASE">
		<defName>guy762_VehicleTurret_AWing_Main</defName>
		<label>A-Wing main gun</label>
		<description>The main gun of an RZ-1 A-Wing Starfighter.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_xwinggun</shotSound>
		
		<projectile>SWCPStarfighterBullet_IntAAlight_red</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		<!--genericAmmo>true</genericAmmo-->
		<!--chargePerAmmoCount>100</chargePerAmmoCount-->
		
		<empDisables>true</empDisables>
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<projectileOffset>2.1</projectileOffset>
		
		<minRange>5</minRange>
		<maxRange>90</maxRange>

		<fireModes>
			<li>
				<shotsPerBurst>3</shotsPerBurst>
				<ticksBetweenShots>10</ticksBetweenShots>
				<ticksBetweenBursts>40</ticksBetweenBursts>
				<label>Burst</label>
				<texPath>UI/Rapid_Shot</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>NullTex</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
		</graphicData>
		
		<gizmoIconTexPath>Items/cannon_blank</gizmoIconTexPath>
		
