	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>guy762_VehicleTurret_LAATi_Main</defName>
		<label>LAAT/i anti-infantry repeater</label>
		<description>The repeater turret of a LAAT/i gunship.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_LAATigun</shotSound>
		
		<projectile>SWVehicleBullet_AIgreen_light</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		
		<empDisables>true</empDisables>
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<projectileOffset>2.1</projectileOffset> <!-- keep this on starfighters-->
		
		<minRange>2</minRange>
		<maxRange>30</maxRange> <!-- ~30 for infantry, 60 for ground vehicles, 90 for starfighters -->

		<fireModes>
			<li>
				<shotsPerBurst>3</shotsPerBurst>
				<ticksBetweenShots>8</ticksBetweenShots>
				<ticksBetweenBursts>100</ticksBetweenBursts>
				<label>Burst</label>
				<texPath>UI/Rapid_Shot</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>Starfighters/LAATi/LAATi_MainGun</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<drawSize>(4,4)</drawSize>
		</graphicData>
		
		<gizmoIconTexPath>Starfighters/LAATi/LAATi_MainGun</gizmoIconTexPath>
		
	</Vehicles.VehicleTurretDef>
	
	
	
	
	
	
	
	
