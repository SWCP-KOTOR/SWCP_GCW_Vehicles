				<start>MoveStop</start>
				<stop>MoveStart</stop>
				<value>kotorsound_speederbike_idle</value>
			</li-->
			<li>
				<start>MoveStart</start>
				<stop>MoveStop</stop>
				<value>kotorsound_speederbike_moving</value>
			</li>
		</soundSustainersOnEvent>
		
		<soundOneShotsOnEvent>
			<li>
				<key>PawnEntered</key>
				<value>kotorsound_select_shipgun</value>
			</li>
			<li>
				<key>PawnExited</key>
				<value>kotorsound_select_shipgun</value>
			</li>
			<li>
				<key>PawnChangedSeats</key>
				<value>kotorsound_select_shipgun</value>
			</li>
			<li>
				<key>IgnitionOn</key>
				<value>kotorsound_speederbike_activate</value>
			</li>
			<li>
				<key>IgnitionOff</key>
				<value>kotorsound_speederbike_deactivate</value>
			</li>
			<li>
				<key>DamageTaken</key>
				<value>kotorsound_speederbike_damaged</value>
			</li>
			<li>
				<key>CargoAdded</key>
				<value>kotorsound_bag_open</value>
			</li>
			<li>
				<key>CargoRemoved</key>
				<value>kotorsound_bag_close</value>
			</li>
