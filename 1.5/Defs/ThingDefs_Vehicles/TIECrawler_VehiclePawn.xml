<?xml version="1.0" encoding="utf-8" ?>

<Defs>	

	
	<Vehicles.VehicleDef ParentName="guy762_GroundVehiclePawn_base">
		<defName>guy762_SWVehicle_TIECrawler</defName>
		<label>TIE/ct Crawler</label>
		<description>. \n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Driver x1</description>
		
		<graphicData>
			<texPath>LandVehicles/TIECrawler/TIECrawler</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
			<shaderType>CutoutComplexPattern</shaderType>
			<drawSize>(7,7)</drawSize>
			<color>(140,140,160)</color>
		</graphicData>
		
		<fillPercent>1</fillPercent>
		
		<nameable>false</nameable>
		<buildDef>guy762_SWVehicleBP_TIECrawler</buildDef>
		
		<size>(6,5)</size>
		<uiIconScale>1</uiIconScale>
		
		<vehicleMovementPermissions>DriverNeeded</vehicleMovementPermissions>
		<vehicleCategory>Transport</vehicleCategory>
		<techLevel>Spacer</techLevel>
		<vehicleType>Land</vehicleType>
				
		<statBases>
			<!--ArmorRating_Sharp>+0.05</ArmorRating_Sharp>
			<ArmorRating_Blunt>-0.1</ArmorRating_Blunt>        BASE CURVE FOR HARD ARMOR
			<ArmorRating_Heat>+0.15</ArmorRating_Heat-->
			<ArmorRating_Sharp>0.45</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.3</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
			<ArmorRating_Heat>0.55</ArmorRating_Heat>
			<MaxHitPoints>4000</MaxHitPoints> <!-- # of estimated XWMG hull points * 1000 -->
			
			<Flammability>0.5</Flammability>
			<MarketValue>5800</MarketValue>
		</statBases>
		
		<vehicleStats>
			<Mass>750</Mass>
			<MoveSpeed>20</MoveSpeed>
			<CargoCapacity>50</CargoCapacity>
			<RepairRate>2</RepairRate>
			<!--AccelerationRate>0.08</AccelerationRate-->
		</vehicleStats>
		
		<soundSustainersOnEvent>
			<li>
				<start>IgnitionOn</start>
				<stop>MoveStart</stop>
				<value>kotorsound_trackedvehicle_idle</value>
			</li>
			<li>
				<start>MoveStart</start>
				<stop>MoveStop</stop>
				<value>kotorsound_trackedvehicle_moving</value>
			</li>
			<li>
				<start>MoveStop</start>
				<stop>MoveStart</stop>
				<value>kotorsound_trackedvehicle_idle</value>
			</li>
			<li>
				<start>MoveStop</start>
				<stop>IgnitionOff</stop>
				<value>kotorsound_trackedvehicle_idle</value>
			</li>
		</soundSustainersOnEvent>
		
		<soundOneShotsOnEvent>
			<li>
				<key>PawnEntered</key>
				<value>kotorsound_select_shipgun</value>
			</li>
			<li>
				<key>PawnExited</key>
				<value>kotorsound_select_shipgun</value>
			</li>
			<li>
				<key>PawnChangedSeats</key>
				<value>kotorsound_select_shipgun</value>
			</li>
			<li>
				<key>IgnitionOn</key>
				<value>kotorsound_speederbike_activate</value>
			</li>
			<li>
				<key>IgnitionOff</key>
				<value>kotorsound_speederbike_deactivate</value>
			</li>
			<li>
				<key>CargoAdded</key>
				<value>kotorsound_footlocker_open</value>
			</li>
			<li>
				<key>CargoRemoved</key>
				<value>kotorsound_footlocker_close</value>
			</li>
		</soundOneShotsOnEvent>
		
		<race>
			<baseBodySize>1</baseBodySize>
		</race>
		
		
		<properties>
			<diagonalRotation>false</diagonalRotation>
			<worldSpeedMultiplier>1.2</worldSpeedMultiplier>
			<winterSpeedMultiplier>3.25</winterSpeedMultiplier>
			<manhunterTargetsVehicle>true</manhunterTargetsVehicle>
			<!--offRoadMultiplier>0.8</offRoadMultiplier-->
			
			<customRoadCosts AssignDefaults = "0.4" />
			<vehicleJobLimitations>
				<li>(RepairVehicle, 2)</li> <!-- how many pawns can repair this vehicle at a time -->
			</vehicleJobLimitations> <!-- guy762 RULES: repair job count should be twice the amount of pawns to fully operate the vehicle -->
			
			<customHillinessCosts>
				<SmallHills>0.25</SmallHills>
				<LargeHills>0.75</LargeHills>
				<Mountainous>1.5</Mountainous>
			</customHillinessCosts>
			
			<!--customSnowCategoryTicks>
				<Dusting>4</Dusting>
				<Thin>8</Thin>
				<Medium>16</Medium>
				<Thick>24</Thick>
			</customSnowCategoryTicks-->
			
			<roles>
				<li>
					<key>driver</key>
					<label>Driver</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<handlingTypes>
						<li>Movement</li>
						<li>Turret</li>
					</handlingTypes>
					<comfort>-0.25</comfort>
					
					<turretIds>
						<li>TIECrawlerKey_gun_1</li>
					</turretIds>
				</li>
			</roles>
		</properties>
		
		<components>
			<li>
				<key>TIECrawlerKey_hull</key>
				<label>Hull</label>
				<depth>External</depth>
				
				<armor>
					<ArmorRating_Sharp>0.45</ArmorRating_Sharp>
					<ArmorRating_Blunt>0.3</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
					<ArmorRating_Heat>0.55</ArmorRating_Heat>
					<IncomingDamageFactor>-0.20</IncomingDamageFactor> <!-- # of estimated XWMG hull points * -0.05 -->
				</armor>
				<health>400</health> <!-- # of estimated XWMG hull points * 100 -->
				
				<hitbox>
					<side>Body</side>
				</hitbox>
			</li>
			
			
			<!-- <li> -->
				<!-- <key>TIECrawlerKey_cockpit</key> -->
				<!-- <label>Cockpit</label> -->
				<!-- <health>100</health> -->
				<!-- <depth>Internal</depth> -->
			<!-- </li> -->
			<li>
				<key>TIECrawlerKey_engine</key>
				<label>Engine</label>
				<health>25</health>
				<priorityStatEfficiency>true</priorityStatEfficiency>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.5</chance>
						<maxHealth>0.2</maxHealth>
						<radius>3</radius>
						<damageDef>Flame</damageDef>
					</li>
				</reactors>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>TIECrawlerKey_leftaxle</key>
				<label>Left Axle</label>
				<health>25</health>
				<depth>Internal</depth>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>TIECrawlerKey_rightaxle</key>
				<label>Right Axle</label>
				<health>25</health>
				<depth>Internal</depth>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>TIECrawlerKey_tread_left</key>
				<label>Left Treads</label>
				<health>50</health>
				<depth>Internal</depth>
				
				<tags>
					<li>Wheel</li>
				</tags>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>TIECrawlerKey_tread_right</key>
				<label>Right Treads</label>
				<health>50</health>
				<depth>Internal</depth>
				
				<tags>
					<li>Wheel</li>
				</tags>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
		</components>

		<!--modExtensions>
			<li Class="VanillaVehiclesExpanded.StatExtension">
				<statToAdd>
					<li>VVE_VehicleTier</li>
				</statToAdd>
				<statValues>
					<li>VVE_Tier1</li>
				</statValues>
				<statDescriptions>
					<li>VVE_Tier1Desc</li>
				</statDescriptions>
			</li>
		</modExtensions-->
		
		<comps>
			<li Class="Vehicles.CompProperties_FueledTravel">
				<fuelType>KOTOR_Rhydonium</fuelType>
				<leakDef>Filth_Fuel</leakDef>
				<fuelConsumptionRate>12.5</fuelConsumptionRate>
				<fuelCapacity>30</fuelCapacity>
			</li>
			<li Class="Vehicles.CompProperties_VehicleTurrets">
				<turrets>
					<li>
						<turretDef>guy762_VehicleTurret_TIECrawler_main</turretDef>
						
						<renderProperties>
							<north>(0, 1.4)</north>
							<south>(0, -1.8)</south>
							<east>(1.8, 0)</east>
							<west>(-1.8, 0)</west>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>main gun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<key>TIECrawlerKey_gun_1</key>
					</li>
				</turrets>
			</li>
		</comps>
	</Vehicles.VehicleDef>
	
	
	
	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>guy762_VehicleTurret_TIECrawler_main</defName>
		<label>TIE/ct main gun</label>
		<description>The main gun of a TIE Crawler.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_TIECrawlerGun</shotSound>
		
		<projectile>SWVehicleBullet_TIEdoublegreen</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0.2</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		
		<hitFlags>IntendedTarget</hitFlags>
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<projectileOffset>2.1</projectileOffset>
		
		<minRange>5</minRange>
		<maxRange>60</maxRange>

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>10</ticksBetweenShots>
				<ticksBetweenBursts>60</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Sniper_Shot</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>NullTex</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
		</graphicData>
		
		<gizmoIconTexPath>Items/cannon_blank</gizmoIconTexPath>
		
	</Vehicles.VehicleTurretDef>
	
	
</Defs>