	<Vehicles.VehicleDef Name="guy762_SWVehicle_BTLA4YWing" ParentName="MM-VF-Vehicle_Pawn">
		<defName>guy762_SWVehicle_BTLA4YWing</defName>
		<label>BTL-A4 Y-Wing Starfighter</label>
		<description>. \n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Pilot x1</description>
		<graphicData>
			<texPath>Starfighters/BTLA4YWing/YWing</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
			<drawSize>(19,19)</drawSize>
			<shaderType>CutoutComplexPattern</shaderType>
			<pattern>guy762_SWVehiclePattern_YWingA</pattern>
			<color>(230,185,45)</color> <!-- republic yellow -->
			<colorTwo>(100,120,140)</colorTwo> <!-- new republic blue -->
			<colorThree>(177,177,177)</colorThree> <!-- alliance grey -->
		</graphicData>
		<uiIconScale>1</uiIconScale>
		<seeThroughFog>true</seeThroughFog>
		<drawOffscreen>true</drawOffscreen>
		<rotatable>True</rotatable>
		
		<fillPercent>1</fillPercent>
		<nameable>true</nameable>
		<buildDef>guy762_SWVehicleBP_BTLA4YWing</buildDef>
		<size>(10,18)</size>
		<vehicleMovementPermissions>DriverNeeded</vehicleMovementPermissions>
		
		<killedLeavings>
		  <guy762_ShipChunk_YWing>1</guy762_ShipChunk_YWing>
		</killedLeavings>
		
		<canCaravan>false</canCaravan>
		<vehicleCategory>Combat</vehicleCategory>
		<techLevel>Spacer</techLevel>
		<vehicleType>Air</vehicleType>
		
		<statBases>
			<!--ArmorRating_Sharp>+0.05</ArmorRating_Sharp>
			<ArmorRating_Blunt>-0.1</ArmorRating_Blunt>        BASE CURVE FOR HARD ARMOR
			<ArmorRating_Heat>+0.15</ArmorRating_Heat-->
			<ArmorRating_Sharp>0.55</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.4</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
			<ArmorRating_Heat>0.65</ArmorRating_Heat>
			<MaxHitPoints>5000</MaxHitPoints> <!-- # of estimated XWMG hull points * 1000 -->
			
			<MarketValue>45000</MarketValue>
			<Flammability>0</Flammability>
			
			<EnergyShieldRechargeRate>0.5</EnergyShieldRechargeRate> <!-- SPECIAL NOTE: shield and hull values have been swapped for the BTL-B republic Y-wing since it really doesn't make sense that the up-armored model would have 1 less hull value than the model with 70% of the plating removed -->
			<EnergyShieldEnergyMax>3</EnergyShieldEnergyMax>
		</statBases>
		<vehicleStats>
			<Mass>1050</Mass>
			
			<FlightSpeed>12</FlightSpeed> <!-- this is for world map flight, NOT in-tile flight-->
			<CargoCapacity>110</CargoCapacity>
			<SoS2CombatDodgeChance MayRequire="kentington.saveourship2">13.75</SoS2CombatDodgeChance> <!-- 3/8 chance to dodge on XWMG green dice = 0.375 | 0.375*10 + 10 = 13.75 | 13.75 * X = SoS2DC | X = estimated # of XWMG green dice -->
		</vehicleStats>
		
		<race>
			<baseBodySize>1.5</baseBodySize>
		</race>
		
		<drawProperties>
			<displayRotation>North</displayRotation>
		</drawProperties>
		
		<properties>
			<diagonalRotation>false</diagonalRotation>
			<worldSpeedMultiplier>0.01</worldSpeedMultiplier>
			<manhunterTargetsVehicle>false</manhunterTargetsVehicle>
			
			<vehicleJobLimitations>
				<li>(RepairVehicle, 2)</li> <!-- how many pawns can repair this vehicle at a time -->
			</vehicleJobLimitations>
			
			<roles>
				<li>
					<key>pilot</key>
					<label>Pilot</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<handlingTypes>
						<li>Movement</li>
						<li>Turret</li>
					</handlingTypes>
					<!-- <comfort>-0.25</comfort> -->
					
					<turretIds>
						<li>YWingKey_gun_1</li>
						<li>YWingKey_gun_2</li>
						<li>YWingKey_gun_3</li>
						<li>YWingKey_gun_4</li>
						<li>YWingKey_gun_5</li>
					</turretIds>
				</li>
			</roles>
		</properties>
		
		<comps>
			<li Class="Vehicles.CompProperties_FueledTravel">
				<fuelType>KOTOR_Rhydonium</fuelType>				<!-- Must Include -->
				<leakDef>Filth_Fuel</leakDef>
				<fuelConsumptionRate>2</fuelConsumptionRate>
				<fuelCapacity>80</fuelCapacity>
				<fuelConsumptionWorldMultiplier>0.5</fuelConsumptionWorldMultiplier>
			</li>
			
			<li Class="CompProperties_ProjectileInterceptor">
				<radius>10</radius>
				<color>(0.4, 0.4, 0.4)</color>
				
				<interceptGroundProjectiles>true</interceptGroundProjectiles>
				<interceptAirProjectiles>true</interceptAirProjectiles>
				<interceptNonHostileProjectiles>true</interceptNonHostileProjectiles>
				
				<reactivateEffect>BulletShieldGenerator_Reactivate</reactivateEffect>
				<activeSound>BulletShield_Ambience</activeSound>
				<hitPointsRestoreInstantlyAfterCharge>true</hitPointsRestoreInstantlyAfterCharge>
				
				<hitPoints>200</hitPoints> <!-- XWMG shield value * 100 -->
				
				<chargeDurationTicks>1800</chargeDurationTicks><!-- 30s -->
				<rechargeHitPointsIntervalTicks>120</rechargeHitPointsIntervalTicks>
				<minIdleAlpha>0.2</minIdleAlpha>
				<drawWithNoSelection>True</drawWithNoSelection>
				<disarmedByEmpForTicks>1500</disarmedByEmpForTicks>
				
				<gizmoTipKey>ProjectileInterceptorTip</gizmoTipKey>
			</li>
			
			<li Class="taranchuk_flightcombat.CompProperties_FlightMode">
				<flightCommands>
					<flightMode>
						<label>Flight mode</label>
						<description>Toggle flight mode.</description>
						<texPath>Gizmo/TakeOff_Icon</texPath>
					</flightMode>
					<hoverMode>
						<label>Hover mode</label>
						<description>Toggle hover mode.</description>
						<texPath>Gizmo/Liftoff_Icon</texPath>
					</hoverMode>
					<faceTarget>
						<label>Face target (hover)</label>
						<description>Face target while hovering.</description>
						<texPath>Gizmo/FaceTarget_Icon</texPath>
					</faceTarget>
					<cancelFaceTarget>
						<label>Cancel face target</label>
						<description>Cancel face target.</description>
						<texPath>Gizmo/FaceTargetStop_Icon</texPath>
					</cancelFaceTarget>
					<chaseTarget>
						<label>Chase target (flight)</label>
						<description>Chase target while flying.</description>
						<texPath>Gizmo/ChaseTarger_Icon</texPath>
					</chaseTarget>
				</flightCommands>
				
				<fuelConsumptionPerTick>0.0001</fuelConsumptionPerTick>
				
				<flightSpeedPerTick>0.7</flightSpeedPerTick> <!-- MAXIMUM XWMG speed: speed5 = 1, speed1 = 0.2 | + 0.1 for blue 5, -0.1 for red highest -->
				<flightSpeedTurningPerTick>0.5</flightSpeedTurningPerTick> <!-- highest speed in which all 5 standard maneuvers are available | +0.1 for a full row of blues, -0.1 for any red turns -->
				<turnAnglePerTick>2</turnAnglePerTick> <!-- USE SLOWEST POSSIBLE TURN: speed1 turn = 4, speed2 turn = 2, speed3 turn = 1 | banks = 0.75, 0.5, 0.25 | -1 for red slowest -->
				<turnAngleCirclingPerTick>0.5</turnAngleCirclingPerTick> <!-- use fastest possible turn | -0.5 for red fastest -->
				
				<distanceFromTargetToStartTurningChaseMode>20</distanceFromTargetToStartTurningChaseMode>
				<distanceFromTargetToStartTurningCircleMode>10</distanceFromTargetToStartTurningCircleMode>
				
				<takeoffTicks>120</takeoffTicks>
				<landingTicks>120</landingTicks>
				<moveWhileTakingOff>false</moveWhileTakingOff>
				
				
				
				<runwayTerrainRequirements>
					<li>Medium</li>
					<li>Heavy</li>
				</runwayTerrainRequirements>
				<flightGraphicData>
					<texPath>Starfighters/BTLA4YWing/YWing</texPath>
					<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
					<drawSize>(19,19)</drawSize>
					<shaderType>CutoutComplexPattern</shaderType>
					<pattern>guy762_SWVehiclePattern_YWingA</pattern>
					<color>(230,185,45)</color> <!-- republic yellow -->
					<colorTwo>(100,120,140)</colorTwo> <!-- new republic blue -->
					<colorThree>(177,177,177)</colorThree> <!-- alliance grey -->
				</flightGraphicData>
				
				<bombOptions>
					<li>
						<label>proton bomb</label>
						<texPath>Weapons/Projectiles/energybomb</texPath>
						<costList>
							<Steel>10</Steel>
						</costList>
						<projectile>SWVehicleBullet_protonbomb</projectile>
						<cooldownTicks>60</cooldownTicks>
					</li>
				</bombOptions>
				<AISettings>
					<!-- <bomberSettings> -->
						<!-- <npcStock> -->
							<!-- <Steel>100</Steel> -->
						<!-- </npcStock> -->
						<!-- <maxBombRun>5</maxBombRun> -->
						<!-- <blacklistedBombs> -->
						<!-- </blacklistedBombs> -->
						<!-- <distanceFromTarget>20</distanceFromTarget> -->
					<!-- </bomberSettings> -->
					<gunshipSettings>
						<npcStock>
							<!-- <CVNAmmoBluestandard>300</CVNAmmoBluestandard> -->
							<!-- <CVNAmmoRedstandard>300</CVNAmmoRedstandard> -->
						</npcStock>
						<gunshipMode>Chasing</gunshipMode>
						<distanceFromTarget>30</distanceFromTarget>
					</gunshipSettings>
				</AISettings>
				
				<flightFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</flightFlecks>
				<hoverFlecks>
					<!-- can be filled with the same data as the flight flecks if necessary -->
				</hoverFlecks>
				<takeoffFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<solidTimeScaleByTakeoffInverse>true</solidTimeScaleByTakeoffInverse>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</takeoffFlecks>
				<landingFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<solidTimeScaleByTakeoff>true</solidTimeScaleByTakeoff>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</landingFlecks>
				<waypointFleck>guy762_SWStarfighter_waypoint</waypointFleck>
			</li>
			
			
			<li Class="Vehicles.CompProperties_VehicleTurrets">
				<turrets>
					<li>
						<turretDef>guy762_VehicleTurret_YWing_Main</turretDef>
						
						<renderProperties>
							<north>(0, 8.5)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>main gun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<autoTargetingActive>True</autoTargetingActive>
						
						<key>YWingKey_gun_1</key>
					</li>
					<li>
						<turretDef>guy762_VehicleTurret_YWing_Dorsal</turretDef>
						
						<renderProperties>
							<north>(0, 4.25)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<!-- <angleRestricted>(315,45)</angleRestricted> -->
						<gizmoLabel>dorsal ion turret</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<autoTargetingActive>True</autoTargetingActive>
						
						<key>YWingKey_gun_2</key>
					</li>

					<!--/////////////////////////-->
					
					<li>
						<turretDef>guy762_VehicleTurret_ProtonBombs</turretDef>
						
						<renderProperties>
							<north>(0, -1.75)</north>
						</renderProperties>
						<defaultAngleRotated>180</defaultAngleRotated>
						<angleRestricted>(165,195)</angleRestricted>
						<gizmoLabel>bomb bay</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<key>YWingKey_gun_3</key>
					</li>
					
					<!--/////////////////////////-->
					
					<li>
						<turretDef>guy762_VehicleTurret_ProTorp</turretDef>
						
						<renderProperties>
							<north>(-1.35, 5.75)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>proton torpedo launcher</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<key>YWingKey_gun_4</key>
					</li>
					<li>
						<turretDef>guy762_VehicleTurret_ProTorp</turretDef>
						
						<renderProperties>
							<north>(1.35, 5.75)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>proton torpedo launcher</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<key>YWingKey_gun_5</key>
					</li>
					
				</turrets>
			</li>
		</comps>
		<components>
			<li>
				<key>Hull</key>
				<label>Hull</label>
				<depth>External</depth>
				
				<armor>
					<ArmorRating_Sharp>1.55</ArmorRating_Sharp>
					<ArmorRating_Blunt>1.4</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
					<ArmorRating_Heat>1.65</ArmorRating_Heat>
					<IncomingDamageFactor>-0.25</IncomingDamageFactor> <!-- # of estimated XWMG hull points * -0.05 -->
				</armor>
				<health>500</health> <!-- # of estimated XWMG hull points * 100 -->
				
				<hitbox>
					<side>Body</side>
				</hitbox>
			</li>
			
			<li>
				<key>FirstThruster</key>
				<label>Port Thruster</label>
				<health>120</health>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>5</radius>
						<damageDef>Flame</damageDef>
					</li>
				</reactors>
				
				<hitbox>
					<side>Body</side>
				</hitbox>
				
				<categories>
					<li>FlightSpeed</li>
				</categories>
			</li>
			<li>
				<key>SecondThruster</key>
				<label>Starboard Thruster</label>
				<health>120</health>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>5</radius>
						<damageDef>Flame</damageDef>
					</li>
				</reactors>
				
				<hitbox>
					<side>Body</side>
				</hitbox>
				
				<categories>
					<li>FlightSpeed</li>
				</categories>
			</li>
			
			<li>
				<key>Reactor</key>
				<label>Reactor</label>
				<health>200</health>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>18</radius>
						<damageDef>Bomb</damageDef>
					</li>
				</reactors>
			</li>
			<li>
				<key>Cockpit</key>
				<label>Cockpit</label>
				<health>160</health>
				<depth>Internal</depth>
				
				<categories>
					<li>FlightControl</li>
				</categories>
			</li>
		</components>
		
		<soundSustainersOnEvent>
			<li>
				<start>IgnitionOn</start>
				<stop>IgnitionOff</stop>
				<value>kotorsound_enginehum_YWing</value>
			</li>
		</soundSustainersOnEvent>
		
		<soundOneShotsOnEvent>
		</soundOneShotsOnEvent>
		
	</Vehicles.VehicleDef>
	
	
	
	
	
	
	
	
	
	
	
	
	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>guy762_VehicleTurret_YWing_Main</defName>
		<label>Y-Wing main gun</label>
		<description>The main gun of a BTL-A4 Y-Wing Starfighter.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_ywinggun</shotSound>
		
		<projectile>SWVehicleBullet_SFdoublered</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		
		<hitFlags>IntendedTarget</hitFlags>
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<projectileOffset>2.1</projectileOffset>
		
		<minRange>5</minRange>
		<maxRange>90</maxRange>

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>10</ticksBetweenShots>
				<ticksBetweenBursts>40</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Sniper_Shot</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>NullTex</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
		</graphicData>
		
		<gizmoIconTexPath>Items/cannon_blank</gizmoIconTexPath>

	</Vehicles.VehicleTurretDef>
	
	
	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>guy762_VehicleTurret_YWing_Dorsal</defName>
		<label>Y-Wing dorsal ion turret</label>
		<description>The rotating dorsal turret of a BTL-A4 Y-Wing Starfighter.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_ioncannon_small_louder</shotSound>
		
		<projectile>SWVehicleBullet_SFdoubleion</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0.5</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		
		<hitFlags>IntendedTarget</hitFlags>
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<projectileOffset>2.1</projectileOffset> <!-- keep this on starfighters-->
		
		<minRange>5</minRange>
		<maxRange>90</maxRange> <!-- ~30 for infantry, 60 for ground vehicles, 90 for starfighters -->

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>10</ticksBetweenShots>
				<ticksBetweenBursts>150</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Ion_Power_Blast</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>Starfighters/BTLA4YWing/YWing_gun</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<drawSize>(3,3)</drawSize>
		</graphicData>
		
		<gizmoIconTexPath>Starfighters/BTLA4YWing/YWing_gun</gizmoIconTexPath>
		
	</Vehicles.VehicleTurretDef>
	
	
	
	
	
	
	
	
	
	
	
