			<SWCPDroidXenotype_PitDroid MayRequire="Ludeon.Rimworld.Biotech">999</SWCPDroidXenotype_PitDroid>
		  </xenotypeChances>
		</xenotypeSet>
		
        <combatPower>30</combatPower>
		<forcedTraits>
			<Asexual>0</Asexual>
			<!-- <TooSmart>0</TooSmart> -->
		</forcedTraits>
		<backstoryFiltersOverride>
		  <li>
			<categories>
			  <li>guy762BSC_Droid_PitDroid</li>
			</categories>
