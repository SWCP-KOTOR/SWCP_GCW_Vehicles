<?xml version="1.0" encoding="utf-8" ?>

<Defs>	

	<Vehicles.PatternDef>
		<defName>guy762_SWVehiclePattern_TIEDefA</defName>
		<label>TIE Defender (stock)</label>
		<path>Starfighters/TIEDefender/TIEDef_pattern</path>
	</Vehicles.PatternDef>
	
	
	<Vehicles.VehicleDef Name="guy762_SWVehicle_TIEDefender" ParentName="MM-VF-Vehicle_Pawn">
		<defName>guy762_SWVehicle_TIEDefender</defName>
		<label>TIE/d Defender</label>
		<description>. \n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Pilot x1</description>
		<graphicData>
			<texPath>Starfighters/TIEDefender/TIEDef</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass><drawRotated>true</drawRotated>
			<drawSize>(11,11)</drawSize>
			<shaderType>CutoutComplexPattern</shaderType>
			<pattern>guy762_SWVehiclePattern_TIEDefA</pattern>
			<color>(180,180,215)</color>
			<colorTwo>(180,180,215)</colorTwo>
		</graphicData>
		<uiIconScale>1</uiIconScale>
		<seeThroughFog>true</seeThroughFog>
		<drawOffscreen>true</drawOffscreen>
		<rotatable>True</rotatable>
		
		<fillPercent>1</fillPercent>
		<nameable>true</nameable>
		<buildDef>guy762_SWVehicleBP_TIEDef</buildDef>
		<size>(9,9)</size>
		<!--<vehicleMovementPermissions>NoDriverNeeded</vehicleMovementPermissions>-->
		
		<canCaravan>false</canCaravan>
		<vehicleCategory>Combat</vehicleCategory>
		<techLevel>Spacer</techLevel>
		<vehicleType>Air</vehicleType>
		
		<statBases>
			<!--ArmorRating_Sharp>+0.05</ArmorRating_Sharp>
			<ArmorRating_Blunt>-0.1</ArmorRating_Blunt>        BASE CURVE FOR HARD ARMOR
			<ArmorRating_Heat>+0.15</ArmorRating_Heat-->
			<ArmorRating_Sharp>0.35</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.2</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
			<ArmorRating_Heat>0.45</ArmorRating_Heat>
			<MaxHitPoints>3000</MaxHitPoints> <!-- # of estimated XWMG hull points * 1000 -->
			
			<MarketValue>36000</MarketValue>
			<Flammability>0</Flammability>
			
			<EnergyShieldRechargeRate>0.5</EnergyShieldRechargeRate>
			<EnergyShieldEnergyMax>3</EnergyShieldEnergyMax>
		</statBases>
		<vehicleStats>
			<Mass>350</Mass>
			
			<FlightSpeed>12</FlightSpeed> <!-- this is for world map flight, NOT in-tile flight-->
			<CargoCapacity>20</CargoCapacity>
			<SoS2CombatDodgeChance MayRequire="kentington.saveourship2">41.25</SoS2CombatDodgeChance> <!-- 3/8 chance to dodge on XWMG green dice = 0.375 | 0.375*10 + 10 = 13.75 | 13.75 * X = SoS2DC | X = estimated # of XWMG green dice -->
		</vehicleStats>
		
		<race>
			<baseBodySize>1.5</baseBodySize>
		</race>
		
		<drawProperties>
			<displayRotation>North</displayRotation>
		</drawProperties>
		
		<properties>
			<diagonalRotation>false</diagonalRotation><empStuns>true</empStuns>
			<worldSpeedMultiplier>0.01</worldSpeedMultiplier>
			<manhunterTargetsVehicle>false</manhunterTargetsVehicle>
			
			<vehicleJobLimitations>
				<li>(RepairVehicle, 2)</li> <!-- how many pawns can repair this vehicle at a time -->
			</vehicleJobLimitations> <!-- guy762 RULES: repair job count should be twice the amount of pawns to fully operate the vehicle -->
			
			<roles>
				<li>
					<key>pilot</key>
					<label>Pilot</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<handlingTypes>
						<li>Movement</li>
						<li>Turret</li>
					</handlingTypes>
					<comfort>-0.5</comfort>
					
					<turretIds>
						<li>TIEDefKey_gun_1</li>
						<li>TIEDefKey_gun_2</li>
						<li>TIEDefKey_gun_3</li>
					</turretIds>
				</li>
			</roles>
		</properties>
		
		<comps>
			<li Class="Vehicles.CompProperties_FueledTravel">
				<electricPowered>true</electricPowered>
				<fuelConsumptionRate>2</fuelConsumptionRate>
				<fuelCapacity>250</fuelCapacity>
				<fuelConsumptionWorldMultiplier>0.5</fuelConsumptionWorldMultiplier>
			</li>
			
			<li Class="CompProperties_ProjectileInterceptor">
				<radius>6</radius>
				<color>(0.4, 0.4, 0.4)</color>
				
				<interceptGroundProjectiles>true</interceptGroundProjectiles>
				<interceptAirProjectiles>true</interceptAirProjectiles>
				<interceptNonHostileProjectiles>true</interceptNonHostileProjectiles>
				
				<reactivateEffect>BulletShieldGenerator_Reactivate</reactivateEffect>
				<activeSound>BulletShield_Ambience</activeSound>
				<hitPointsRestoreInstantlyAfterCharge>true</hitPointsRestoreInstantlyAfterCharge>
				
				<hitPoints>400</hitPoints> <!-- XWMG shield value * 100 -->
				
				<chargeDurationTicks>1800</chargeDurationTicks><!-- 30s -->
				<rechargeHitPointsIntervalTicks>120</rechargeHitPointsIntervalTicks>
				<minIdleAlpha>0.2</minIdleAlpha>
				<drawWithNoSelection>True</drawWithNoSelection>
				<disarmedByEmpForTicks>1500</disarmedByEmpForTicks>
				
				<gizmoTipKey>ProjectileInterceptorTip</gizmoTipKey>
			</li>
			
			<li Class="taranchuk_flightcombat.CompProperties_FlightMode">
				<flightCommands>
					<flightMode>
						<label>Flight mode</label>
						<description>Toggle flight mode.</description>
						<texPath>Gizmo/TakeOff_Icon</texPath>
					</flightMode>
					<hoverMode>
						<label>Hover mode</label>
						<description>Toggle hover mode.</description>
						<texPath>Gizmo/Liftoff_Icon</texPath>
					</hoverMode>
					<faceTarget>
						<label>Face target (hover)</label>
						<description>Face target while hovering.</description>
						<texPath>Gizmo/FaceTarget_Icon</texPath>
					</faceTarget>
					<cancelFaceTarget>
						<label>Cancel face target</label>
						<description>Cancel face target.</description>
						<texPath>Gizmo/FaceTargetStop_Icon</texPath>
					</cancelFaceTarget>
					<chaseTarget>
						<label>Chase target (flight)</label>
						<description>Chase target while flying.</description>
						<texPath>Gizmo/ChaseTarger_Icon</texPath>
					</chaseTarget>
				</flightCommands>
				
				<fuelConsumptionPerTick>0.001</fuelConsumptionPerTick>
				
				<flightSpeedPerTick>1.1</flightSpeedPerTick> <!-- MAXIMUM XWMG speed: speed5 = 1, speed1 = 0.2 | +0.1 for blue 5, -0.1 for red highest -->
				<flightSpeedTurningPerTick>0.5</flightSpeedTurningPerTick> <!-- highest speed in which all 5 standard maneuvers are available | +0.1 for a full row of blues, -0.1 for any red turns -->
				<turnAnglePerTick>3</turnAnglePerTick> <!-- USE SLOWEST POSSIBLE TURN: speed1 turn = 4, speed2 turn = 2, speed3 turn = 1 | banks = 0.75, 0.5, 0.25 | -1 for red slowest -->
				<turnAngleCirclingPerTick>1</turnAngleCirclingPerTick> <!-- use fastest possible turn | -0.5 for red fastest -->
				
				<distanceFromTargetToStartTurningChaseMode>20</distanceFromTargetToStartTurningChaseMode>
				<distanceFromTargetToStartTurningCircleMode>10</distanceFromTargetToStartTurningCircleMode>
				
				<takeoffTicks>120</takeoffTicks>
				<landingTicks>120</landingTicks>
				<moveWhileTakingOff>false</moveWhileTakingOff>
				
				
				
				<runwayTerrainRequirements>
					<li>Light</li>
					<li>Medium</li>
					<li>Heavy</li>
				</runwayTerrainRequirements>
				<flightGraphicData>
					<texPath>Starfighters/TIEDefender/TIEDef</texPath>
					<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
					<drawRotated>true</drawRotated>
					<drawSize>(11,11)</drawSize>
					<shaderType>CutoutComplexPattern</shaderType>
					<pattern>guy762_SWVehiclePattern_TIEDefA</pattern>
					<color>(180,180,215)</color>
					<colorTwo>(180,180,215)</colorTwo>
				</flightGraphicData>
				
				<AISettings>
					<gunshipSettings>
						<npcStock>
							<!-- <CVNAmmoBluestandard>300</CVNAmmoBluestandard> -->
							<!-- <CVNAmmoRedstandard>300</CVNAmmoRedstandard> -->
						</npcStock>
						<gunshipMode>Chasing</gunshipMode>
						<distanceFromTarget>30</distanceFromTarget>
					</gunshipSettings>
				</AISettings>
				
				<flightFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</flightFlecks>
				<hoverFlecks>
					<!-- can be filled with the same data as the flight flecks if necessary -->
				</hoverFlecks>
				<takeoffFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<solidTimeScaleByTakeoffInverse>true</solidTimeScaleByTakeoffInverse>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</takeoffFlecks>
				<landingFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<solidTimeScaleByTakeoff>true</solidTimeScaleByTakeoff>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</landingFlecks>
				<waypointFleck>guy762_SWStarfighter_waypoint</waypointFleck>
			</li>
			
			
			<li Class="Vehicles.CompProperties_VehicleTurrets">
				<turrets>
					<li>
						<turretDef>guy762_VehicleTurret_TIEFighter_main</turretDef>
						
						<renderProperties>
							<north>(0, 3.4)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>dual gun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<autoTargetingActive>True</autoTargetingActive>
						
						<key>TIEDefKey_gun_1</key>
					</li>
					<li>
						<turretDef>guy762_VehicleTurret_TIEFighter_main</turretDef>
						
						<renderProperties>
							<north>(-2.5, 3.4)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>dual gun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<autoTargetingActive>True</autoTargetingActive>
						
						<key>TIEDefKey_gun_2</key>
					</li>
					<li>
						<turretDef>guy762_VehicleTurret_TIEFighter_main</turretDef>
						
						<renderProperties>
							<north>(2.5, 3.4)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>dual gun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<autoTargetingActive>True</autoTargetingActive>
						
						<key>TIEDefKey_gun_3</key>
					</li>
				</turrets>
			</li>
		</comps>
		<components>
			<li>
				<key>Hull</key>
				<label>Hull</label>
				<depth>External</depth>
				
				<armor>
					<ArmorRating_Sharp>1.35</ArmorRating_Sharp>
					<ArmorRating_Blunt>1.2</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
					<ArmorRating_Heat>1.45</ArmorRating_Heat>
					<IncomingDamageFactor>-0.15</IncomingDamageFactor> <!-- # of estimated XWMG hull points * -0.05 -->
				</armor>
				<health>300</health> <!-- # of estimated XWMG hull points * 100 -->
				
				<hitbox>
					<side>Body</side>
				</hitbox>
			</li>
			
			<li>
				<key>FirstThruster</key>
				<label>Port Thruster</label>
				<health>120</health>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>5</radius>
						<damageDef>Flame</damageDef>
					</li>
				</reactors>
				
				<hitbox>
					<side>Body</side>
				</hitbox>
				
				<categories>
					<li>FlightSpeed</li>
				</categories>
			</li>
			<li>
				<key>SecondThruster</key>
				<label>Starboard Thruster</label>
				<health>120</health>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>5</radius>
						<damageDef>Flame</damageDef>
					</li>
				</reactors>
				
				<hitbox>
					<side>Body</side>
				</hitbox>
				
				<categories>
					<li>FlightSpeed</li>
					<li>FlightControl</li>
				</categories>
			</li>
			<li>
				<key>Reactor</key>
				<label>Reactor</label>
				<health>200</health>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>18</radius>
						<damageDef>Bomb</damageDef>
					</li>
				</reactors>
			</li>
			<li>
				<key>Cockpit</key>
				<label>Cockpit</label>
				<health>160</health>
				<depth>Internal</depth>
				
				<categories>
					<li>FlightControl</li>
				</categories>
			</li>
		</components>
		
		<soundSustainersOnEvent>
			<li>
				<start>IgnitionOn</start>
				<stop>IgnitionOff</stop>
				<value>kotorsound_enginehum_TIEBomber</value>
			</li>
		</soundSustainersOnEvent>
		
		<soundOneShotsOnEvent>
		</soundOneShotsOnEvent>
		
	</Vehicles.VehicleDef>
	
	
	
	
	
	
	
	
	
	
	
	
