		<apparelMoney>1500~5500</apparelMoney>
		<apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
		<apparelTags>
			<li>KotOREquipment_basic</li>
		</apparelTags>
		<apparelRequired>
			<li>guy762_TIEpilotHelmet_PA</li>
			<li>guy762_TIEpilotArmor</li>
			<li>guy762_Bodysuit_TIEpilot</li>
