<?xml version="1.0" encoding="utf-8" ?>

<Defs>	

	<Vehicles.PatternDef>
		<defName>guy762_SWVehiclePattern_T2BTank</defName>
		<label>T2-B Repulsor Tank (stock)</label>
		<path>LandVehicles/T2B/T2B_Pattern</path>
	</Vehicles.PatternDef>
	
	
	<Vehicles.VehicleDef Name="guy762_SWVehicle_T2BTank" ParentName="guy762_GroundVehiclePawn_base">
		<defName>guy762_SWVehicle_T2BTank</defName>
		<label>T2-B Repulsor Tank</label>
		<description>. \n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Driver x1</description>
		
		<combatPower>450</combatPower>
		<npcProperties>
			<raidParams>SWCP_VehicleRaidParams_EdgeWalkInsOnly</raidParams>
			<targetAcquireRadius>250</targetAcquireRadius>
			<targetKeepRadius>30</targetKeepRadius>
			<runDownTargets>false</runDownTargets>
			<stopToShoot>true</stopToShoot>
		</npcProperties>
		
		<graphicData>
			<texPath>LandVehicles/T2B/T2B</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
			<drawSize>(8,8)</drawSize>
			<shaderType>CutoutComplexPattern</shaderType>
			<pattern>guy762_SWVehiclePattern_T2BTank</pattern>
			<color>(140,60,60)</color> <!-- alliance red -->
			<colorTwo>(140,60,60)</colorTwo> <!-- alliance red -->
			<colorThree>(185,180,175)</colorThree> <!-- warm grey -->
		</graphicData>
		
		<fillPercent>1</fillPercent>
		
		<nameable>true</nameable>
		<buildDef>guy762_SWVehicleBP_T2BTank</buildDef>
		
		<size>(5,8)</size>
		<uiIconScale>1</uiIconScale>
		
		
		<vehicleCategory>Combat</vehicleCategory>
		<techLevel>Spacer</techLevel>
		<vehicleType>Land</vehicleType>
				
		<statBases> <!-- blanket applies to all parts without specified armor ratings -->
			<ArmorRating_Sharp>0.35</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.2</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
			<ArmorRating_Heat>0.45</ArmorRating_Heat>
			<MaxHitPoints>300</MaxHitPoints> <!-- # of estimated XWMG hull points * 100 -->
			
			<Flammability>0.5</Flammability>
			<MarketValue>8200</MarketValue>
		</statBases>
		
		<soundSustainersOnEvent>
			<li>
				<start>IgnitionOn</start>
				<stop>MoveStart</stop>
				<value>kotorsound_AAT_idle</value>
			</li>
			<li>
				<start>MoveStart</start>
				<stop>MoveStop</stop>
				<value>kotorsound_AAT_moving</value>
			</li>
			<li>
				<start>MoveStop</start>
				<stop>MoveStart</stop>
				<value>kotorsound_AAT_idle</value>
			</li>
			<li>
				<start>MoveStop</start>
				<stop>IgnitionOff</stop>
				<value>kotorsound_AAT_idle</value>
			</li>
		</soundSustainersOnEvent>
		
		<soundOneShotsOnEvent>
			<li>
				<key>IgnitionOn</key>
				<value>kotorsound_speederbike_activate</value>
			</li>
			<li>
				<key>IgnitionOff</key>
				<value>kotorsound_speederbike_deactivate</value>
			</li>
		</soundOneShotsOnEvent>
		
		<race>
			<baseBodySize>1</baseBodySize>
		</race>
		
		<vehicleStats>
			<Mass>1000</Mass>
			<MoveSpeed>20</MoveSpeed>
			<CargoCapacity>200</CargoCapacity>
			<RepairRate>1</RepairRate>
			<!--AccelerationRate>0.08</AccelerationRate-->
		</vehicleStats>
		
		<properties>
			<diagonalRotation>false</diagonalRotation>
			<manhunterTargetsVehicle>false</manhunterTargetsVehicle>
			
			<worldSpeedMultiplier>0.5</worldSpeedMultiplier> <!-- higher number = faster travel -->
			<winterSpeedMultiplier>1</winterSpeedMultiplier> <!-- lower number = faster winter travel -->
			<offRoadMultiplier>1</offRoadMultiplier> <!-- lower number = faster travel -->
			
			<customRoadCosts AssignDefaults = "0.5" /> <!-- vanilla default is 0.5, lower number = faster -->
			<!-- <customTerrainCosts AllowTerrainWithTag="Water" PathCost="1"/> -->
			<track Class = "Vehicles.VehicleTrack_Wake">
				<speed>1</speed>
			</track>
			
			<riverCost>3</riverCost> <!-- higher = slower, <1 = very fast on world map -->
			
			<!-- <offRoadMultiplier>1.5</offRoadMultiplier> 1 for walkers and speeder bikes, 1.5 for light vehicles, 2 for heavy vehicles -->
			
			<!-- <customHillinessCosts> -->
				<!-- <SmallHills>0.25</SmallHills> -->
				<!-- <LargeHills>0.75</LargeHills> -->
				<!-- <Mountainous>1.5</Mountainous> -->
			<!-- </customHillinessCosts> -->
			
			<vehicleJobLimitations>
				<li>(RepairVehicle, 4)</li> <!-- how many pawns can repair this vehicle at a time -->
			</vehicleJobLimitations> <!-- guy762 RULES: repair job count should be twice the amount of pawns to fully operate the vehicle -->
			
			<!--customWeatherCosts>
				<Dusting>4</Dusting>
				<Thin>8</Thin>
				<Medium>16</Medium>
				<Thick>24</Thick>
			</customWeatherCosts-->
			
			<roles>
				<li>
					<key>driver</key>
					<label>Driver</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<handlingTypes>
						<li>Movement</li>
					</handlingTypes>
				</li>
				<li>
					<key>gunner</key>
					<label>Gunner</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					
					<handlingTypes>Turret</handlingTypes>
					
					<turretIds>
						<li>T2BKey_gun_1</li>
					</turretIds>
				</li>
				<li>
					<key>navigator</key>
					<label>Navigator</label>
					<slots>1</slots>
				</li>
			</roles>
		</properties>
		
		<components>
			<li>
				<key>T2BKey_hull</key>
				<label>Hull</label>
				<depth>External</depth>
				
				<armor> <!-- EaWX health/50 = hull points, round up -->
					<ArmorRating_Sharp>1.35</ArmorRating_Sharp>
					<ArmorRating_Blunt>1.2</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
					<ArmorRating_Heat>1.45</ArmorRating_Heat>
					<IncomingDamageFactor>-0.15</IncomingDamageFactor> <!-- unarmored: 0.05 | light vehicles: 0.15 | medium vehicles: 0.25 | heavy vehicles: 0.35 -->
				</armor>
				<health>300</health> <!-- # of estimated XWMG hull points * 100 -->
				
				<hitbox>
					<side>Body</side>
				</hitbox>
			</li>
			
			
			<!-- <li> -->
				<!-- <key>AA5TruckKey_cabin</key> -->
				<!-- <label>Cabin</label> -->
				<!-- <health>100</health> -->
				<!-- <depth>Internal</depth> -->
			<!-- </li> -->
			<li>
				<key>T2BKey_engine</key>
				<label>Engine</label>
				<health>5</health>
				<priorityStatEfficiency>true</priorityStatEfficiency>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>3</radius>
						<damageDef>guy762_ExplosiveDamage_energy</damageDef>
					</li>
				</reactors>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>T2BKey_repulsor</key>
				<label>Repulsorlift Generator</label>
				<health>5</health>
				<depth>Internal</depth>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>T2BKey_thrust</key>
				<label>Thrust Repulsor</label>
				<health>5</health>
				<depth>Internal</depth>
				
				<tags>
					<li>Wheel</li>
				</tags>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
		</components>

		<!--modExtensions>
			<li Class="VanillaVehiclesExpanded.StatExtension">
				<statToAdd>
					<li>VVE_VehicleTier</li>
				</statToAdd>
				<statValues>
					<li>VVE_Tier1</li>
				</statValues>
				<statDescriptions>
					<li>VVE_Tier1Desc</li>
				</statDescriptions>
			</li>
		</modExtensions-->
		
		<comps>
			<li Class="Vehicles.CompProperties_FueledTravel">
				<fuelType>KOTOR_Rhydonium</fuelType>
				<leakDef>Filth_Fuel</leakDef>
				<fuelConsumptionRate>12.5</fuelConsumptionRate>
				<fuelCapacity>125</fuelCapacity>
				<fuelConsumptionWorldMultiplier>10</fuelConsumptionWorldMultiplier>
				
				<targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
				<ambientHeat>1.0</ambientHeat>
			</li>
			
			<li Class="CompProperties_ProjectileInterceptor">
				<radius>4</radius>
				<color>(0.4, 0.4, 0.4)</color>
				
				<interceptGroundProjectiles>true</interceptGroundProjectiles>
				<interceptAirProjectiles>true</interceptAirProjectiles>
				<interceptNonHostileProjectiles>true</interceptNonHostileProjectiles>
				
				<reactivateEffect>BulletShieldGenerator_Reactivate</reactivateEffect>
				<activeSound>BulletShield_Ambience</activeSound>
				<hitPointsRestoreInstantlyAfterCharge>true</hitPointsRestoreInstantlyAfterCharge>
				
				<hitPoints>200</hitPoints> <!-- XWMG shield value * 100 -->
				
				<chargeDurationTicks>1800</chargeDurationTicks><!-- 30s -->
				<rechargeHitPointsIntervalTicks>120</rechargeHitPointsIntervalTicks>
				<minIdleAlpha>0.2</minIdleAlpha>
				<drawWithNoSelection>True</drawWithNoSelection>
				<disarmedByEmpForTicks>1500</disarmedByEmpForTicks>
				
				<gizmoTipKey>ProjectileInterceptorTip</gizmoTipKey>
			</li>
			
			<li Class="Vehicles.CompProperties_VehicleTurrets">
				<turrets>
					<li>
						<turretDef>guy762_VehicleTurret_T2B_AIquad</turretDef>
						
						<renderProperties>
							<north>(0, 0.325)</north>
							<south>(0, 1.2)</south>
							<east>(-0.55, 0.45)</east>
							<west>(0.55, 0.45)</west>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<!-- <angleRestricted>(315,45)</angleRestricted> -->
						<gizmoLabel>dorsal AI cannon</gizmoLabel>
						
						<drawLayer>15</drawLayer>
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<key>T2BKey_gun_1</key>
					</li>
				</turrets>
			</li>
		</comps>
	</Vehicles.VehicleDef>
	
	
	
	
	
	
	
	
	
	
	<Vehicles.VehicleTurretDef ParentName="guy762_VehicleTurretBASE">
		<defName>guy762_VehicleTurret_T2B_AIquad</defName>
		<label>T2-B quad AI cannon</label>
		<description>The rotating dorsal turret of a T2-B Repulsor Tank.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_T2BGun</shotSound>
		
		<projectile>SWVehicleBullet_AIdoublered_2xSize</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>1</warmUpTimer> <!-- all dorsal turrets = 1 minimum -->
		
		<magazineCapacity>999</magazineCapacity>
		
		
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<!-- <projectileOffset>2.1</projectileOffset> -->
		
		<minRange>5</minRange>
		<maxRange>30</maxRange> <!-- ~30 for infantry, 60 for ground vehicles, 90 for starfighters -->

		<fireModes>
			<li>
				<shotsPerBurst>2</shotsPerBurst>
				<ticksBetweenShots>9</ticksBetweenShots>
				<ticksBetweenBursts>200</ticksBetweenBursts>
				<label>Burst</label>
				<texPath>UI/Rapid_Shot</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>LandVehicles/T2B/T2B_gun</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(4,4)</drawSize>
			<color>(140,60,60)</color> <!-- alliance red -->
			<colorTwo>(140,60,60)</colorTwo>
			<colorThree>(185,180,175)</colorThree> <!-- warm grey -->
		</graphicData>
		
		<gizmoIconTexPath>LandVehicles/T2B/T2B_gun</gizmoIconTexPath>
		
	</Vehicles.VehicleTurretDef>
	
	
	
	
	
	
	
	
	
	
	
</Defs>