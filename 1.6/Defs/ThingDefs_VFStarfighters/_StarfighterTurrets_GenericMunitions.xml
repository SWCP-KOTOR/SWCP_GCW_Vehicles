<Defs>	

		<!-- used by: B-Wing, Kimogila, Scurrg, Skipray, StarViper, X-Wing, YT-2400 -->
	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>guy762_VehicleTurret_ProTorp</defName>
		<label>proton torpedo launcher</label>
		<description>A proton torpedo launcher.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_protorp2</shotSound>
		<reloadSound>kotorsound_reloadlauncher</reloadSound>
		
		<projectile>SWVehicleBullet_SFprotorp</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0.4</warmUpTimer>
		
		<!-- <reloadTimerMultiplierPerCrewCount> USE FOR HUGE TRANSPORT WEAPONS -->
            <!-- <points> -->
                <!-- <li>(1, 1)</li> -->
                <!-- <li>(2, 0.75)</li> -->
            <!-- </points> -->
        <!-- </reloadTimerMultiplierPerCrewCount> -->
		
		<magazineCapacity>1</magazineCapacity>
		<genericAmmo>true</genericAmmo>
		
		<empDisables>true</empDisables>
		
		<autoSnapTargeting>false</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<projectileOffset>2.1</projectileOffset>
		
		<minRange>30</minRange>
		<maxRange>120</maxRange>

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>20</ticksBetweenShots>
				<ticksBetweenBursts>100</ticksBetweenBursts>
				<label>Single</label>
				<texPath>Items/Rockets/rocket_buster/rocket_buster_a</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>NullTex</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
		</graphicData>
		
		<gizmoIconTexPath>Items/bigcannon_blank</gizmoIconTexPath>
		
		<ammunition>
			<thingDefs>
				<li>guy762_RocketItem_buster</li>
			</thingDefs>
		</ammunition>
	</Vehicles.VehicleTurretDef>
	
	
