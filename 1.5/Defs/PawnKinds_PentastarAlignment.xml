		<label>TIE pilot</label>
		<combatPower>65</combatPower>
		<minGenerationAge>18</minGenerationAge>
		<maxGenerationAge>40</maxGenerationAge>
		<itemQuality>Good</itemQuality>
		
		<!-- <xenotypeSet Inherit="False"> -->
