						<drawOffsetSouth>(0,0,0.9)</drawOffsetSouth>
						<drawOffsetEast>(-0.45,0,0.325)</drawOffsetEast>
					</pawnRenderer>
				</li>
			</roles>
		</properties>
		
		<components>
			<li>
				<key>FlareSKey_hull</key>
				<label>Hull</label>
				<depth>External</depth>
				
				<armor> <!-- all speeder bikes should use this same stat block -->
					<ArmorRating_Sharp>0.55</ArmorRating_Sharp>
					<ArmorRating_Blunt>0.4</ArmorRating_Blunt>
					<ArmorRating_Heat>0.65</ArmorRating_Heat>
					<IncomingDamageFactor>-0.05</IncomingDamageFactor>
				</armor>
				<health>100</health>
				
				<hitbox>
					<side>Body</side>
				</hitbox>
			</li>
			<li>
				<key>FlareSKey_engine</key>
				<label>Engine</label>
				<health>25</health>
				<priorityStatEfficiency>true</priorityStatEfficiency>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>3</radius>
						<damageDef>Flame</damageDef>
					</li>
				</reactors>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>FlareSKey_repulsor</key>
				<label>Repulsorlift Generator</label>
				<health>75</health>
				<depth>Internal</depth>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>FlareSKey_thrust</key>
				<label>Thrust Repulsor</label>
				<health>50</health>
				<depth>Internal</depth>
				
				<tags>
					<li>Wheel</li>
				</tags>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
		</components>

