<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	
	
	
	
	<ThingDef ParentName="KotORArmorModdable_hard">
		<defName>guy762_RebelHelmet</defName>
		<label>combat helmet</label>
		<techLevel>Spacer</techLevel>
		<description>.</description>
		<graphicData>
			<texPath>Apparel/Rebel/helmet</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<thingCategories>
		  <li>ArmorHeadgear</li>
		</thingCategories>
		<statBases>
			<Mass>2.5</Mass>
			<MarketValue>100</MarketValue>
			<MaxHitPoints>115</MaxHitPoints>
      		<ArmorRating_Sharp>0.35</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.2</ArmorRating_Blunt>
			<ArmorRating_Heat>0.45</ArmorRating_Heat>
			<EquipDelay>4</EquipDelay>
		</statBases>
		
		<apparel Inherit="False">
			<tags>
				<li>NewRepublic_alderaanguard</li>
			</tags>
			<wornGraphicPath>Apparel/Rebel/helmet</wornGraphicPath>
			<useWornGraphicMask>true</useWornGraphicMask>
			<layers>
				<li>Overhead</li>
			</layers>
			<bodyPartGroups>
				<li>UpperHead</li>
			</bodyPartGroups>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
		</apparel>
		<tradeTags>
			<li>guy762TT_ORArmor</li>
		</tradeTags>
		<colorGenerator Class="ColorGenerator_Options" Inherit="False">
			<options>
				<li>
					<weight>10</weight>
					<only>(250,250,250)</only>  <!-- white -->
				</li>
			</options>
		</colorGenerator>
	</ThingDef>
	
	<ThingDef ParentName="guy762_clothingbase">
		<defName>guy762_Clothing_rebel</defName>
		<label>clothing, plain</label>
		<description>These are simple garments that protect little more than the modesty of the wearer.</description>
		<graphicData>
		  <texPath>Apparel/Undersuits/rebel/Apparel</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		  <shaderType>CutoutComplex</shaderType>
		  <colorTwo>(175,175,175)</colorTwo>
		</graphicData>
		<statBases>
			<Mass>3</Mass>
			<MarketValue>10</MarketValue>
			<MaxHitPoints>100</MaxHitPoints>
			<ArmorRating_Sharp>0.01</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.01</ArmorRating_Blunt>
			<ArmorRating_Heat>0.01</ArmorRating_Heat>
			<Insulation_Cold>5</Insulation_Cold>
			<Insulation_Heat>10</Insulation_Heat>
			<EquipDelay>3</EquipDelay>
			
			<WorkToMake>1000</WorkToMake>
		</statBases>
		
		<costList>
		  <Cloth>75</Cloth>
		</costList>
		
		<apparel>
		  <tags Inherit="False">
			<li>NewRepublic_alderaanguard</li>
		  </tags>
		  <wornGraphicPath>Apparel/Undersuits/rebel/Apparel</wornGraphicPath>
		  <useWornGraphicMask>true</useWornGraphicMask>
		  <defaultOutfitTags Inherit="False">
			<li>Worker</li>
		  </defaultOutfitTags>
		</apparel>
		<tradeTags>
			<li>guy762TT_KotORClothes</li>
		</tradeTags>
		<colorGenerator Class="ColorGenerator_Options" Inherit="False">
			<options>
				<li>
					<weight>50</weight>
					<only>(145,195,230)</only> <!-- blue -->
				</li>
				<li>
					<weight>1</weight>
					<only>(140,50,35)</only> <!-- rebel friend red -->
				</li>
			</options>
		</colorGenerator>
	  </ThingDef>
	  
	  
	  
	  
	  
	  
	  
	  
	  
	  
	  
	  
