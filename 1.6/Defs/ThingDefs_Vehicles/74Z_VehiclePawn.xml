<?xml version="1.0" encoding="utf-8" ?>

<Defs>	

	
	<Vehicles.VehicleDef Name="guy762_SWVehicle_74ZSpeeder" ParentName="guy762_SpeederBikeOrUnarmoredVehicle_base">
		<defName>guy762_SWVehicle_74ZSpeeder</defName>
		<label>Aratech 74-Z Speeder Bike</label>
		<description>. \n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Driver x1</description>
		
		<graphicData>
			<texPath>LandVehicles/74Z/74Z_L1</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
			<shaderType>CutoutComplexPattern</shaderType>
			<drawSize>(3,3)</drawSize>
			<color>(190,135,110)</color>
		</graphicData>
		
		<fillPercent>0.4</fillPercent>
		
		<nameable>false</nameable>
		<buildDef>guy762_SWVehicleBP_74ZSpeeder</buildDef>
		
		<size>(2,2)</size>
		<uiIconScale>1</uiIconScale>
		
		
		<vehicleCategory>Transport</vehicleCategory>
		<techLevel>Spacer</techLevel>
		<vehicleType>Land</vehicleType>
				
		<statBases>
			<ArmorRating_Sharp>0.55</ArmorRating_Sharp> <!-- all speeder bikes should use this same stat block -->
			<ArmorRating_Blunt>0.4</ArmorRating_Blunt>
			<ArmorRating_Heat>0.65</ArmorRating_Heat>
			<MaxHitPoints>500</MaxHitPoints>
			
			<Flammability>0.5</Flammability>
			<MarketValue>5800</MarketValue>
		</statBases>
		
		<soundSustainersOnEvent>
			<!--li>
				<start>MoveStop</start>
				<stop>MoveStart</stop>
				<value>kotorsound_speederbike_idle</value>
			</li-->
			<li>
				<start>MoveStart</start>
				<stop>MoveStop</stop>
				<value>kotorsound_speederbike_moving</value>
			</li>
		</soundSustainersOnEvent>
		
		<soundOneShotsOnEvent>
			<li>
				<key>IgnitionOn</key>
				<value>kotorsound_speederbike_activate</value>
			</li>
			<li>
				<key>IgnitionOff</key>
				<value>kotorsound_speederbike_deactivate</value>
			</li>
			<!-- <li> -->
				<!-- <key>DamageTaken</key> -->
				<!-- <value>kotorsound_speederbike_damaged</value> -->
			<!-- </li> -->
			<!-- <li> -->
				<!-- <key>CargoAdded</key> -->
				<!-- <value>kotorsound_bag_open</value> -->
			<!-- </li> -->
			<!-- <li> -->
				<!-- <key>CargoRemoved</key> -->
				<!-- <value>kotorsound_bag_close</value> -->
			<!-- </li> -->
		</soundOneShotsOnEvent>
		
		<race>
			<baseBodySize>1</baseBodySize>
		</race>
		
		<drawProperties>
			<graphicOverlays>
				<li>
					<graphicData>
						<texPath>LandVehicles/74Z/74Z_L2</texPath>
						<graphicClass>Vehicles.Graphic_Vehicle</graphicClass> <!-- Graphic_RGB if not using the pattern system -->
						<shaderType>CutoutComplexPattern</shaderType>
						<drawSize>(3,3)</drawSize>
						<color>(190,135,110)</color>
						<layer>5</layer>
					</graphicData>
				</li>
			</graphicOverlays>
		</drawProperties>
		
		<vehicleStats>
			<Mass>100</Mass>
			<MoveSpeed>40</MoveSpeed>
			<CargoCapacity>25</CargoCapacity>
			<RepairRate>1</RepairRate>
			<!--AccelerationRate>0.08</AccelerationRate-->
		</vehicleStats>
		
		<properties>
			<diagonalRotation>false</diagonalRotation>
			<manhunterTargetsVehicle>true</manhunterTargetsVehicle>
			
			<worldSpeedMultiplier>0.5</worldSpeedMultiplier> <!-- higher number = faster travel -->
			<winterSpeedMultiplier>1</winterSpeedMultiplier> <!-- lower number = faster winter travel -->
			<offRoadMultiplier>1</offRoadMultiplier> <!-- lower number = faster travel -->
			
			<customRoadCosts AssignDefaults = "0.5" /> <!-- vanilla default is 0.5, lower number = faster -->
			<!-- <customTerrainCosts AllowTerrainWithTag="Water" PathCost="1"/> -->
			<track Class = "Vehicles.VehicleTrack_Wake">
				<speed>2</speed>
			</track>
			
			<riverCost>1</riverCost> <!-- higher = slower, <1 = very fast on world map -->
			
			<!-- <customHillinessCosts> -->
				<!-- <SmallHills>0.25</SmallHills> -->
				<!-- <LargeHills>0.75</LargeHills> -->
				<!-- <Mountainous>1.5</Mountainous> -->
			<!-- </customHillinessCosts> -->
			
			<!--customWeatherCosts>
				<Dusting>4</Dusting>
				<Thin>8</Thin>
				<Medium>16</Medium>
				<Thick>24</Thick>
			</customWeatherCosts-->
			
			<roles>
				<li>
					<key>rider</key>
					<label>Rider</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<exposed>true</exposed>
					
					<hitbox>
						<side>Body</side>
					</hitbox>
					
					<comfort>-0.25</comfort>
					
					<handlingTypes>
						<li>Movement</li>
						<li>Turret</li>
					</handlingTypes>
					<turretIds>
						<li>74ZSpeederKey_gun_1</li>
					</turretIds>
				
					<pawnRenderer>
						<layer>0</layer>
						<layerNorth>0</layerNorth>
						<layerSouth>0</layerSouth>
						<angleNorth>0</angleNorth>
						<angleEast>0</angleEast>
						<angleNorthEast>0</angleNorthEast>
						<angleSouthEast>0</angleSouthEast>
						<drawOffsetNorth>(0,0,0.42)</drawOffsetNorth>
						<drawOffsetSouth>(0,0,0.265)</drawOffsetSouth>
						<drawOffsetEast>(-0.45,0,0.325)</drawOffsetEast>
					</pawnRenderer>
				</li>
			</roles>
		</properties>
		
		<components>
			<li>
				<key>74ZSpeederKey_hull</key>
				<label>Hull</label>
				<depth>External</depth>
				
				<armor> <!-- all speeder bikes should use this same stat block -->
					<ArmorRating_Sharp>0.55</ArmorRating_Sharp>
					<ArmorRating_Blunt>0.4</ArmorRating_Blunt>
					<ArmorRating_Heat>0.65</ArmorRating_Heat>
					<IncomingDamageFactor>-0.05</IncomingDamageFactor>
				</armor>
				<health>100</health>
				
				<hitbox>
					<side>Body</side>
				</hitbox>
			</li>
			<li>
				<key>74ZSpeederKey_engine</key>
				<label>Engine</label>
				<health>1</health>
				<priorityStatEfficiency>true</priorityStatEfficiency>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>3</radius>
						<damageDef>guy762_ExplosiveDamage_energy</damageDef>
					</li>
				</reactors>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>74ZSpeederKey_repulsor</key>
				<label>Repulsorlift Generator</label>
				<health>1</health>
				<depth>Internal</depth>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>74ZSpeederKey_thrust</key>
				<label>Thrust Repulsor</label>
				<health>1</health>
				<depth>Internal</depth>
				
				<tags>
					<li>Wheel</li>
				</tags>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
		</components>

		<!--modExtensions>
			<li Class="VanillaVehiclesExpanded.StatExtension">
				<statToAdd>
					<li>VVE_VehicleTier</li>
				</statToAdd>
				<statValues>
					<li>VVE_Tier1</li>
				</statValues>
				<statDescriptions>
					<li>VVE_Tier1Desc</li>
				</statDescriptions>
			</li>
		</modExtensions-->
		
		<comps>
			<li Class="Vehicles.CompProperties_FueledTravel">
				<electricPowered>true</electricPowered>
				<fuelConsumptionRate>10</fuelConsumptionRate>
				<fuelCapacity>50</fuelCapacity>
				<fuelConsumptionWorldMultiplier>10</fuelConsumptionWorldMultiplier>
				
				<targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
				<ambientHeat>1.0</ambientHeat>
			</li>
			<li Class="Vehicles.CompProperties_VehicleTurrets">
				<turrets>
					<li>
						<turretDef>guy762_VehicleTurret_74ZSpeeder_main</turretDef>
						
						<renderProperties>
							<north>(0, 0.6)</north>
							<south>(0, -0.6)</south>
							<east>(0.5, -0.4)</east>
							<west>(-0.5, -0.4)</west>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>light AI blaster</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<key>74ZSpeederKey_gun_1</key>
					</li>
				</turrets>
			</li>
		</comps>
	</Vehicles.VehicleDef>
	
	
	<Vehicles.VehicleTurretDef ParentName="guy762_VehicleTurretBASE">
		<defName>guy762_VehicleTurret_74ZSpeeder_main</defName>
		<label>74-Z light anti-infantry gun</label>
		<description>The main gun of a 74-Z speeder bike.</description>
		
		<turretType>Rotatable</turretType>
		<!-- <shotSound>kotorsound_ATPTgun</shotSound> -->
		<shotSound>kotorsound_speedergun</shotSound>
		
		<projectile>SWVehicleBullet_AIred_light</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0.2</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		
		
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<!-- <projectileOffset>2.1</projectileOffset> -->
		
		<!-- <minRange>5</minRange> no min for close range guns -->
		<maxRange>30</maxRange> <!-- ~30 for infantry, 60 for ground vehicles, 90 for starfighters -->

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>15</ticksBetweenShots>
				<ticksBetweenBursts>60</ticksBetweenBursts>
				<label>Burst</label>
				<texPath>UI/Rapid_Shot</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>NullTex</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
		</graphicData>
		
		<gizmoIconTexPath>Items/cannon_blank</gizmoIconTexPath>
		
	</Vehicles.VehicleTurretDef>
	
	
	
	
</Defs>