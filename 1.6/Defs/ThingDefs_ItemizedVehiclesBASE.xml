	=	LATE TECH

	
	=	NON-TECH REWARD SHIPS: 10
	
	-->
	
	<ThingDef Name="SWCP_ItemizedGroundVehicleBASE" ParentName="SWCP_ItemizedVehicleBASE" Abstract="True">
		<description>An itemized starfighter. Use it to construct the corresponding starfighter.</description>
		
		<tradeTags>
			<li>SWCPTT_ItemizedGroundVehicles_any</li>
		</tradeTags>
