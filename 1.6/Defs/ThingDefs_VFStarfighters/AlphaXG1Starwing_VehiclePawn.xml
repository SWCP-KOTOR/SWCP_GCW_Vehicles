	<Vehicles.VehicleDef Name="guy762_SWVehicle_AlphaXG1Starwing" ParentName="MM-VF-Vehicle_Pawn">
		<defName>guy762_SWVehicle_AlphaXG1Starwing</defName>
		<label>Alpha-class Xg-1 Starwing</label>
		<description>. \n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Pilot x1</description>
		<graphicData>
			<texPath>Starfighters/AlphaXG1/AlphaXG1</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
			<drawRotated>true</drawRotated>
			<drawSize>(16,16)</drawSize>
			<shaderType>CutoutComplexPattern</shaderType>
			<pattern>guy762_SWVehiclePattern_AlphaXG1StarwingA</pattern>
			<color>(110,120,130)</color> <!-- sand blue -->
			<colorTwo>(0,0,0)</colorTwo>
			<colorThree>(185,185,185)</colorThree> <!-- lighter grey -->
		</graphicData>
		<uiIconScale>1</uiIconScale>
		<seeThroughFog>true</seeThroughFog>
		<drawOffscreen>true</drawOffscreen>
		<rotatable>True</rotatable>
		
		<fillPercent>1</fillPercent>
		<nameable>true</nameable>
		<buildDef>guy762_SWVehicleBP_AlphaXG1Starwing</buildDef>
		<size>(7,9)</size>
		
		
		<canCaravan>false</canCaravan>
		<vehicleCategory>Combat</vehicleCategory>
		<techLevel>Spacer</techLevel>
		<vehicleType>Air</vehicleType>
		
		<statBases>
			<!--ArmorRating_Sharp>+0.05</ArmorRating_Sharp>
			<ArmorRating_Blunt>-0.1</ArmorRating_Blunt>        BASE CURVE FOR HARD ARMOR
			<ArmorRating_Heat>+0.15</ArmorRating_Heat-->
			<!--B--><ArmorRating_Sharp>0.045</ArmorRating_Sharp>
			<!--B--><ArmorRating_Blunt>0.03</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
			<!--B--><ArmorRating_Heat>0.055</ArmorRating_Heat>
			<MaxHitPoints>400</MaxHitPoints> <!-- # of estimated XWMG hull points * 100 -->
			
			<MarketValue>125000</MarketValue>
			<Flammability>0</Flammability>
			
			<EnergyShieldRechargeRate>0.5</EnergyShieldRechargeRate>
			<EnergyShieldEnergyMax>3</EnergyShieldEnergyMax> <!-- XWMG shield value -->
		</statBases>
		<vehicleStats>
			<Mass>75000</Mass>
			
			<FlightSpeed>12</FlightSpeed> <!-- this is for world map flight, NOT in-tile flight-->
			<CargoCapacity>100</CargoCapacity>
			<SoS2CombatDodgeChance MayRequire="kentington.saveourship2">27.5</SoS2CombatDodgeChance> <!-- 3/8 chance to dodge on XWMG green dice = 0.375 | 0.375*10 + 10 = 13.75 | 13.75 * X = SoS2DC | X = estimated # of XWMG green dice -->
		</vehicleStats>
		
		<race>
			<baseBodySize>1.5</baseBodySize>
		</race>
		
		<drawProperties>
			<displayRotation>North</displayRotation>
		</drawProperties>
		
		<properties>
			<diagonalRotation>false</diagonalRotation><empStuns>true</empStuns>
			<worldSpeedMultiplier>0.01</worldSpeedMultiplier>
			<manhunterTargetsVehicle>false</manhunterTargetsVehicle>
			
			<vehicleJobLimitations>
				<li>(RepairVehicle, 2)</li> <!-- how many pawns can repair this vehicle at a time -->
			</vehicleJobLimitations> <!-- guy762 RULES: repair job count should be twice the amount of pawns to fully operate the vehicle -->
			
			<roles>
				<li>
					<key>pilot</key>
					<label>Pilot</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<handlingTypes>
						<li>Movement</li>
						<li>Turret</li>
					</handlingTypes>
					
					<turretIds>
						<li>AlphaXG1StarwingKey_gun_1</li>
						<li>AlphaXG1StarwingKey_gun_2</li>
						
						<li>AlphaXG1StarwingKey_gun_3</li>
						
						<li>AlphaXG1StarwingKey_gun_4</li>
						<li>AlphaXG1StarwingKey_gun_5</li>
						
						<li>AlphaXG1StarwingKey_gun_6</li>
						<li>AlphaXG1StarwingKey_gun_7</li>
					</turretIds>
				</li>
			</roles>
		</properties>
		
		<comps>
			<li Class="Vehicles.CompProperties_FueledTravel">
				<electricPowered>true</electricPowered>
				<fuelConsumptionRate>2</fuelConsumptionRate>
				<fuelCapacity>325</fuelCapacity>
				<fuelConsumptionWorldMultiplier>10</fuelConsumptionWorldMultiplier>
			</li>
			
			<li Class="CompProperties_ProjectileInterceptor">
				<radius>9</radius>
				<color>(0.4, 0.4, 0.4)</color>
				
				<interceptGroundProjectiles>true</interceptGroundProjectiles>
				<interceptAirProjectiles>true</interceptAirProjectiles>
				<interceptNonHostileProjectiles>true</interceptNonHostileProjectiles>
				
				<reactivateEffect>BulletShieldGenerator_Reactivate</reactivateEffect>
				<activeSound>BulletShield_Ambience</activeSound>
				<hitPointsRestoreInstantlyAfterCharge>true</hitPointsRestoreInstantlyAfterCharge>
				
				<hitPoints>300</hitPoints> <!-- XWMG shield value * 100 -->
				
				<chargeDurationTicks>1800</chargeDurationTicks><!-- 30s -->
				<rechargeHitPointsIntervalTicks>120</rechargeHitPointsIntervalTicks>
				<minIdleAlpha>0.2</minIdleAlpha>
				<drawWithNoSelection>True</drawWithNoSelection>
				<disarmedByEmpForTicks>1500</disarmedByEmpForTicks>
				
				<gizmoTipKey>ProjectileInterceptorTip</gizmoTipKey>
			</li>
			
			<li Class="taranchuk_flightcombat.CompProperties_FlightMode">
				<flightCommands>
					<flightMode>
						<label>Flight mode</label>
						<description>Toggle flight mode.</description>
						<texPath>Gizmo/TakeOff_Icon</texPath>
					</flightMode>
					<!-- <hoverMode> -->
						<!-- <label>Hover mode</label> -->
						<!-- <description>Toggle hover mode.</description> -->
						<!-- <texPath>Gizmo/Liftoff_Icon</texPath> -->
					<!-- </hoverMode> -->
					<!-- <faceTarget> -->
						<!-- <label>Face target (hover)</label> -->
						<!-- <description>Face target while hovering.</description> -->
						<!-- <texPath>Gizmo/FaceTarget_Icon</texPath> -->
					<!-- </faceTarget> -->
					<!-- <cancelFaceTarget> -->
						<!-- <label>Cancel face target</label> -->
						<!-- <description>Cancel face target.</description> -->
						<!-- <texPath>Gizmo/FaceTargetStop_Icon</texPath> -->
					<!-- </cancelFaceTarget> -->
					<chaseTarget>
						<label>Chase target (flight)</label>
						<description>Chase target while flying.</description>
						<texPath>Gizmo/ChaseTarger_Icon</texPath>
					</chaseTarget>
				</flightCommands>
				
				<fuelConsumptionPerTick>0.001</fuelConsumptionPerTick><canFlyInSpace>true</canFlyInSpace>
				
				<flightSpeedPerTick>0.7</flightSpeedPerTick> <!-- MAXIMUM XWMG speed: speed5 = 1, speed1 = 0.2 | + 0.1 for blue 5, -0.1 for red highest -->
				<flightSpeedTurningPerTick>0.6</flightSpeedTurningPerTick> <!-- highest speed in which all 5 standard maneuvers are available | +0.1 for a full row of blues, -0.1 for any red turns -->
				<turnAnglePerTick>2</turnAnglePerTick> <!-- USE SLOWEST POSSIBLE TURN: speed1 turn = 4, speed2 turn = 2, speed3 turn = 1 | banks = 0.75, 0.5, 0.25 | -1 for red slowest -->
				<turnAngleCirclingPerTick>1.5</turnAngleCirclingPerTick> <!-- use slowest turn +1 for each special turning maneuver: speed1 turn = 2, speed2 turn = 1.5, speed3 turn = 1 | +0.5 for any blue turns, -0.5 for any red turns -->
				
				<flightSpeedCirclingPerTick>0.6</flightSpeedCirclingPerTick>
				<ellipseMajorAxis>120</ellipseMajorAxis>
				<ellipseMinorAxis>60</ellipseMinorAxis>
				
				<maxDistanceFromTargetElliptical>50</maxDistanceFromTargetElliptical>
				<maxDistanceFromTargetCircle>10</maxDistanceFromTargetCircle>
				
				<takeoffTicks>120</takeoffTicks>
				<landingTicks>120</landingTicks>
				<moveWhileTakingOff>false</moveWhileTakingOff><moveWhileLanding>false</moveWhileLanding>
				
				
				
				<runwayTerrainRequirements>
					<li>Light</li>
					<li>Medium</li>
					<li>Heavy</li>
				</runwayTerrainRequirements>
				<flightGraphicData>
					<texPath>Starfighters/AlphaXG1/AlphaXG1</texPath>
					<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
					<drawRotated>true</drawRotated>
					<drawSize>(16,16)</drawSize>
					<shaderType>CutoutComplexPattern</shaderType>
					<pattern>guy762_SWVehiclePattern_AlphaXG1StarwingA</pattern>
					<color>(110,120,130)</color> <!-- sand blue -->
					<colorTwo>(0,0,0)</colorTwo>
					<colorThree>(185,185,185)</colorThree> <!-- lighter grey -->
				</flightGraphicData>
				
				<AISettings>
					<gunshipSettings>
						<!-- strafing run settings: Elliptical/Over -->
						<chaseMode>Elliptical</chaseMode><flightPattern>Over</flightPattern>
						<distanceFromTarget>30</distanceFromTarget>
					</gunshipSettings>
				</AISettings>
				
				<flightFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</flightFlecks>
				<hoverFlecks>
					<!-- can be filled with the same data as the flight flecks if necessary -->
				</hoverFlecks>
				<takeoffFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<solidTimeScaleByTakeoffInverse>true</solidTimeScaleByTakeoffInverse>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</takeoffFlecks>
				<landingFlecks>
					<li>
						<fleck>CVN_RocketExhaust</fleck>
						<solidTime>0.20</solidTime>
						<solidTimeScaleByTakeoff>true</solidTimeScaleByTakeoff>
						<velocitySpeed>0</velocitySpeed>
						<position>(-3, 0, 0)</position>
						<angleOffset>0</angleOffset>
						<spawnTickRate>1</spawnTickRate>
						<scale>2</scale>
					</li>
				</landingFlecks>
				<waypointFleck>guy762_SWStarfighter_waypoint</waypointFleck>
			</li>
			
			
			<li Class="Vehicles.CompProperties_VehicleTurrets">
				<turrets>
					<li>
						<turretDef>guy762_VehicleTurret_AlphaXG1Starwing_main</turretDef>
						
						<renderProperties>
							<north>(-2.513, 2.35)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>medium AV/AA gun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<autoTargetingActive>True</autoTargetingActive>
						
						<key>AlphaXG1StarwingKey_gun_1</key>
					</li>
					<li>
						<turretDef>guy762_VehicleTurret_AlphaXG1Starwing_main</turretDef>
						
						<renderProperties>
							<north>(2.513, 2.35)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>medium AV/AA gun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<autoTargetingActive>True</autoTargetingActive>
						
						<key>AlphaXG1StarwingKey_gun_2</key>
					</li>

					
					<!--/////////////////////////-->
					
					<li>
						<turretDef>guy762_VehicleTurret_AlphaXG1Starwing_ion</turretDef>
						
						<renderProperties>
							<north>(0, 0.35)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>ion AV/AA gun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<autoTargetingActive>True</autoTargetingActive>
						
						<key>AlphaXG1StarwingKey_gun_3</key>
					</li>
					
					<!--/////////////////////////-->
					
					<li>
						<turretDef>guy762_VehicleTurret_ProTorp</turretDef>
						
						<renderProperties>
							<north>(-0.8, 4.125)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>proton torpedo launcher</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<key>AlphaXG1StarwingKey_gun_4</key>
					</li>
					<li>
						<turretDef>guy762_VehicleTurret_ProTorp</turretDef>
						
						<renderProperties>
							<north>(0.8, 4.125)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>proton torpedo launcher</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<key>AlphaXG1StarwingKey_gun_5</key>
					</li>
					
					<!--/////////////////////////-->
					
					<li>
						<turretDef>guy762_VehicleTurret_ConcMissile</turretDef>
						
						<renderProperties>
							<north>(-1.71, 1.75)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>concussion missile launcher</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<key>AlphaXG1StarwingKey_gun_6</key>
					</li>
					<li>
						<turretDef>guy762_VehicleTurret_ConcMissile</turretDef>
						
						<renderProperties>
							<north>(1.71, 1.75)</north>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>concussion missile launcher</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<key>AlphaXG1StarwingKey_gun_7</key>
					</li>
				</turrets>
			</li>
		</comps>
		<components>
			<li>
				<key>Hull</key>
				<label>Hull</label>
				<depth>External</depth>
				
				<armor>
					<!--H--><ArmorRating_Sharp>0.45</ArmorRating_Sharp>
					<!--H--><ArmorRating_Blunt>0.3</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
					<!--H--><ArmorRating_Heat>0.55</ArmorRating_Heat>
					<IncomingDamageFactor>-0.25</IncomingDamageFactor> <!-- Interceptors: 0.05 | StrikeFighters: 0.15 | AssaultFighters: 0.25 | Transports: 0.35 -->
				</armor>
				<health>1000</health> <!-- XWMG hull * 250 -->
				
				<hitbox>
					<side>Body</side>
				</hitbox>
			</li>
			<li>
				<key>Internals</key>
				<label>Internals</label>
				<health>400</health> <!-- XWMG hull * 100 -->
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.75</chance>
						<maxHealth>0.1</maxHealth>
						<radius>5</radius>
						<damageDef>guy762_ExplosiveDamage_energy</damageDef>
					</li>
				</reactors>
				<categories>
					<li>FlightSpeed</li>
					<li>FlightControl</li>
				</categories>
			</li>
		</components>
		
		<soundSustainersOnEvent>
			<li>
				<start>IgnitionOn</start>
				<stop>IgnitionOff</stop>
				<value>kotorsound_enginehum_lancet</value>
			</li>
		</soundSustainersOnEvent>
		
		<soundOneShotsOnEvent>
		</soundOneShotsOnEvent>
		
	</Vehicles.VehicleDef>
	
	
	
	
	
	
	
	
	
	<Vehicles.VehicleTurretDef ParentName="guy762_StarfighterTurretBASE">
		<defName>guy762_VehicleTurret_AlphaXG1Starwing_main</defName>
		<label>Xg-1 Starwing main gun</label>
		<description>The main gun of an Xg-1 Starwing assault gunboat.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_ywinggun</shotSound>
		
		<projectile>SWCPStarfighterBullet_AssaultAVAAmedium_green</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		
		<empDisables>true</empDisables>
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<projectileOffset>2.1</projectileOffset> <!-- keep this on starfighters-->
		
		<minRange>5</minRange>
		<maxRange>90</maxRange>

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>10</ticksBetweenShots>
				<ticksBetweenBursts>50</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Sniper_Shot</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>NullTex</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
		</graphicData>
		
		<gizmoIconTexPath>Items/cannon_blank</gizmoIconTexPath>
		
	</Vehicles.VehicleTurretDef>
	
	
	
	<Vehicles.VehicleTurretDef ParentName="guy762_StarfighterTurretBASE">
		<defName>guy762_VehicleTurret_AlphaXG1Starwing_ion</defName>
		<label>Xg-1 Starwing ion turret</label>
		<description>The ion turret of an Xg-1 Starwing assault gunboat.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_VehicleIonCannonMix</shotSound>
		
		<projectile>SWCPStarfighterBullet_AssaultAVAA_dualion</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0.5</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		
		<empDisables>true</empDisables>
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<projectileOffset>2.1</projectileOffset> <!-- keep this on starfighters-->
		
		<minRange>5</minRange>
		<maxRange>90</maxRange> <!-- ~30 for infantry, 60 for ground vehicles, 90 for starfighters -->

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>10</ticksBetweenShots>
				<ticksBetweenBursts>150</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Ion_Power_Blast</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>NullTex</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
		</graphicData>
		
		<gizmoIconTexPath>Items/cannon_blank</gizmoIconTexPath>
		
	</Vehicles.VehicleTurretDef>
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
