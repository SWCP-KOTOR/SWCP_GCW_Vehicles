		<label>pit droid</label>
		<nameMaker>SWCP_DroidNamer_DUMpitdroid</nameMaker>
		
		<race>SWCP_BnSDroidRace_PitDroid</race>
		<useFactionXenotypes>false</useFactionXenotypes>
