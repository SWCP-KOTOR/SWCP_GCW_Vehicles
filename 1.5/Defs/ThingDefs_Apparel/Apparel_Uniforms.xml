		<statBases>
			<Mass>3</Mass>
			<MarketValue>100</MarketValue>
			<MaxHitPoints>100</MaxHitPoints>
			<ArmorRating_Sharp>0.01</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.01</ArmorRating_Blunt>
			<ArmorRating_Heat>0.01</ArmorRating_Heat>
			<Insulation_Cold>15</Insulation_Cold>
			<Insulation_Heat>5</Insulation_Heat>
			<EquipDelay>3</EquipDelay>
			
			<WorkToMake>4000</WorkToMake>
		</statBases>
		
		<recipeMaker>
			<researchPrerequisite>guy762_ResearchKotOR_sith</researchPrerequisite>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
		  <Cloth>75</Cloth>
		</costList>
		
		<apparel>
		  <tags Inherit="False">
			<li>RemnantEmpire_armytrooper</li>
		  </tags>
		  <wornGraphicPath>Apparel/GenericMilitaryFatigues/Apparel</wornGraphicPath>
