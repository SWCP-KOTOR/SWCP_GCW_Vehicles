<?xml version="1.0" encoding="utf-8" ?>

<Defs>	

	<Vehicles.PatternDef>
		<defName>guy762_SWVehiclePattern_AA5Truck</defName>
		<label>A-A5 Speeder Truck (stock)</label>
		<path>LandVehicles/AA5/AA5_pattern</path>
	</Vehicles.PatternDef>
	
	
	<Vehicles.VehicleDef Name="guy762_SWVehicle_AA5Truck" ParentName="guy762_GroundVehiclePawn_base">
		<defName>guy762_SWVehicle_AA5Truck</defName>
		<label>A-A5 Speeder Truck</label>
		<description>. \n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Driver x1</description>
		
		<combatPower>250</combatPower>
		<npcProperties>
			<raidParams>SWCP_VehicleRaidParams_EdgeWalkInsOnly</raidParams>
			<targetAcquireRadius>250</targetAcquireRadius>
			<targetKeepRadius>30</targetKeepRadius>
			<runDownTargets>false</runDownTargets>
			<stopToShoot>true</stopToShoot>
		</npcProperties>
		
		<graphicData>
			<texPath>LandVehicles/AA5/AA5</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
			<drawSize>(11,11)</drawSize>
			<shaderType>CutoutComplexPattern</shaderType>
			<pattern>guy762_SWVehiclePattern_AA5Truck</pattern>
			<color>(170,160,135)</color> <!-- stanky beige -->
			<colorTwo>(140,60,60)</colorTwo>
		</graphicData>
		
		<fillPercent>1</fillPercent>
		
		<nameable>true</nameable>
		<buildDef>guy762_SWVehicleBP_AA5Truck</buildDef>
		
		<size>(5,9)</size>
		<uiIconScale>1</uiIconScale>
		
		
		<vehicleCategory>Transport</vehicleCategory>
		<techLevel>Spacer</techLevel>
		<vehicleType>Land</vehicleType>
		<navigationCategory>Automatic</navigationCategory>
				
		<statBases>
			<ArmorRating_Sharp>0.65</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.5</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
			<ArmorRating_Heat>0.75</ArmorRating_Heat>
			<MaxHitPoints>600</MaxHitPoints> <!-- # of estimated XWMG hull points * 100 -->
			
			<Flammability>0.5</Flammability>
			<MarketValue>5800</MarketValue>
		</statBases>
		
		<soundSustainersOnEvent>
			<li>
				<start>IgnitionOn</start>
				<stop>MoveStart</stop>
				<value>kotorsound_hovertankheavy_idle</value>
			</li>
			<li>
				<start>MoveStart</start>
				<stop>MoveStop</stop>
				<value>kotorsound_hovertankheavy_moving</value>
			</li>
			<li>
				<start>MoveStop</start>
				<stop>MoveStart</stop>
				<value>kotorsound_hovertankheavy_idle</value>
			</li>
			<li>
				<start>MoveStop</start>
				<stop>IgnitionOff</stop>
				<value>kotorsound_hovertankheavy_idle</value>
			</li>
		</soundSustainersOnEvent>
		
		<soundOneShotsOnEvent>
			<li>
				<key>IgnitionOn</key>
				<value>kotorsound_speederbike_activate</value>
			</li>
			<li>
				<key>IgnitionOff</key>
				<value>kotorsound_speederbike_deactivate</value>
			</li>
		</soundOneShotsOnEvent>
		
		<race>
			<baseBodySize>1</baseBodySize>
		</race>
		
		<vehicleStats>
			<Mass>1200</Mass>
			<MoveSpeed>20</MoveSpeed>
			<CargoCapacity>300</CargoCapacity>
			<RepairRate>1</RepairRate>
			<!--AccelerationRate>0.08</AccelerationRate-->
		</vehicleStats>
		
		<properties>
			<diagonalRotation>false</diagonalRotation>
			<manhunterTargetsVehicle>false</manhunterTargetsVehicle>
			
			<worldSpeedMultiplier>0.7</worldSpeedMultiplier> <!-- higher number = faster travel -->
			<winterSpeedMultiplier>1.25</winterSpeedMultiplier> <!-- lower number = faster winter travel -->
			<offRoadMultiplier>1</offRoadMultiplier> <!-- lower number = faster travel -->
			
			<customRoadCosts AssignDefaults = "0.5" /> <!-- vanilla default is 0.5, lower number = faster -->
			<!-- <customTerrainCosts AllowTerrainWithTag="Water" PathCost="1"/> -->
			<track Class = "Vehicles.VehicleTrack_Wake">
				<speed>1</speed>
			</track>
			
			<riverCost>3</riverCost> <!-- higher = slower, <1 = very fast on world map -->
			
			<vehicleJobLimitations>
				<li>(RepairVehicle, 4)</li> <!-- how many pawns can repair this vehicle at a time -->
			</vehicleJobLimitations> <!-- guy762 RULES: repair job count should be twice the amount of pawns to fully operate the vehicle -->
			
			<!-- <customHillinessCosts> -->
				<!-- <SmallHills>0.25</SmallHills> -->
				<!-- <LargeHills>0.75</LargeHills> -->
				<!-- <Mountainous>1.5</Mountainous> -->
			<!-- </customHillinessCosts> -->
			
			<!--customWeatherCosts>
				<Dusting>4</Dusting>
				<Thin>8</Thin>
				<Medium>16</Medium>
				<Thick>24</Thick>
			</customWeatherCosts-->
			
			<roles>
				<li>
					<key>driver</key>
					<label>Driver</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<handlingTypes>
						<li>Movement</li>
					</handlingTypes>
				</li>
				<li>
					<key>gunner</key>
					<label>Gunner</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					
					<handlingTypes>Turret</handlingTypes>
					
					<turretIds>
						<li>AA5TruckKey_gun_1</li>
					</turretIds>
				</li>
				<li>
					<key>navigator</key>
					<label>Navigator</label>
					<slots>1</slots>
				</li>
				<li>
					<key>passenger</key>
					<label>Passenger</label>
					<slots>12</slots>
					<comfort>-0.25</comfort>
				</li>
			</roles>
		</properties>
		
		<components>
			<li>
				<key>AA5TruckKey_hull</key>
				<label>Hull</label>
				<depth>External</depth>
				
				<armor> <!-- breaking usual rules to put these guys at 6 hull -->
					<ArmorRating_Sharp>1.65</ArmorRating_Sharp>
					<ArmorRating_Blunt>1.5</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
					<ArmorRating_Heat>1.75</ArmorRating_Heat>
					<IncomingDamageFactor>-0.15</IncomingDamageFactor> <!-- unarmored: 0.05 | light vehicles: 0.15 | medium vehicles: 0.25 | heavy vehicles: 0.35 -->
				</armor>
				<health>600</health> <!-- # of estimated XWMG hull points * 100 -->
				
				<hitbox>
					<side>Body</side>
				</hitbox>
			</li>
			
			
			<!-- <li> -->
				<!-- <key>AA5TruckKey_cabin</key> -->
				<!-- <label>Cabin</label> -->
				<!-- <health>100</health> -->
				<!-- <depth>Internal</depth> -->
			<!-- </li> -->
			<li>
				<key>AA5TruckKey_engine</key>
				<label>Engine</label>
				<health>5</health>
				<priorityStatEfficiency>true</priorityStatEfficiency>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>3</radius>
						<damageDef>guy762_ExplosiveDamage_energy</damageDef>
					</li>
				</reactors>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>AA5TruckKey_repulsor</key>
				<label>Repulsorlift Generator</label>
				<health>5</health>
				<depth>Internal</depth>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>AA5TruckKey_thrust</key>
				<label>Thrust Repulsor</label>
				<health>5</health>
				<depth>Internal</depth>
				
				<tags>
					<li>Wheel</li>
				</tags>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
		</components>

		<!--modExtensions>
			<li Class="VanillaVehiclesExpanded.StatExtension">
				<statToAdd>
					<li>VVE_VehicleTier</li>
				</statToAdd>
				<statValues>
					<li>VVE_Tier1</li>
				</statValues>
				<statDescriptions>
					<li>VVE_Tier1Desc</li>
				</statDescriptions>
			</li>
		</modExtensions-->
		
		<comps>
			<li Class="Vehicles.CompProperties_FueledTravel">
				<fuelType>KOTOR_Rhydonium</fuelType>
				<leakDef>Filth_Fuel</leakDef>
				<fuelConsumptionRate>12.5</fuelConsumptionRate>
				<fuelCapacity>175</fuelCapacity>
				<fuelConsumptionWorldMultiplier>10</fuelConsumptionWorldMultiplier>
				
				<targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
				<ambientHeat>1.0</ambientHeat>
			</li>
			<li Class="Vehicles.CompProperties_VehicleTurrets">
				<turrets>
					<li>
						<turretDef>guy762_VehicleTurret_AA5Truck_dorsal</turretDef>
						
						<renderProperties>
							<north>(-0.7, 2)</north>
							<south>(-0.7, -0.4)</south>
							<east>(1.315, 1.825)</east>
							<west>(-1.315, 1.825)</west>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<!-- <angleRestricted>(315,45)</angleRestricted> -->
						<gizmoLabel>dorsal AI turret</gizmoLabel>
						
						<drawLayer>15</drawLayer>
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<key>AA5TruckKey_gun_1</key>
					</li>
				</turrets>
			</li>
		</comps>
	</Vehicles.VehicleDef>
	
	
	
	<Vehicles.VehicleTurretDef ParentName="guy762_VehicleTurretBASE">
		<defName>guy762_VehicleTurret_AA5Truck_dorsal</defName>
		<label>A-A5 anti-infantry dorsal turret</label>
		<description>The rotating dorsal turret of an A-A5 Speeder Truck.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_speedergun</shotSound>
		
		<projectile>SWVehicleBullet_AIdoublered</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>1</warmUpTimer> <!-- all dorsal turrets = 1 minimum -->
		
		<magazineCapacity>999</magazineCapacity>
		
		
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<!-- <projectileOffset>2.1</projectileOffset> -->
		
		<minRange>5</minRange>
		<maxRange>30</maxRange> <!-- ~30 for infantry, 60 for ground vehicles, 90 for starfighters -->

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>10</ticksBetweenShots>
				<ticksBetweenBursts>80</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Sniper_Shot</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>Starfighters/YT2400/YT2400_gun</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<drawSize>(5,5)</drawSize>
		</graphicData>
		
		<gizmoIconTexPath>Starfighters/YT2400/YT2400_gun</gizmoIconTexPath>
		
	</Vehicles.VehicleTurretDef>
	
	
	
	
	<Vehicles.VehicleDef Name="guy762_SWVehicle_AA5Truck_bot" ParentName="guy762_SWVehicle_AA5Truck">
		<defName>guy762_SWVehicle_AA5Truck_bot</defName>

		<buildDef Inherit="False" />
		
		<!-- <vehicleMovementPermissions>NoDriverNeeded</vehicleMovementPermissions> -->
		
		<properties>
			<roles Inherit="False">
				<li>
					<key>pilot</key>
					<label>Bot Pilot</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<!-- <handlingTypes> -->
						<!-- <li>Movement</li> -->
						<!-- <li>Turret</li> -->
					<!-- </handlingTypes> -->
					
					<turretIds>
						<li>AA5TruckKey_gun_1</li>
					</turretIds>
				</li>
			</roles>
		</properties>

	</Vehicles.VehicleDef>
	
	
</Defs>