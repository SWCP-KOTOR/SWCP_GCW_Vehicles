<?xml version="1.0" encoding="utf-8" ?>

<Defs>	

	<Vehicles.PatternDef>
		<defName>guy762_SWVehiclePattern_SoroSuubV25A</defName>
		<label>SoroSuub V-25 Combat Speeder (stock)</label>
		<path>LandVehicles/SoroSuubV25/SoroSuubV25_pattern</path>
	</Vehicles.PatternDef>
	
	
	
	
	
	
	
	
	
	
	<Vehicles.VehicleDef Name="guy762_SWVehicle_SoroSuubV25CombatSpeeder" ParentName="guy762_GroundVehiclePawn_base">
		<defName>guy762_SWVehicle_SoroSuubV25CombatSpeeder</defName>
		<label>SoroSuub V-25 Combat Speeder</label>
		<description>. \n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Driver x1</description>
		
		<combatPower>250</combatPower>
		<npcProperties>
			<raidParams>SWCP_VehicleRaidParams_EdgeWalkInsOnly</raidParams>
			<targetAcquireRadius>250</targetAcquireRadius>
			<targetKeepRadius>30</targetKeepRadius>
			<runDownTargets>false</runDownTargets>
			<stopToShoot>true</stopToShoot>
		</npcProperties>
		
		<graphicData>
			<texPath>LandVehicles/SoroSuubV25/SoroSuubV25</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
			<drawSize>(7,7)</drawSize>
			<shaderType>CutoutComplexPattern</shaderType>
			
			<pattern>guy762_SWVehiclePattern_SoroSuubV25A</pattern>
			<color>(170,160,135)</color> <!-- stanky beige -->
			<colorTwo>(140,60,60)</colorTwo>
			
			<!-- <color>(60,75,105)</color> imperial reserve blue -->
		</graphicData>
		
		<fillPercent>1</fillPercent>
		
		<nameable>true</nameable>
		<buildDef>guy762_SWVehicleBP_SoroSuubV25CombatSpeeder</buildDef>
		
		<size>(3,7)</size>
		<uiIconScale>1</uiIconScale>
		
		
		<vehicleCategory>Combat</vehicleCategory>
		<techLevel>Spacer</techLevel>
		<vehicleType>Land</vehicleType>
		<navigationCategory>Automatic</navigationCategory>
				
		<statBases>
			<!--ArmorRating_Sharp>+0.05</ArmorRating_Sharp>
			<ArmorRating_Blunt>-0.1</ArmorRating_Blunt>        BASE CURVE FOR HARD ARMOR
			<ArmorRating_Heat>+0.15</ArmorRating_Heat-->
			<ArmorRating_Sharp>0.25</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.1</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
			<ArmorRating_Heat>0.35</ArmorRating_Heat>
			<MaxHitPoints>200</MaxHitPoints> <!-- # of estimated XWMG hull points * 100 -->
			
			<Flammability>0.5</Flammability>
			<MarketValue>19000</MarketValue>
		</statBases>
		
		<soundSustainersOnEvent>
			<li>
				<start>IgnitionOn</start>
				<stop>MoveStart</stop>
				<value>kotorsound_hovercar_idle</value>
			</li>
			<li>
				<start>MoveStart</start>
				<stop>MoveStop</stop>
				<value>kotorsound_hovercar_moving</value>
			</li>
			<li>
				<start>MoveStop</start>
				<stop>MoveStart</stop>
				<value>kotorsound_hovercar_idle</value>
			</li>
			<li>
				<start>MoveStop</start>
				<stop>IgnitionOff</stop>
				<value>kotorsound_hovercar_idle</value>
			</li>
		</soundSustainersOnEvent>
		
		<soundOneShotsOnEvent>
			<li>
				<key>IgnitionOn</key>
				<value>kotorsound_speederbike_activate</value>
			</li>
			<li>
				<key>IgnitionOff</key>
				<value>kotorsound_speederbike_deactivate</value>
			</li>
		</soundOneShotsOnEvent>
		
		<race>
			<baseBodySize>1</baseBodySize>
		</race>
		
		<drawProperties>
			<graphicOverlays>
				<li>
					<graphicData>
						<texPath>LandVehicles/SoroSuubV25/SoroSuubV25</texPath>
						<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
						<drawSize>(7,7)</drawSize>
						<shaderType>CutoutComplexPattern</shaderType>
						<pattern>guy762_SWVehiclePattern_SoroSuubV25A</pattern>
						<color>(170,160,135)</color> <!-- stanky beige -->
						<colorTwo>(140,60,60)</colorTwo>
					</graphicData>
				</li>
			</graphicOverlays>
		</drawProperties>
		
		<vehicleStats>
			<Mass>1500</Mass>
			<MoveSpeed>25</MoveSpeed>
			<CargoCapacity>150</CargoCapacity>
			<RepairRate>0.75</RepairRate>
			<!--AccelerationRate>0.08</AccelerationRate-->
		</vehicleStats>
		
		<properties>
			<diagonalRotation>false</diagonalRotation>
			<manhunterTargetsVehicle>true</manhunterTargetsVehicle>
			
			<worldSpeedMultiplier>1</worldSpeedMultiplier> <!-- higher number = faster travel -->
			<winterSpeedMultiplier>1</winterSpeedMultiplier> <!-- lower number = faster winter travel -->
			<offRoadMultiplier>1</offRoadMultiplier> <!-- lower number = faster travel -->
			
			<customRoadCosts AssignDefaults = "0.5" /> <!-- vanilla default is 0.5, lower number = faster -->
			<!-- <customTerrainCosts AllowTerrainWithTag="Water" PathCost="1"/> -->
			<track Class = "Vehicles.VehicleTrack_Wake">
				<speed>1</speed>
			</track>
			
			<riverCost>2</riverCost> <!-- higher = slower, <1 = very fast on world map -->
			
			<vehicleJobLimitations>
				<li>(RepairVehicle, 4)</li> <!-- how many pawns can repair this vehicle at a time -->
			</vehicleJobLimitations> <!-- guy762 RULES: repair job count should be twice the amount of pawns to fully operate the vehicle -->
			
			<!-- <customHillinessCosts> -->
				<!-- <SmallHills>0.25</SmallHills> -->
				<!-- <LargeHills>0.75</LargeHills> -->
				<!-- <Mountainous>1.5</Mountainous> -->
			<!-- </customHillinessCosts> -->
			
			<!--customWeatherCosts>
				<Dusting>4</Dusting>
				<Thin>8</Thin>
				<Medium>16</Medium>
				<Thick>24</Thick>
			</customWeatherCosts-->
			
			<roles>
				<li>
					<key>driver</key>
					<label>Driver</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<handlingTypes>
						<li>Movement</li>
						<li>Turret</li>
					</handlingTypes>
					
					<comfort>-0.125</comfort>
					
					<turretIds>
						<li>SoroSuubV25Key_gun_1</li>
						<li>SoroSuubV25Key_gun_2</li>
					</turretIds>
				</li>
				<li>
					<key>gunner</key>
					<label>Gunner</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					
					<handlingTypes>Turret</handlingTypes>
					
					<turretIds>
						<li>SoroSuubV25Key_gun_3</li>
					</turretIds>
				</li>
			</roles>
		</properties>
		
		<components>
			<li>
				<key>SoroSuubV25Key_hull</key>
				<label>Hull</label>
				<depth>External</depth>
				
				<armor> <!-- EaWX health/50 = hull points, round up -->
					<ArmorRating_Sharp>1.25</ArmorRating_Sharp>
					<ArmorRating_Blunt>1.1</ArmorRating_Blunt> <!-- # of estimated XWMG hull points * 0.1, apply to hard armor curve -->
					<ArmorRating_Heat>1.35</ArmorRating_Heat>
					<IncomingDamageFactor>-0.15</IncomingDamageFactor> <!-- unarmored: 0.05 | light vehicles: 0.15 | medium vehicles: 0.25 | heavy vehicles: 0.35 | superheavies: 0.45-->
				</armor>
				<health>200</health> <!-- # of estimated XWMG hull points * 100 -->
				
				<hitbox>
					<side>Body</side>
				</hitbox>
			</li>
			
			
			<!-- <li> -->
				<!-- <key>ImpTroopTransportKey_cabin</key> -->
				<!-- <label>Cabin</label> -->
				<!-- <health>100</health> -->
				<!-- <depth>Internal</depth> -->
			<!-- </li> -->
			<li>
				<key>SoroSuubV25Key_engine</key>
				<label>Engine</label>
				<health>5</health>
				<priorityStatEfficiency>true</priorityStatEfficiency>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>3</radius>
						<damageDef>guy762_ExplosiveDamage_energy</damageDef>
					</li>
				</reactors>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>SoroSuubV25Key_repulsor</key>
				<label>Repulsorlift Generator</label>
				<health>5</health>
				<depth>Internal</depth>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>SoroSuubV25Key_thrust</key>
				<label>Thrust Repulsor</label>
				<health>5</health>
				<depth>Internal</depth>
				
				<tags>
					<li>Wheel</li>
				</tags>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
		</components>
		
		<comps>
			<li Class="Vehicles.CompProperties_FueledTravel">
				<electricPowered>true</electricPowered>
				<fuelConsumptionRate>15</fuelConsumptionRate>
				<fuelCapacity>100</fuelCapacity>
				<fuelConsumptionWorldMultiplier>25</fuelConsumptionWorldMultiplier>
				
				<targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
				<ambientHeat>1.0</ambientHeat>
			</li>
			<li Class="Vehicles.CompProperties_VehicleTurrets">
				<turrets>
					<li>
						<turretDef>guy762_VehicleTurret_SoroSuubV25_main</turretDef>
						
						<renderProperties>
							<north>(-1.55, 2.3)</north>
							<south>(1.55, -1.75)</south>
							<east>(2.55, 1.125)</east>
							<west>(-2.55, -1)</west>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>light AV gun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<!-- <autoTargetingActive>True</autoTargetingActive> -->
						
						<key>SoroSuubV25Key_gun_1</key>
					</li>
					<li>
						<turretDef>guy762_VehicleTurret_SoroSuubV25_main</turretDef>
						
						<renderProperties>
							<north>(1.55, 2.3)</north>
							<south>(-1.55, -1.75)</south>
							<east>(2.55, -1)</east>
							<west>(-2.55, 1.125)</west>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(315,45)</angleRestricted>
						<gizmoLabel>light AV gun</gizmoLabel>
						
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<!-- <autoTargetingActive>True</autoTargetingActive> -->
						
						<key>SoroSuubV25Key_gun_2</key>
					</li>
					<li>
						<turretDef>guy762_VehicleTurret_SoroSuubV25_beam</turretDef>
						
						<renderProperties>
							<north>(0, 2.35)</north>
							<south>(0, -1.75)</south>
							<east>(2.25,0.35)</east>
							<west>(-2.25,0.35)</west>
						</renderProperties>
						<defaultAngleRotated>0</defaultAngleRotated>
						<angleRestricted>(270,90)</angleRestricted>
						<gizmoLabel>dorsal AI beam</gizmoLabel>
						
						<drawLayer>8</drawLayer>
						<aimPieOffset>(0, 2.55)</aimPieOffset>
						
						<key>SoroSuubV25Key_gun_3</key>
					</li>
				</turrets>
			</li>
		</comps>
		
		<modExtensions>
            <li Class="SWCP_GCW_Vehicles.VehicleTemperatureProtection">
                <protectFromHeat>true</protectFromHeat>
                <protectFromCold>true</protectFromCold>
            </li>
        </modExtensions>
	</Vehicles.VehicleDef>
	
	
	

	
	
	<Vehicles.VehicleTurretDef ParentName="guy762_VehicleTurretBASE">
		<defName>guy762_VehicleTurret_SoroSuubV25_main</defName>
		<label>SoroSuub V-25 light anti-vehicle gun</label>
		<description>The main gun of a SoroSuub V-25 Combat Speeder.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_TankAntiInfantryGun</shotSound>
		
		<projectile>SWVehicleBullet_AVred_light</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>0.4</warmUpTimer>
		
		<magazineCapacity>999</magazineCapacity>
		
		
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<!-- <projectileOffset>2.1</projectileOffset> -->
		
		<minRange>5</minRange>
		<maxRange>60</maxRange> <!-- ~30 for infantry, 60 for ground vehicles, 90 for starfighters -->

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>10</ticksBetweenShots>
				<ticksBetweenBursts>100</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Sniper_Shot</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>NullTex</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
		</graphicData>
		
		<gizmoIconTexPath>Items/bigcannon_blank</gizmoIconTexPath>
		
	</Vehicles.VehicleTurretDef>
	
	
	
	
	<Vehicles.VehicleTurretDef ParentName="guy762_VehicleTurretBASE">
		<defName>guy762_VehicleTurret_SoroSuubV25_beam</defName>
		<label>SoroSuub V-25 dorsal beam turret</label>
		<description>The rotating dorsal beam turret of a SoroSuub V-25 Combat Speeder.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>kotorsound_beamturret_fire</shotSound>
		
		<projectile>SWVehicleBullet_beam_AIred</projectile>
		<reloadTimer>3.5</reloadTimer>
		<warmUpTimer>1</warmUpTimer> <!-- all dorsal turrets = 1 minimum -->
		
		<magazineCapacity>999</magazineCapacity>
		
		
		
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>5</rotationSpeed>
		
		<!-- <projectileOffset>2.1</projectileOffset> -->
		
		<minRange>2</minRange>
		<maxRange>30</maxRange> <!-- ~30 for infantry, 60 for ground vehicles, 90 for starfighters -->

		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>10</ticksBetweenShots>
				<ticksBetweenBursts>400</ticksBetweenBursts>
				<label>Beam</label>
				<texPath>UI/Red_Beam</texPath>
				
				<forcedMissRadius>2</forcedMissRadius>
			</li>
		</fireModes>

		<graphicData>
			<texPath>LandVehicles/SoroSuubV25/SoroSuubV25_gun</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<!-- <shaderType>CutoutComplex</shaderType> -->
			<drawSize>(3.5,3.5)</drawSize>
		</graphicData>
		
		<gizmoIconTexPath>LandVehicles/SoroSuubV25/SoroSuubV25_gun</gizmoIconTexPath>
		
	</Vehicles.VehicleTurretDef>
	
	
	
	
	
	


	
	
</Defs>