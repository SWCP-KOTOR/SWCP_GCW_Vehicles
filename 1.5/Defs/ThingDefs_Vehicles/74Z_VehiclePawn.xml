<?xml version="1.0" encoding="utf-8" ?>

<Defs>	

	
	<Vehicles.VehicleDef ParentName="VehiclePawn_Mechanical">
		<defName>guy762_SWVehicle_74ZSpeeder</defName>
		<label>Aratech 74-Z Speeder Bike</label>
		<description>. \n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Driver x1</description>
		
		<graphicData>
			<texPath>LandVehicles/74Z/74Z_L1</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
			<shaderType>CutoutComplexPattern</shaderType>
			<drawSize>(3,3)</drawSize>
			<color>(190,135,110)</color>
		</graphicData>
		
		<fillPercent>0.4</fillPercent>
		
		<nameable>false</nameable>
		<buildDef>guy762_SWVehicleBP_74ZSpeeder</buildDef>
		
		<size>(2,2)</size>
		<uiIconScale>1</uiIconScale>
		
		<vehicleMovementPermissions>DriverNeeded</vehicleMovementPermissions>
		<vehicleCategory>Transport</vehicleCategory>
		<techLevel>Spacer</techLevel>
		<vehicleType>Land</vehicleType>
				
		<statBases>
			<ArmorRating_Sharp>0.3</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.2</ArmorRating_Blunt>
            <ArmorRating_Heat>0.4</ArmorRating_Heat>
			<Flammability>0.5</Flammability>
			<MarketValue>5800</MarketValue>
		</statBases>
		
		<vehicleStats>
			<Mass>100</Mass>
			<MoveSpeed>20</MoveSpeed>
			<CargoCapacity>10</CargoCapacity>
			<RepairRate>1</RepairRate>
			<!--AccelerationRate>0.08</AccelerationRate-->
		</vehicleStats>
		
		<soundSustainersOnEvent>
			<!--li>
				<start>MoveStop</start>
				<stop>MoveStart</stop>
				<value>kotorsound_speederbike_idle</value>
			</li-->
			<li>
				<start>MoveStart</start>
				<stop>MoveStop</stop>
				<value>kotorsound_speederbike_moving</value>
			</li>
		</soundSustainersOnEvent>
		
		<soundOneShotsOnEvent>
			<li>
				<key>IgnitionOn</key>
				<value>kotorsound_speederbike_activate</value>
			</li>
			<li>
				<key>IgnitionOff</key>
				<value>kotorsound_speederbike_deactivate</value>
			</li>
			<li>
				<key>DamageTaken</key>
				<value>kotorsound_speederbike_damaged</value>
			</li>
			<li>
				<key>CargoAdded</key>
				<value>kotorsound_bag_open</value>
			</li>
			<li>
				<key>CargoRemoved</key>
				<value>kotorsound_bag_close</value>
			</li>
		</soundOneShotsOnEvent>
		
		<race>
			<baseBodySize>1</baseBodySize>
		</race>
		
		<drawProperties>
			<graphicOverlays>
				<li>
					<graphicData>
						<texPath>LandVehicles/74Z/74Z_L2</texPath>
						<graphicClass>Vehicles.Graphic_Vehicle</graphicClass> <!-- Graphic_RGB if not using the pattern system -->
						<shaderType>CutoutComplexPattern</shaderType>
						<drawSize>(3,3)</drawSize>
						<color>(190,135,110)</color>
						<layer>2</layer>
					</graphicData>
				</li>
			</graphicOverlays>
		</drawProperties>
		
		<properties>
			<diagonalRotation>false</diagonalRotation>
			<worldSpeedMultiplier>1.2</worldSpeedMultiplier>
			<winterSpeedMultiplier>3.25</winterSpeedMultiplier>
			<manhunterTargetsVehicle>true</manhunterTargetsVehicle>
			<!--offRoadMultiplier>0.8</offRoadMultiplier-->
			
			<customHillinessCosts>
				<SmallHills>0.25</SmallHills>
				<LargeHills>0.75</LargeHills>
				<Mountainous>1.5</Mountainous>
			</customHillinessCosts>
			
			<!--customSnowCategoryTicks>
				<Dusting>4</Dusting>
				<Thin>8</Thin>
				<Medium>16</Medium>
				<Thick>24</Thick>
			</customSnowCategoryTicks-->
			
			<roles>
				<li>
					<key>rider</key>
					<label>Rider</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<exposed>true</exposed>
					
					<hitbox>
						<side>Body</side>
					</hitbox>
					
					<handlingTypes>
						<li>Movement</li>
					</handlingTypes>
				
					<pawnRenderer>
						<layer>0</layer>
						<layerNorth>0</layerNorth>
						<layerSouth>0</layerSouth>
						<angleNorth>0</angleNorth>
						<angleEast>0</angleEast>
						<angleNorthEast>0</angleNorthEast>
						<angleSouthEast>0</angleSouthEast>
