			<li Class="CompProperties_Styleable"></li>
		</comps>
		
		<apparel Inherit="False">
			<tags>
				<li>RemnantEmpire_armytrooper</li>
			</tags>
			<wornGraphicPath>Apparel/ImperialArmyTrooper/helmet</wornGraphicPath>
			<useWornGraphicMask>true</useWornGraphicMask>
			<layers>
				<li>Overhead</li>
				<li>EyeCover</li>
			</layers>
			<bodyPartGroups>
				<li>UpperHead</li>
			</bodyPartGroups>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
		</apparel>
		<tradeTags>
			<li>guy762TT_ORArmor</li>
		</tradeTags>
		<colorGenerator Class="ColorGenerator_Options" Inherit="False">
			<options>
				<li>
