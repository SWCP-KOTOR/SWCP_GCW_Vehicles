<Defs>	

	<Vehicles.PatternDef>
		<defName>guy762_SWVehiclePattern_UWingA</defName>
		<label>U-Wing (stock)</label>
		<path>Starfighters/UWing/UWing_Pattern_stock</path>
		<exclusiveFor><li>guy762_SWVehicle_UWing</li></exclusiveFor>
	</Vehicles.PatternDef>
	
	<Vehicles.PatternDef>
		<defName>guy762_SWVehiclePattern_UWingB</defName>
		<label>U-Wing (Blue Squadron)</label>
		<path>Starfighters/UWing/UWing_Pattern_BlueSquadron</path>
		<exclusiveFor><li>guy762_SWVehicle_UWing</li></exclusiveFor>
